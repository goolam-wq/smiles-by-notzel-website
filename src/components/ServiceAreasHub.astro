---
const chicago=['Chicago Heights','South Chicago Heights','Steger','Sauk Village','Lynwood','Glenwood','Ford Heights','Olympia Fields','Park Forest','Homewood','Flossmoor','Hazel Crest','Matteson','Crete','Country Club Hills','Richton Park'];
const mokena=['Mokena','Frankfort','New Lenox','Tinley Park','Orland Park','Homer Glen','Lockport','Manhattan','Frankfort Square','Orland Hills'];
const coverage=[
  ['Preventive & Diagnostic','9 services','Available','Available'],['Cosmetic Dentistry','7 services','Available','Available'],['Implants & Oral Surgery','8 services','Available','Available'],['Restorative & Reconstructive','7 services','Available','Available'],['Complete Health & Airway','4 services','Available','Available'],['Pediatric & Developmental','3 services','By appointment','By appointment'],['Emergency & Comfort','3 services','Same-day','Same-day'],['ReCODE & Cognitive Health','3 services','By appointment','By appointment'],['Periodontal Dentistry','2 services','Available','Available'],['Invisalign','1 service','Available','Available'],['Wellness','1 offering','Office / remote','Office / remote']
];
const {hideHero=false,hideCommunity=false,hideHandoff=false}=Astro.props;
---

{!hideHero && (
<section class="areas-hero" id="top" data-areas-hero>
  <div class="areas-hero__sticky">
    <div class="areas-hero__grid" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <header data-areas-title><p class="eyebrow">Chicago’s south suburbs · two studios</p><h1>Close to home.<br /><em>Connected by care.</em></h1></header>
    <article class="office-plane office-plane--chicago" data-area-plane="chicago"><img src="/images/generated/clinic-operatory-consistent.webp" alt="Chicago Heights dental office environment" /><div><span>01</span><h2>Chicago Heights</h2><p>500 Ashland Ave, Suite #2</p></div></article>
    <article class="office-plane office-plane--mokena" data-area-plane="mokena"><img src="/images/generated/dental-exam-candid.webp" alt="Mokena dental care environment" /><div><span>02</span><h2>Mokena</h2><p>19160 88th Avenue</p></div></article>
    <div class="areas-hero__route" aria-hidden="true"><i></i><span>26 communities</span></div>
    <a class="areas-hero__jump" href="#community-map">Follow the route ↓</a>
  </div>
</section>
)}

<section class="areas-intro" data-area-reveal>
  <div class="container-shell"><p class="eyebrow">One circle of care</p><h2>Two front doors.<br /><em>One coordinated experience.</em></h2><div><p>Choose the office that fits your day. The same complete-health philosophy, exact service map and connected team support both locations.</p><span>Chicago Heights ↔ Mokena</span></div></div>
</section>

{!hideCommunity && (
<section class="community-map" id="community-map" data-community-story>
  <div class="community-map__sticky">
    <header><p class="eyebrow">The communities between</p><h2>Your route to care.</h2></header>
    <div class="route-orbit" data-route-orbit aria-hidden="true"><div class="route-orbit__ring"></div><i class="route-node route-node--one"></i><i class="route-node route-node--two"></i></div>
    <div class="community-cloud community-cloud--chicago" data-community-cloud="chicago">{chicago.map((area,index)=><span style={`--i:${index}`}>{area}</span>)}</div>
    <div class="community-cloud community-cloud--mokena" data-community-cloud="mokena">{mokena.map((area,index)=><span style={`--i:${index}`}>{area}</span>)}</div>
    <div class="community-map__offices"><article><span>01</span><strong>Chicago Heights</strong><small>16 mapped communities</small></article><i></i><article><span>02</span><strong>Mokena</strong><small>10 mapped communities</small></article></div>
  </div>
</section>
)}

<section class="office-detail">
  <article id="chicago-heights" data-area-reveal><div class="office-detail__media"><img src="/images/generated/unique/areas-office-chicago.webp" alt="A patient arriving at the Chicago Heights reception desk" /></div><div class="office-detail__copy"><p class="eyebrow">01 · Chicago Heights</p><h2>Long hours.<br /><em>Local rhythm.</em></h2><p>Monday through Thursday care into the evening, plus Friday and Saturday availability.</p><address>500 Ashland Ave, Suite #2<br />Chicago Heights, IL 60411</address><a href="tel:+17087551333">(708) 755-1333 ↗</a><small>Mon–Thu 7:30 AM–7 PM · Fri 7:30 AM–12 PM · Sat 8 AM–12 PM</small></div></article>
  <article id="mokena" data-area-reveal><div class="office-detail__media"><img src="/images/generated/unique/areas-office-mokena.webp" alt="A patient speaking with the Mokena care team" /></div><div class="office-detail__copy"><p class="eyebrow">02 · Mokena</p><h2>Focused days.<br /><em>Unhurried care.</em></h2><p>Monday and Thursday appointments with alternating Saturday hours.</p><address>19160 88th Avenue<br />Mokena, IL 60448</address><a href="tel:+17084797733">(708) 479-7733 ↗</a><small>Mon 8 AM–7 PM · Thu 9:30 AM–6 PM · Every other Sat 8 AM–12 PM</small></div></article>
</section>

<section class="coverage-matrix" id="coverage">
  <div class="container-shell coverage-matrix__head"><p class="eyebrow">Service + location map</p><h2>The care travels.<br /><em>You choose the address.</em></h2><p>All 48 mapped offerings are supported through both offices. Advanced programs are scheduled by appointment where noted.</p></div>
  <div class="container-shell coverage-table" role="table" aria-label="Service availability by office">
    <div class="coverage-row coverage-row--head" role="row"><span>Category</span><span>Scope</span><span>Chicago Heights</span><span>Mokena</span></div>
    {coverage.map((row,index)=><div class="coverage-row" role="row" data-coverage-row><span><i>{String(index+1).padStart(2,'0')}</i>{row[0]}</span><span>{row[1]}</span><span>{row[2]}</span><span>{row[3]}</span></div>)}
  </div>
</section>

{!hideHandoff && (
<section class="areas-handoff" data-area-reveal><div class="container-shell"><p class="eyebrow">Care, wherever you enter</p><h2>Choose a location.<br /><em>Keep the whole plan.</em></h2><div><a href="tel:+17087551333">Call Chicago Heights ↗</a><a href="tel:+17084797733">Call Mokena ↗</a><a href="/services/">Explore services ↗</a></div></div></section>
)}

<style>
  .areas-hero{height:240svh;background:var(--pine-950);color:var(--porcelain)}.areas-hero__sticky{position:sticky;top:0;height:100svh;overflow:hidden}.areas-hero__grid{position:absolute;inset:0;display:grid;grid-template-columns:repeat(4,1fr);opacity:.1}.areas-hero__grid i{border-left:1px solid var(--mint-300)}.areas-hero header{position:absolute;z-index:5;top:16vh;left:50%;width:90%;transform:translateX(-50%);text-align:center}.areas-hero .eyebrow{color:var(--mint-300)}.areas-hero h1{margin:1.5rem 0 0;font-family:Georgia,serif;font-size:clamp(5.3rem,9vw,10rem);font-weight:400;line-height:.8;letter-spacing:-.075em}.areas-hero h1 em{color:var(--mint-300);font-weight:400}.office-plane{position:absolute;z-index:2;top:42%;width:42vw;height:47vh;overflow:hidden;border-radius:1rem;box-shadow:0 30px 80px rgba(0,0,0,.3)}.office-plane::after{position:absolute;inset:0;background:linear-gradient(180deg,transparent 48%,rgba(6,29,25,.85));content:''}.office-plane--chicago{left:5vw;transform:rotate(-3deg)}.office-plane--mokena{right:5vw;transform:rotate(3deg)}.office-plane img{width:100%;height:100%;object-fit:cover;filter:saturate(.75)}.office-plane>div{position:absolute;z-index:1;right:1.5rem;bottom:1.2rem;left:1.5rem;display:grid;grid-template-columns:auto 1fr;gap:.5rem 1rem;align-items:end}.office-plane span{grid-row:1/3;color:var(--mint-300);font-size:.62rem}.office-plane h2{margin:0;font-family:Georgia,serif;font-size:clamp(2rem,3vw,3.6rem);font-weight:400}.office-plane p{margin:0;color:rgba(245,240,231,.65);font-size:.62rem}.areas-hero__route{position:absolute;z-index:4;top:64%;left:50%;display:flex;width:26vw;align-items:center;gap:1rem;transform:translateX(-50%)}.areas-hero__route i{height:1px;flex:1;background:var(--mint-300)}.areas-hero__route span{font-size:.56rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.areas-hero__jump{position:absolute;z-index:5;bottom:2rem;left:50%;padding:.8rem 1rem;border:1px solid rgba(245,240,231,.3);border-radius:999px;font-size:.6rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase;transform:translateX(-50%)}
  .areas-intro{padding:clamp(9rem,16vw,16rem) 0;background:var(--paper)}.areas-intro>.container-shell{display:grid;grid-template-columns:.5fr 1.5fr;gap:4vw}.areas-intro .eyebrow{color:var(--pine-700)}.areas-intro h2{margin:0;font-family:Georgia,serif;font-size:clamp(4rem,7vw,8rem);font-weight:400;line-height:.84;letter-spacing:-.07em}.areas-intro h2 em{color:var(--pine-700);font-weight:400}.areas-intro>.container-shell>div{grid-column:2;display:flex;margin-top:3rem;justify-content:space-between;gap:2rem;border-top:1px solid rgba(16,35,31,.2);padding-top:1rem}.areas-intro>.container-shell>div p{max-width:34rem;margin:0;line-height:1.7;color:rgba(16,35,31,.65)}.areas-intro>.container-shell>div span{font-size:.62rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}
  .community-map{height:330svh;background:var(--pine-950);color:var(--porcelain)}.community-map__sticky{position:sticky;top:0;height:100svh;overflow:hidden}.community-map header{position:absolute;z-index:4;top:10vh;left:5vw}.community-map .eyebrow{color:var(--mint-300)}.community-map h2{margin:1rem 0 0;font-family:Georgia,serif;font-size:clamp(4.5rem,7vw,8rem);font-weight:400;letter-spacing:-.07em}.route-orbit{position:absolute;top:54%;left:50%;width:min(75vw,70rem);aspect-ratio:2.1;transform:translate(-50%,-50%);will-change:transform}.route-orbit__ring{position:absolute;inset:0;border:1px solid rgba(158,215,196,.25);border-radius:50%}.route-node{position:absolute;top:50%;width:1.1rem;aspect-ratio:1;border:4px solid var(--pine-950);border-radius:50%;background:var(--mint-300);box-shadow:0 0 0 1px var(--mint-300)}.route-node--one{left:0}.route-node--two{right:0}.community-cloud{position:absolute;z-index:3;top:35%;display:flex;width:41vw;flex-wrap:wrap;gap:.55rem}.community-cloud--chicago{left:5vw}.community-cloud--mokena{right:5vw;justify-content:flex-end}.community-cloud span{padding:.65rem .85rem;border:1px solid rgba(245,240,231,.28);border-radius:999px;background:rgba(6,29,25,.76);color:rgba(245,240,231,.92);font-family:Georgia,serif;font-size:clamp(.8rem,1.25vw,1.15rem);opacity:calc(.68 + (var(--i) * .015))}.community-map__offices{position:absolute;z-index:4;right:5vw;bottom:3rem;left:5vw;display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center}.community-map__offices article{display:grid;grid-template-columns:2rem auto;gap:.25rem}.community-map__offices article span{grid-row:1/3;color:var(--mint-300);font-size:.56rem}.community-map__offices strong{font-family:Georgia,serif;font-size:1.4rem;font-weight:400}.community-map__offices small{color:rgba(245,240,231,.55)}.community-map__offices>i{height:1px;background:rgba(158,215,196,.35)}
  .office-detail{background:var(--paper)}.office-detail>article{display:grid;min-height:100svh;grid-template-columns:1fr 1fr}.office-detail>article:nth-child(even) .office-detail__media{order:2}.office-detail__media{overflow:hidden}.office-detail__media img{width:100%;height:100%;object-fit:cover;filter:saturate(.75)}.office-detail__copy{display:flex;padding:clamp(7rem,10vw,11rem) 6vw;flex-direction:column;justify-content:center}.office-detail__copy .eyebrow{color:var(--pine-700)}.office-detail__copy h2{margin:1.5rem 0 2rem;font-family:Georgia,serif;font-size:clamp(4rem,6.5vw,7rem);font-weight:400;line-height:.84;letter-spacing:-.07em}.office-detail__copy h2 em{color:var(--pine-700);font-weight:400}.office-detail__copy>p:not(.eyebrow){max-width:28rem;color:rgba(16,35,31,.65);line-height:1.65}.office-detail__copy address{margin:2rem 0 1rem;font-family:Georgia,serif;font-size:1.4rem;font-style:normal}.office-detail__copy>a{width:max-content;padding-bottom:.35rem;border-bottom:1px solid currentColor;font-weight:800}.office-detail__copy small{margin-top:2rem;line-height:1.6;color:rgba(16,35,31,.5)}
  .coverage-matrix{padding:clamp(8rem,14vw,14rem) 0;background:var(--porcelain)}.coverage-matrix__head{display:grid;grid-template-columns:.45fr 1.3fr .65fr;gap:4vw}.coverage-matrix .eyebrow{color:var(--pine-700)}.coverage-matrix h2{margin:0;font-family:Georgia,serif;font-size:clamp(3.8rem,6.5vw,7.2rem);font-weight:400;line-height:.85;letter-spacing:-.065em}.coverage-matrix h2 em{color:var(--pine-700);font-weight:400}.coverage-matrix__head>p:last-child{margin:0;color:rgba(16,35,31,.62);line-height:1.7}.coverage-table{margin-top:7rem;border-top:1px solid rgba(16,35,31,.25)}.coverage-row{display:grid;padding:1.35rem 0;grid-template-columns:1.5fr .5fr .65fr .65fr;gap:1rem;align-items:center;border-bottom:1px solid rgba(16,35,31,.18);font-size:.72rem}.coverage-row>span:first-child{display:grid;grid-template-columns:2.5rem 1fr;font-family:Georgia,serif;font-size:1.5rem}.coverage-row i{color:var(--pine-700);font-family:sans-serif;font-size:.55rem;font-style:normal}.coverage-row>span:nth-child(n+2){color:rgba(16,35,31,.6)}.coverage-row--head{font-size:.55rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.coverage-row--head>span:first-child{display:block;font-family:inherit;font-size:inherit}
  .areas-handoff{padding:clamp(9rem,16vw,16rem) 0;background:var(--mint-200);text-align:center}.areas-handoff .eyebrow{color:var(--pine-700)}.areas-handoff h2{margin:2rem 0 3rem;font-family:Georgia,serif;font-size:clamp(4rem,8vw,9rem);font-weight:400;line-height:.82;letter-spacing:-.07em}.areas-handoff h2 em{color:var(--pine-700);font-weight:400}.areas-handoff>div>div{display:flex;justify-content:center;flex-wrap:wrap;gap:.8rem}.areas-handoff a{padding:.9rem 1.2rem;border:1px solid rgba(16,35,31,.3);border-radius:999px;font-size:.62rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
  @media(max-width:68rem){.areas-hero h1{font-size:clamp(5rem,11vw,7.5rem)}.office-plane{top:45%;width:47vw}.office-plane--chicago{left:1.5vw}.office-plane--mokena{right:1.5vw}.areas-hero__route{width:15vw}.areas-intro>.container-shell{grid-template-columns:1fr}.areas-intro>.container-shell>div{grid-column:auto}.community-cloud{top:37%;width:45vw}.office-detail>article{min-height:75svh}.coverage-matrix__head{grid-template-columns:1fr}.coverage-matrix__head>p:last-child{max-width:35rem}.coverage-row{grid-template-columns:1.35fr .5fr .7fr .7fr}.coverage-row>span:first-child{font-size:1.2rem}}
  @media(max-width:46rem){.areas-hero{height:215svh}.areas-hero__grid{grid-template-columns:repeat(2,1fr)}.areas-hero header{top:8rem}.areas-hero h1{font-size:clamp(4rem,17vw,5.3rem)}.office-plane{top:auto;width:78vw;height:36vh}.office-plane--chicago{right:auto;bottom:23vh;left:-8vw}.office-plane--mokena{right:-8vw;bottom:6vh}.office-plane h2{font-size:2rem}.areas-hero__route{top:auto;bottom:18vh;width:30vw}.areas-hero__jump{bottom:1rem}.areas-intro{padding:7rem 0}.areas-intro h2{font-size:clamp(3.5rem,15vw,4.8rem)}.areas-intro>.container-shell>div{display:grid}.community-map{height:280svh}.community-map header{top:7rem;right:1rem;left:1rem}.community-map h2{font-size:clamp(3.8rem,15vw,5rem)}.route-orbit{top:52%;width:130vw;aspect-ratio:1.6}.community-cloud{top:34%;width:80vw}.community-cloud--chicago{left:1rem}.community-cloud--mokena{top:55%;right:1rem}.community-cloud span{font-size:.72rem}.community-map__offices{right:1rem;left:1rem}.community-map__offices strong{font-size:1rem}.office-detail>article{display:flex;min-height:auto;flex-direction:column}.office-detail>article:nth-child(even) .office-detail__media{order:0}.office-detail__media{height:60svh}.office-detail__copy{padding:6rem 1rem}.office-detail__copy h2{font-size:clamp(3.5rem,15vw,4.8rem)}.coverage-matrix{padding:7rem 0}.coverage-matrix h2{font-size:clamp(3.5rem,15vw,4.8rem)}.coverage-table{margin-top:4rem;overflow-x:auto}.coverage-row{width:47rem;grid-template-columns:1.4fr .55fr .75fr .75fr}.areas-handoff h2{font-size:clamp(3.5rem,15vw,5rem)}}
  @media(prefers-reduced-motion:reduce){.areas-hero,.community-map{height:auto}.areas-hero__sticky,.community-map__sticky{position:relative;min-height:100svh}.office-plane{transform:none}.office-detail>article{min-height:auto}}
</style>

<script>
  import gsap from 'gsap';import {ScrollTrigger} from 'gsap/ScrollTrigger';gsap.registerPlugin(ScrollTrigger);const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!reduce){const heroStage=document.querySelector<HTMLElement>('[data-areas-hero]');if(heroStage){const compactHero=window.matchMedia('(max-width:68rem)').matches;const hero=gsap.timeline({scrollTrigger:{trigger:heroStage,start:'top top',end:'bottom bottom',scrub:.78,invalidateOnRefresh:true}});hero.to('[data-areas-title]',{y:compactHero?'-8vh':'-16vh',scale:compactHero?.84:.78,opacity:compactHero?.32:.18,duration:.5,ease:'sine.inOut'},0).to('[data-area-plane="chicago"]',{x:'28vw',rotation:0,scale:1.08,duration:.7,ease:'sine.inOut'},.12).to('[data-area-plane="mokena"]',{x:'-28vw',rotation:0,scale:1.08,duration:.7,ease:'sine.inOut'},.12).to('.areas-hero__route',{scaleX:0,opacity:0,duration:.35},.2).to('.office-plane img',{scale:1.12,duration:1,ease:'none'},0);}
    const communityStory=document.querySelector<HTMLElement>('[data-community-story]');if(communityStory){const route=gsap.timeline({scrollTrigger:{trigger:communityStory,start:'top top',end:'bottom bottom',scrub:.8,invalidateOnRefresh:true}});route.from('[data-community-cloud="chicago"] span',{x:-80,opacity:0,stagger:.025,duration:.35},0).to('[data-route-orbit]',{rotation:180,scale:1.15,duration:1,ease:'none'},0).from('[data-community-cloud="mokena"] span',{x:80,opacity:0,stagger:.03,duration:.35},.4).to('[data-community-cloud="chicago"]',{y:-45,opacity:.45,duration:.3},.65).to('[data-community-cloud="mokena"]',{y:45,duration:.3},.65);}
    document.querySelectorAll<HTMLElement>('[data-area-reveal]').forEach(section=>gsap.from(section.children,{y:70,opacity:0,stagger:.08,duration:.9,ease:'power3.out',scrollTrigger:{trigger:section,start:'top 82%',once:true}}));document.querySelectorAll<HTMLElement>('[data-coverage-row]').forEach(row=>gsap.from(row,{xPercent:-4,opacity:0,duration:.55,ease:'power2.out',scrollTrigger:{trigger:row,start:'top 88%',once:true}}));}
</script>
