        const chapterHandlers = chapterButtons.map((button, index) => {
          const handler = () => {
            const travel = Math.max(0, story.offsetHeight - window.innerHeight);
            const destination = story.offsetTop + (index / Math.max(1, cards.length - 1)) * travel;
            showCard(index);
            window.scrollTo({ top: destination, behavior: 'smooth' });
          };
          button.addEventListener('click', handler);
          return handler;
        });
        const trigger = ScrollTrigger.create({
          trigger: story,
          start: 'top top',
          end: 'bottom bottom',
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            showCard(Math.min(cards.length - 1, Math.floor(self.progress * cards.length)));
            gsap.set(progress, { scaleX: self.progress });
          }
        });
        return () => {
          transition?.kill();
          trigger.kill();
          chapterButtons.forEach((button, index) => button.removeEventListener('click', chapterHandlers[index]));
          gsap.set(cards, { clearProps: 'flexGrow' });
        };
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-reveal-section]').forEach((section) => {
    section.classList.add('is-pending');
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { section.classList.remove('is-pending'); observer.disconnect(); }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
    observer.observe(section);
  });

  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-about-parallax]').forEach((holder) => {
      const image = holder.querySelector<HTMLElement>('img');
      if (!image) return;
      gsap.fromTo(image, { yPercent: -5 }, { yPercent: 5, ease: 'none', scrollTrigger: { trigger: holder, start: 'top bottom', end: 'bottom top', scrub: 0.6 } });
    });
  }
</script>
