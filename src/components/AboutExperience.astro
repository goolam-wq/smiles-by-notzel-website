---
const doctors = [
  {
    number: '01',
    name: 'Dr. Joseph William Noetzel',
    role: 'Restorative perspective',
    copy: 'Care starts by understanding the structure, the long-term plan and the person who will live with the result.',
    image: '/images/generated/unique/about/about-doctor-joseph-provisional.webp',
  },
  {
    number: '02',
    name: 'Dr. Ilenne Noetzel',
    role: 'Complete-health perspective',
    copy: 'Oral health can reveal a wider story. Listening closely helps the team connect what is visible with what matters beyond the smile.',
    image: '/images/generated/unique/about/about-doctor-ilenne-provisional.webp',
  },
  {
    number: '03',
    name: 'Dr. Michael Drinski',
    role: 'Clinical coordination',
    copy: 'Clear records and a coordinated sequence keep complex decisions understandable, considered and grounded in the next right step.',
    image: '/images/generated/unique/about/about-doctor-michael-provisional.webp',
  },
];

const faqs = [
  ['What makes the practice different?', 'The practice connects preventive, restorative, cosmetic and complete-health thinking in one coordinated care experience. Recommendations are explained in context—not as isolated procedures.'],
  ['Can my family use both offices?', 'Yes. Chicago Heights and Mokena work as two connected offices, so the team can help coordinate care around the location and schedule that fit your family.'],
  ['Will I understand my options before treatment begins?', 'That is the goal. The team uses conversation, clinical records and visual explanations to make the reason, sequence and tradeoffs behind a recommendation easier to understand.'],
  ['Do you offer both routine and complex care?', 'The practice supports routine prevention as well as more involved restorative, cosmetic and wellness-centered care. Your first visit helps clarify the right starting point.'],
  ['How do I begin?', 'Choose the office that works for you, call the team or send the short request form at the bottom of this page. The team will help identify the most appropriate visit.'],
];
---

<section class="about-hero" id="top" data-about-hero data-hero-stage>
  <div class="about-hero__sticky">
    <div class="about-hero__visual" aria-hidden="true">
      <img src="/images/generated/unique/about/about-hero-team-arrival.webp" alt="" fetchpriority="high" decoding="async" />
      <div class="about-hero__wash"></div>
    </div>
    <div class="about-hero__copy container-shell">
      <p class="about-kicker">About Smiles by Noetzel · two connected offices</p>
      <h1>Care begins<br />with <em>being seen.</em></h1>
      <p>Not a collection of appointments. A connected relationship built around your health, your questions and the life beyond the chair.</p>
      <a href="#our-story">Meet the practice <span>↓</span></a>
    </div>
    <div class="about-hero__rail" aria-hidden="true"><span>Chicago Heights</span><i></i><b>01</b><i></i><span>Mokena</span></div>
  </div>
</section>

<section class="about-story about-light" id="our-story" data-reveal-section>
  <div class="about-story__grid container-shell">
    <header>
      <p class="about-kicker">01 · Our story</p>
      <h2>A practice built<br />to keep the <em>whole story</em><br />in view.</h2>
    </header>
    <figure>
      <img src="/images/generated/unique/about/about-practice-story-collaboration.webp" alt="Two clinicians reviewing a patient plan together in the practice" loading="lazy" decoding="async" />
      <figcaption><span>One conversation</span><span>One connected plan</span></figcaption>
    </figure>
    <div class="about-story__body">
      <p class="lead">Smiles by Noetzel brings dentistry and wellness thinking together so that one decision can make sense beside the next.</p>
      <p>The team looks at today’s concern, the history behind it and the long-term direction ahead. That means fewer disconnected answers and a clearer reason for every next step.</p>
      <div class="about-story__facts"><span><strong>02</strong> connected offices</span><span><strong>01</strong> coordinated team</span></div>
    </div>
  </div>
</section>

<section class="about-philosophy" data-reveal-section>
  <div class="about-philosophy__image" data-about-parallax>
    <img src="/images/generated/unique/about/about-philosophy-consultation.webp" alt="A dentist listening carefully to a patient during a consultation" loading="lazy" decoding="async" />
  </div>
  <div class="about-philosophy__content">
    <p class="about-kicker">02 · Our point of view</p>
    <h2>Listen first.<br /><em>Then look closer.</em></h2>
    <p>Clinical detail matters. So does the way a question is heard. We believe a thoughtful plan begins when evidence and lived experience are allowed in the same room.</p>
    <ol>
      <li><span>01</span><strong>Understand what brought you here.</strong></li>
      <li><span>02</span><strong>Connect the findings—not just the symptoms.</strong></li>
      <li><span>03</span><strong>Explain the path before asking you to take it.</strong></li>
    </ol>
  </div>
</section>

<section class="about-doctors about-light" id="team" data-doctor-story>
  <div class="about-doctors__sticky">
    <header class="about-doctors__intro container-shell">
      <p class="about-kicker">03 · Meet the doctors</p>
      <div>
        <h2>Three perspectives.<br /><em>One standard of care.</em></h2>
        <p>One connected clinical team—seen through three distinct perspectives.</p>
      </div>
    </header>
    <div class="about-doctors__viewport" aria-live="polite">
      <div class="about-doctors__track" data-doctor-track>
        {doctors.map((doctor) => (
          <article class="doctor-card" data-doctor-card>
            <figure><img src={doctor.image} alt={`Environmental portrait representing ${doctor.name}`} loading="lazy" decoding="async" /></figure>
            <div class="doctor-card__dossier">
              <span>{doctor.number} · {doctor.role}</span>
              <h3>{doctor.name}</h3>
              <p>{doctor.copy}</p>
              <a href="#contact">Begin a conversation <b>↗</b></a>
            </div>
          </article>
        ))}
      </div>
    </div>
    <nav class="about-doctors__chapters" aria-label="Choose a doctor">
      {doctors.map((doctor, index) => (
        <button type="button" data-doctor-jump={index} aria-current={index === 0 ? 'true' : 'false'}>
          <span>{doctor.number}</span><strong>{doctor.name.replace('Dr. ', '')}</strong>
        </button>
      ))}
    </nav>
    <div class="about-doctors__progress container-shell" aria-hidden="true"><span>01</span><i><b data-doctor-progress></b></i><span>03</span></div>
  </div>
</section>

<section class="about-team" data-reveal-section>
  <div class="about-team__visual" data-about-parallax>
    <img src="/images/generated/unique/about/about-team-huddle.webp" alt="The clinical and front-office team coordinating the day together" loading="lazy" decoding="async" />
    <div><span>Clinical team</span><strong>Coordination is part of the care.</strong></div>
  </div>
  <div class="about-team__content">
    <p class="about-kicker">04 · The team around the visit</p>
    <h2>No handoff should<br />feel like <em>starting over.</em></h2>
    <p>From the first phone call to the clinical room, the details should travel with you. Our team shares context, clarifies questions and helps keep the experience human.</p>
    <div class="about-team__list">
      <span><b>01</b> A welcome that knows why you came</span>
      <span><b>02</b> Records that support the conversation</span>
      <span><b>03</b> Follow-through that keeps the next step clear</span>
    </div>
  </div>
</section>

<section class="about-why about-light" data-reveal-section>
  <header class="container-shell">
    <p class="about-kicker">05 · Why choose us</p>
    <h2>Thoughtful dentistry<br />is felt <em>between</em> the procedures.</h2>
  </header>
  <div class="about-why__grid container-shell">
    <article><span>01</span><h3>More context</h3><p>Your mouth, health history, priorities and timing are considered together.</p></article>
    <article><span>02</span><h3>Clearer choices</h3><p>Options are explained with the reason, sequence and tradeoffs made visible.</p></article>
    <article><span>03</span><h3>Connected offices</h3><p>Chicago Heights and Mokena share one standard and one coordinated care story.</p></article>
    <article><span>04</span><h3>A natural result</h3><p>The goal is care that supports health and still feels unmistakably like you.</p></article>
  </div>
</section>

<section class="about-technology" data-reveal-section>
  <div class="about-technology__copy">
    <p class="about-kicker">06 · Technology with a reason</p>
    <h2>Better records.<br /><em>More human decisions.</em></h2>
    <p>Technology earns its place when it makes the clinical picture easier to understand—not when it gets between you and the conversation.</p>
    <ul><li>Visual records that support explanation</li><li>Planning that connects details over time</li><li>A clearer shared view of the next step</li></ul>
  </div>
  <figure data-about-parallax><img src="/images/generated/unique/about/about-technology-scan.webp" alt="A clinician using digital scanning technology while a colleague reviews the scan" loading="lazy" decoding="async" /></figure>
</section>

<section class="about-offices about-light" data-reveal-section>
  <header class="container-shell"><p class="about-kicker">07 · Two offices · one connected team</p><h2>Choose what fits your day.<br /><em>Keep the same standard.</em></h2></header>
  <div class="about-offices__grid container-shell">
    <a href="/service-areas/chicago-heights/"><span>01 · Chicago Heights</span><h3>500 Ashland Ave,<br />Suite #2</h3><p>(708) 755-1333</p><b>Explore this office ↗</b></a>
    <a href="/service-areas/mokena/"><span>02 · Mokena</span><h3>19160 88th Avenue</h3><p>(708) 479-7733</p><b>Explore this office ↗</b></a>
  </div>
</section>

<section class="about-reviews" data-reveal-section>
  <div class="about-reviews__inner container-shell">
    <p class="about-kicker">08 · Patient perspective</p>
    <blockquote>“Long-term family care with technology, efficiency and minimal waiting.”</blockquote>
    <div><span>Keanna Benson</span><p>Chicago Heights</p></div>
    <div class="about-reviews__index"><span>01</span><i></i><span>CONNECTED CARE</span></div>
  </div>
</section>

<section class="about-connected about-light" data-reveal-section>
  <header class="container-shell"><p class="about-kicker">09 · Continue your story</p><h2>Find the part of care<br />that meets you <em>now.</em></h2></header>
  <div class="about-connected__links container-shell">
    <a href="/services/"><span>All services</span><strong>Explore the complete care map</strong><i>↗</i></a>
    <a href="/services/cosmetic-dentistry/"><span>Cosmetic care</span><strong>See thoughtful aesthetic options</strong><i>↗</i></a>
    <a href="/services/complete-health-airway/"><span>Complete health</span><strong>Connect the wider health story</strong><i>↗</i></a>
    <a href="/service-areas/"><span>Service areas</span><strong>Choose the office near you</strong><i>↗</i></a>
  </div>
</section>

<section class="about-faq about-light" id="faq" data-reveal-section>
  <div class="about-faq__grid container-shell">
    <header><p class="about-kicker">10 · Questions before the visit</p><h2>A little more<br /><em>clarity.</em></h2><p>Start here, then ask us the question that is specific to you.</p></header>
    <div class="about-faq__items">
      {faqs.map(([question, answer], index) => (
        <details open={index === 0}><summary><span>{String(index + 1).padStart(2, '0')}</span><strong>{question}</strong><i>+</i></summary><p>{answer}</p></details>
      ))}
    </div>
  </div>
</section>

<style>
  .about-kicker{display:flex;align-items:center;gap:.75rem;margin:0;color:var(--mint-300);font-size:.62rem;font-weight:900;line-height:1.4;letter-spacing:.16em;text-transform:uppercase}.about-kicker::before{width:2rem;height:1px;background:currentColor;content:''}.about-light{background:var(--paper);color:var(--ink)}.about-light .about-kicker{color:var(--pine-700)}
  .about-hero{position:relative;height:175svh;background:var(--pine-950);color:var(--porcelain)}.about-hero__sticky{position:sticky;top:0;height:100svh;overflow:hidden}.about-hero__visual{position:absolute;inset:0;clip-path:inset(0 0 0 42%);transform-origin:70% 50%}.about-hero__visual img{width:100%;height:100%;object-fit:cover;object-position:center}.about-hero__wash{position:absolute;inset:0;background:linear-gradient(90deg,var(--pine-950) 0 30%,rgba(6,29,25,.82) 44%,rgba(6,29,25,.08) 75%),linear-gradient(0deg,rgba(6,29,25,.5),transparent 38%)}.about-hero__copy{position:relative;z-index:2;display:grid;height:100%;align-content:center;padding-top:7rem}.about-hero__copy h1{max-width:61rem;margin:1.7rem 0 1.7rem;font-family:Georgia,serif;font-size:clamp(5rem,9.5vw,10.5rem);font-weight:400;line-height:.79;letter-spacing:-.075em}.about-hero__copy h1 em{display:inline-block;color:var(--mint-300);font-weight:400}.about-hero__copy>p:not(.about-kicker){max-width:31rem;margin:0;color:rgba(245,240,231,.72);font-size:clamp(.92rem,1.15vw,1.1rem);line-height:1.7}.about-hero__copy>a{display:flex;width:min(100%,24rem);margin-top:2.4rem;padding:1rem 1rem 1rem 1.3rem;align-items:center;justify-content:space-between;border:1px solid rgba(245,240,231,.35);border-radius:999px;font-size:.6rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.about-hero__copy>a span{display:grid;width:2.8rem;aspect-ratio:1;place-items:center;border-radius:50%;background:var(--mint-300);color:var(--pine-950)}.about-hero__rail{position:absolute;z-index:3;right:2rem;bottom:1.5rem;left:2rem;display:grid;grid-template-columns:auto 1fr auto 1fr auto;gap:1rem;align-items:center;color:rgba(245,240,231,.82);font-size:.52rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.about-hero__rail i{height:1px;background:rgba(245,240,231,.3)}
  .about-story{padding:clamp(7rem,11vw,12rem) 0}.about-story__grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,6vw,7rem);align-items:start}.about-story header{grid-column:1/-1;display:grid;grid-template-columns:.65fr 1.35fr;gap:2rem}.about-story h2,.about-philosophy h2,.about-doctors h2,.about-team h2,.about-why h2,.about-technology h2,.about-offices h2,.about-connected h2,.about-faq h2{margin:1.4rem 0 0;font-family:Georgia,serif;font-size:clamp(4rem,7vw,8rem);font-weight:400;line-height:.86;letter-spacing:-.065em}.about-story h2{grid-column:2}.about-story h2 em,.about-philosophy h2 em,.about-doctors h2 em,.about-team h2 em,.about-why h2 em,.about-technology h2 em,.about-offices h2 em,.about-connected h2 em,.about-faq h2 em{color:var(--pine-700);font-weight:400}.about-story figure{position:relative;min-height:clamp(35rem,66vw,56rem);margin:0;overflow:hidden;border-radius:1.5rem}.about-story figure img{width:100%;height:110%;object-fit:cover;object-position:center}.about-story figcaption{position:absolute;right:1rem;bottom:1rem;left:1rem;display:flex;padding:1rem 1.2rem;justify-content:space-between;background:rgba(6,29,25,.78);color:var(--porcelain);font-size:.54rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;backdrop-filter:blur(14px)}.about-story__body{display:grid;min-height:38rem;padding:3rem 0;align-content:space-between;border-top:1px solid rgba(16,35,31,.2);border-bottom:1px solid rgba(16,35,31,.2)}.about-story__body p{max-width:34rem;color:rgba(16,35,31,.65);font-size:.95rem;line-height:1.75}.about-story__body .lead{margin:0;color:var(--ink);font-family:Georgia,serif;font-size:clamp(2rem,3.2vw,3.8rem);line-height:1.05;letter-spacing:-.035em}.about-story__facts{display:flex;gap:3rem}.about-story__facts span{display:grid;gap:.25rem;color:rgba(16,35,31,.62);font-size:.62rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.about-story__facts strong{color:var(--pine-700);font-family:Georgia,serif;font-size:3rem;font-weight:400;letter-spacing:-.05em}
  .about-philosophy{display:grid;min-height:100svh;grid-template-columns:1.05fr .95fr;background:var(--pine-950);color:var(--porcelain)}.about-philosophy__image{min-height:100svh;overflow:hidden}.about-philosophy__image img{width:100%;height:112%;object-fit:cover}.about-philosophy__content{display:grid;padding:clamp(6rem,8vw,9rem) clamp(2rem,6vw,7rem);align-content:center}.about-philosophy h2 em{color:var(--mint-300)}.about-philosophy__content>p:not(.about-kicker){max-width:35rem;color:rgba(245,240,231,.66);line-height:1.75}.about-philosophy ol{margin:2.5rem 0 0;padding:0;list-style:none;border-top:1px solid rgba(245,240,231,.2)}.about-philosophy li{display:grid;padding:1.25rem 0;grid-template-columns:3rem 1fr;gap:1rem;border-bottom:1px solid rgba(245,240,231,.2)}.about-philosophy li span{color:var(--mint-300);font-size:.55rem;font-weight:900}.about-philosophy li strong{font-family:Georgia,serif;font-size:1.35rem;font-weight:400}
  .about-doctors{position:relative;height:300svh}.about-doctors__sticky{position:sticky;top:0;display:grid;width:100%;height:100svh;padding:clamp(6.75rem,9vh,8rem) max(1rem,calc((100vw - 92rem)/2 + 1rem)) 1.5rem;grid-template-columns:minmax(20rem,.72fr) minmax(0,1.28fr);grid-template-rows:minmax(0,1fr) auto;gap:1.35rem clamp(2rem,4vw,4rem);overflow:hidden}.about-doctors header.container-shell{display:flex;width:auto;max-width:none;margin:0;padding:0;flex-direction:column;justify-content:center}.about-doctors header>div{display:block;margin-top:1.5rem}.about-doctors h2{margin:0;font-size:clamp(3.75rem,5.1vw,5.9rem);line-height:.88}.about-doctors header>div>p{max-width:24rem;margin:1.4rem 0 0;color:rgba(16,35,31,.68);font-size:.9rem;line-height:1.7}.about-doctors__viewport{position:relative;width:100%;height:100%;max-height:min(64vh,38rem);margin:0;align-self:center;overflow:hidden;border-radius:1.3rem}.about-doctors__track{position:relative;width:100%;height:100%;padding:0;will-change:transform}.doctor-card{position:absolute;inset:0;display:grid;width:100%;height:100%;grid-template-columns:.95fr 1.05fr;overflow:hidden;border:1px solid rgba(16,35,31,.16);border-radius:1.3rem;background:#f1ece3;opacity:0;visibility:hidden;will-change:opacity,transform}.doctor-card:first-child{opacity:1;visibility:visible}.doctor-card figure{margin:0;overflow:hidden}.doctor-card figure img{width:100%;height:100%;object-fit:cover}.doctor-card>div{display:grid;min-width:0;padding:clamp(1.5rem,2.7vw,3.25rem);align-content:end}.doctor-card span{color:var(--pine-700);font-size:.56rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.doctor-card h3{max-width:30rem;margin:1rem 0;font-family:Georgia,serif;font-size:clamp(2.45rem,3.4vw,4.4rem);font-weight:400;line-height:.9;letter-spacing:-.05em}.doctor-card p{max-width:28rem;color:rgba(16,35,31,.67);font-size:.82rem;line-height:1.65}.doctor-card a{margin-top:1.6rem;font-size:.57rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.about-doctors__progress.container-shell{display:grid;width:auto;max-width:none;margin:0;padding:0;grid-column:1/-1;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;color:var(--pine-700);font-size:.52rem;font-weight:900}.about-doctors__progress i{height:1px;background:rgba(16,35,31,.18)}.about-doctors__progress b{display:block;width:100%;height:100%;background:var(--pine-700);transform:scaleX(0);transform-origin:left}
  .about-team{display:grid;min-height:100svh;grid-template-columns:1.1fr .9fr;background:var(--pine-950);color:var(--porcelain)}.about-team__visual{position:relative;min-height:100svh;overflow:hidden}.about-team__visual img{width:100%;height:112%;object-fit:cover}.about-team__visual>div{position:absolute;right:1rem;bottom:1rem;left:1rem;display:flex;padding:1rem 1.2rem;justify-content:space-between;gap:1rem;background:rgba(6,29,25,.8);font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;backdrop-filter:blur(12px)}.about-team__content{display:grid;padding:clamp(6rem,8vw,9rem) clamp(2rem,6vw,7rem);align-content:center}.about-team h2 em{color:var(--mint-300)}.about-team__content>p:not(.about-kicker){max-width:33rem;color:rgba(245,240,231,.64);line-height:1.75}.about-team__list{margin-top:2rem;border-top:1px solid rgba(245,240,231,.2)}.about-team__list span{display:grid;padding:1.15rem 0;grid-template-columns:3rem 1fr;border-bottom:1px solid rgba(245,240,231,.2);font-family:Georgia,serif;font-size:1.25rem}.about-team__list b{color:var(--mint-300);font-family:inherit;font-size:.55rem;letter-spacing:.12em}
  .about-why{padding:clamp(7rem,11vw,11rem) 0}.about-why header{display:grid;grid-template-columns:.5fr 1.5fr;gap:2rem}.about-why h2{grid-column:2}.about-why__grid{display:grid;margin-top:clamp(3rem,6vw,6rem);grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(16,35,31,.2);border-left:1px solid rgba(16,35,31,.2)}.about-why article{display:grid;min-height:24rem;padding:1.5rem;align-content:space-between;border-right:1px solid rgba(16,35,31,.2);border-bottom:1px solid rgba(16,35,31,.2);transition:background .3s,color .3s,transform .3s}.about-why article:hover{background:var(--pine-950);color:var(--porcelain);transform:translateY(-.6rem)}.about-why article>span{color:var(--pine-700);font-size:.55rem;font-weight:900}.about-why article:hover>span{color:var(--mint-300)}.about-why article h3{margin:auto 0 1rem;font-family:Georgia,serif;font-size:clamp(2rem,2.8vw,3.2rem);font-weight:400;line-height:.92}.about-why article p{margin:0;color:rgba(16,35,31,.62);font-size:.78rem;line-height:1.65}.about-why article:hover p{color:rgba(245,240,231,.64)}
