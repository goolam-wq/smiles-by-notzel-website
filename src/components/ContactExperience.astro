  .contact-urgent{display:grid;padding:clamp(4rem,7vw,7rem) clamp(1rem,6vw,7rem);grid-template-columns:auto 1fr 1fr auto;gap:2rem;align-items:center;background:var(--mint-300);color:var(--pine-950)}.contact-urgent h2{margin:0;font-family:Georgia,serif;font-size:clamp(2.5rem,4vw,5rem);font-weight:400;letter-spacing:-.05em}.contact-urgent>p:not(.eyebrow){max-width:34rem;margin:0;line-height:1.65}.contact-urgent>a{display:flex;min-height:3.6rem;padding:.5rem .5rem .5rem 1.2rem;align-items:center;gap:1.5rem;border:1px solid rgba(6,29,25,.45);border-radius:999px;font-size:.6rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.contact-urgent>a span{display:grid;width:2.5rem;aspect-ratio:1;place-items:center;border-radius:50%;background:var(--pine-950);color:var(--porcelain)}
  @media(max-width:68rem){.contact-hero{padding-top:6rem}.contact-hero__inner{grid-template-columns:1fr;grid-template-rows:auto auto auto;gap:1.5rem}.contact-hero__copy{align-self:auto;padding-bottom:0}.contact-hero h1{font-size:clamp(5rem,10vw,7.5rem)}.contact-hero__media{height:54rem;grid-row:auto;grid-column:auto;border-radius:12rem 1.2rem 1.2rem 1.2rem}.contact-hero__note{display:none}.contact-form-section,.contact-paths,.contact-faq{grid-template-columns:1fr}.contact-form-section__intro,.contact-paths header,.contact-faq header{position:relative;top:auto}.contact-path{grid-template-columns:3rem 1fr auto}.contact-path p{grid-column:2/4}.contact-offices__stage{min-height:58rem}.contact-offices__cards{width:calc(100% - 2rem);min-height:58rem}.contact-next>header{grid-template-columns:1fr}.contact-human{grid-template-columns:1fr}.contact-human figure{height:48rem}.contact-urgent{grid-template-columns:1fr 1fr}.contact-urgent .eyebrow,.contact-urgent h2{grid-column:1/-1}}
  @media(max-width:46rem){.contact-hero{min-height:auto;padding:6.2rem 1rem 4rem}.contact-hero__inner{min-height:0}.contact-hero .eyebrow{font-size:.58rem}.contact-hero h1{margin:1.2rem 0;font-size:clamp(3.7rem,17vw,5.2rem);line-height:.84}.contact-hero__intro{font-size:.92rem}.contact-hero__actions{display:grid}.contact-hero__actions a{justify-content:space-between}.contact-hero__media{height:29rem;border-radius:7rem 1rem 1rem 1rem}.contact-hero__media img{height:104%;object-position:58% center}.contact-hero__media figcaption{right:1rem;bottom:1rem;left:1rem;font-size:.48rem}.contact-hero__footer{display:none}.contact-form-section,.contact-paths,.contact-offices,.contact-next,.contact-faq{padding:5.5rem 1rem}.contact-form-section h2,.contact-next h2,.contact-faq h2{font-size:clamp(3.3rem,15vw,4.7rem)}.contact-form{padding:1.2rem;grid-template-columns:1fr}.contact-form__heading,.contact-form__message,.contact-form__consent,.contact-form__submit-row,.contact-form__status{grid-column:1}.contact-form__heading{display:grid;gap:.5rem}.contact-form__submit-row{display:grid}.contact-form button{width:100%}.contact-paths header h2{font-size:clamp(3.4rem,15vw,4.8rem)}.contact-path{padding:1.3rem 0;grid-template-columns:2rem 1fr}.contact-path p,.contact-path strong{grid-column:2}.contact-offices>header{display:block}.contact-offices h2{font-size:clamp(3.4rem,15vw,4.8rem)}.contact-offices__stage{min-height:58rem}.contact-offices__cards{display:grid;width:100%;min-height:58rem;padding:1rem;grid-template-columns:1fr;align-content:end}.contact-offices__cards article{min-height:auto;padding:1.2rem}.contact-offices__stage::after{background:linear-gradient(180deg,rgba(6,29,25,.15),rgba(6,29,25,.8))}.contact-next__steps{grid-template-columns:1fr}.contact-next__steps article{min-height:18rem;border-right:0;border-bottom:1px solid rgba(16,35,31,.22)}.contact-human{min-height:auto}.contact-human figure{height:28rem}.contact-human__copy{padding:4rem 1rem}.contact-human h2{font-size:clamp(3.3rem,14vw,4.6rem)}.contact-faq details p{padding-left:0}.contact-urgent{padding:4rem 1rem;grid-template-columns:1fr}.contact-urgent .eyebrow,.contact-urgent h2{grid-column:1}.contact-urgent>a{justify-content:space-between}}
  @media(prefers-reduced-motion:reduce){.contact-hero__media img{height:100%}.contact-form-section__intro,.contact-paths header,.contact-faq header{position:relative;top:auto}}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    gsap.from('[data-contact-hero-copy] > *', { y: 36, opacity: 0, duration: .85, stagger: .09, ease: 'power3.out' });
    gsap.from('[data-contact-hero-media]', { y: 42, clipPath: 'inset(0 0 100% 0 round 18rem 1.5rem 1.5rem 1.5rem)', duration: 1.1, delay: .12, ease: 'power3.out' });
    gsap.to('[data-contact-hero-media] img', { yPercent: -4, scale: 1.035, ease: 'none', scrollTrigger: { trigger: '[data-contact-hero]', start: 'top top', end: 'bottom top', scrub: .7, invalidateOnRefresh: true } });
    document.querySelectorAll<HTMLElement>('[data-contact-reveal]').forEach((section) => {
      gsap.from(Array.from(section.children), { y: 46, opacity: 0, duration: .8, stagger: .07, ease: 'power3.out', scrollTrigger: { trigger: section, start: 'top 82%', once: true } });
    });
    gsap.from('[data-contact-path]', { x: 38, opacity: 0, duration: .65, stagger: .08, ease: 'power2.out', scrollTrigger: { trigger: '.contact-paths__list', start: 'top 78%', once: true } });
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const label = button?.querySelector('span');
    const status = form.querySelector<HTMLOutputElement>('.contact-form__status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (button) button.disabled = true;
      if (label) label.textContent = 'Sending…';
      if (status) status.textContent = 'Sending your request…';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Submission failed');
        form.reset();
        if (status) status.textContent = 'Thank you—your request was sent. A team member will follow up.';
      } catch {
        if (status) status.textContent = 'We could not send that request. Please call the team directly.';
      } finally {
        if (button) button.disabled = false;
        if (label) label.textContent = 'Send request';
      }
    });
  }
</script>
