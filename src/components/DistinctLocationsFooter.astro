<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!reduced){
    const split=gsap.timeline({scrollTrigger:{trigger:'[data-split-story]',start:'top top',end:'bottom bottom',scrub:.85,invalidateOnRefresh:true}});
    split.to('[data-office="chicago"]',{width:'72%',duration:.6,ease:'power2.inOut'},.25).to('[data-office="mokena"]',{width:'28%',duration:.6,ease:'power2.inOut'},.25)
      .to('[data-office="chicago"] .office-copy',{opacity:1,y:0,duration:.4},.35)
      .to('.split-title',{opacity:.1,y:'-10vh',scale:.7,duration:.45},.48)
      .to('[data-office="chicago"] .office-copy',{opacity:0,y:-25,duration:.25},.9)
      .to('[data-office="chicago"]',{width:'28%',duration:.65,ease:'power2.inOut'},1).to('[data-office="mokena"]',{width:'72%',duration:.65,ease:'power2.inOut'},1)
      .to('[data-office="mokena"] .office-copy',{opacity:1,y:0,duration:.4},1.15)
      .to('.office--chicago img',{scale:1.12,duration:1.6,ease:'none'},0).to('.office--mokena img',{scale:1.12,duration:1.6,ease:'none'},0);
    gsap.utils.toArray<HTMLElement>('[data-fade]').forEach(item=>gsap.from(item,{y:65,opacity:0,duration:.8,ease:'power3.out',scrollTrigger:{trigger:item,start:'top 88%',once:true}}));

  }

  const appointmentForm=document.querySelector<HTMLFormElement>('[data-appointment-form]');
  if(appointmentForm){
    const submitButton=appointmentForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel=submitButton?.querySelector<HTMLElement>('span');
    const status=appointmentForm.querySelector<HTMLOutputElement>('[data-form-status]');
    appointmentForm.addEventListener('submit',async(event)=>{
      event.preventDefault();
      if(!appointmentForm.reportValidity()) return;
      if(submitButton) submitButton.disabled=true;
      if(submitLabel) submitLabel.textContent='Sending…';
      if(status) status.textContent='Sending your request…';
      appointmentForm.classList.remove('is-success');
      try{
        const response=await fetch(appointmentForm.action,{
          method:'POST',
          body:new FormData(appointmentForm),
          headers:{Accept:'application/json'}
        });
        if(!response.ok) throw new Error('Submission failed');
        appointmentForm.reset();
        appointmentForm.classList.add('is-success');
        if(status) status.textContent='Thank you—your request was sent. The team will be in touch.';
      }catch(error){
        if(status) status.textContent='We couldn’t send that. Please call (708) 755-1333.';
      }finally{
        if(submitButton) submitButton.disabled=false;
        if(submitLabel) submitLabel.textContent='Send request';
      }
    });
  }
</script>
