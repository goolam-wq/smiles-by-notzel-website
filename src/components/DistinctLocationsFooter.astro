  .footer-bottom{position:relative;z-index:5;font-size:.52rem;letter-spacing:.08em;text-transform:uppercase}.footer-bottom__nav{display:grid;padding:1rem 0;grid-template-columns:1fr 1.2fr 1fr;gap:2rem;border-top:1px solid rgba(245,240,231,.18);border-bottom:1px solid rgba(245,240,231,.18)}.footer-bottom__nav>div{display:grid;gap:.28rem}.footer-bottom__nav>div span{color:rgba(245,240,231,.55)}.footer-bottom__nav nav{display:flex;justify-content:center;gap:1rem}.footer-bottom__nav>span{text-align:right}.footer-details{display:grid;padding-top:1rem;grid-template-columns:1fr 1fr .8fr;gap:clamp(1rem,3vw,3rem);text-transform:none}.footer-details section{display:grid;align-content:start;gap:.35rem}.footer-details section>span{color:var(--mint-300);font-size:.48rem;font-weight:900;letter-spacing:.11em;text-transform:uppercase}.footer-details section>a:not(.footer-details__phone){color:rgba(245,240,231,.72);font-size:.56rem;line-height:1.4}.footer-details__phone{font-family:Georgia,serif;font-size:1.15rem;letter-spacing:-.02em}.footer-details p{margin:.2rem 0 0;color:rgba(245,240,231,.5);font-size:.5rem;line-height:1.55}.footer-details__connect nav{display:flex;gap:.8rem;font-size:.53rem;text-transform:uppercase}.footer-details__connect nav a{padding-bottom:.2rem;border-bottom:1px solid rgba(245,240,231,.25)}
  @media (min-width:46.001rem) and (max-width:68rem){.split-story{height:300svh}.split-title h2{font-size:clamp(5rem,10vw,7rem)}.office-copy{right:1rem;left:1rem}.office-copy h3{font-size:clamp(3rem,5vw,4.5rem)}.faq-grid{grid-template-columns:1fr}.faq-heading{position:relative;top:auto}.footer-sticky{padding-top:7rem;gap:1.75rem}.footer-intro h2{font-size:clamp(3.5rem,7vw,5rem)}.footer-portal{width:88vw}.footer-portal__copy{gap:1rem}.footer-portal__copy p{font-size:1.45rem}.footer-portal__links{gap:.7rem}.footer-portal__links>a:first-child{min-width:10rem}.footer-form{grid-template-columns:1fr 1fr}.footer-form__submit{min-width:100%}.footer-form__meta{grid-column:1/-1}.footer-bottom__nav{grid-template-columns:1fr 1fr}.footer-bottom__nav>span{display:none}.footer-bottom__nav nav{justify-content:flex-end}.footer-details{grid-template-columns:1fr 1fr .8fr;gap:1.3rem}}
