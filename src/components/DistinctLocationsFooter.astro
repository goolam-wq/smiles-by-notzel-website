{font-size:1.02rem}.footer-details p{font-size:.46rem;line-height:1.4}.footer-details__connect{grid-column:1/-1;grid-template-columns:1fr auto;align-items:end}.footer-details__connect>span,.footer-details__connect>p{grid-column:1/-1}.footer-details__email{font-size:.51rem!important}.footer-details__connect nav{font-size:.46rem}}
