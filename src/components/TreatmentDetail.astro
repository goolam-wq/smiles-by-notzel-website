  .story-diagnostic__visual{grid-column:1;grid-row:2;position:relative;height:auto;min-height:0;margin:0;border-radius:0;overflow:hidden;background:var(--pine-950)}
  .story-diagnostic__visual>img,.story-diagnostic__reveal img{width:100%;height:100%;object-fit:cover;object-position:50% center;transform:scale(1.025)}
  .story-diagnostic__base{filter:saturate(.22) sepia(.2) brightness(.66)}
