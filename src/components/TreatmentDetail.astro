  .story-diagnostic__steps article{display:grid;grid-template-columns:2.25rem 1fr;padding:1.25rem 0;border-bottom:1px solid rgba(16,35,31,.18);opacity:.3;transform:translateX(1.25rem);transition:opacity .25s ease,transform .25s ease}
  .story-diagnostic__steps article.is-active{opacity:1;transform:none}
