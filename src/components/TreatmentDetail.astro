  /* Immersive redesign v2: four distinct interaction grammars */
  .hero-cinema{display:block;padding:0;isolation:isolate;background:#061d19}
  .hero-cinema__image,.hero-cinema__aperture{position:absolute;inset:0;overflow:hidden}
  .hero-cinema__image img,.hero-cinema__aperture img{width:100%;height:100%;object-fit:cover;object-position:64% center;transform:scale(1.045);will-change:transform}
  .hero-cinema__image{filter:saturate(.42) brightness(.48)}
  .hero-cinema__matte{position:absolute;z-index:2;inset:0;background:linear-gradient(90deg,rgba(4,24,20,.98) 0%,rgba(4,24,20,.9) 31%,rgba(4,24,20,.28) 59%,rgba(4,24,20,.08) 100%);pointer-events:none}
  .hero-cinema__aperture{z-index:1;clip-path:ellipse(8% 34% at 76% 50%);filter:saturate(1.04) brightness(.96);will-change:clip-path}
  .hero-cinema__aperture:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(4,24,20,.22),transparent 45%);pointer-events:none}
  .hero-cinema__aperture>span{position:absolute;right:2rem;top:50%;z-index:2;writing-mode:vertical-rl;color:var(--porcelain);font-size:.52rem;font-weight:800;letter-spacing:.2em;transform:translateY(-50%)}
  .hero-cinema__copy{position:absolute;z-index:4;left:clamp(1.25rem,6vw,7rem);top:50%;width:min(43vw,44rem);transform:translateY(-48%)}
  .hero-cinema__copy h1{font-size:clamp(5rem,8.2vw,9rem);line-height:.78;margin:1.5rem 0 2rem}
  .hero-cinema__copy>p:last-of-type{max-width:30rem}
  .hero-cinema__rail{position:absolute;z-index:5;left:clamp(1.25rem,6vw,7rem);right:clamp(1.25rem,6vw,7rem);bottom:2.25rem;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(196,234,220,.24)}
  .hero-cinema__rail>div{display:flex;gap:1rem;padding:1rem 0 0;color:rgba(245,240,231,.36);font-size:.6rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase;transition:color .28s ease}
  .hero-cinema__rail>div+div{padding-left:1.5rem;border-left:1px solid rgba(196,234,220,.16)}
  .hero-cinema__rail>div.is-active{color:var(--mint-300)}
  .hero-cinema__progress{position:absolute;z-index:6;left:0;right:0;bottom:0;height:3px;background:rgba(196,234,220,.12)}
  .hero-cinema__progress i{display:block;width:0;height:100%;background:var(--mint-300);will-change:width}

  .story-diagnostic{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(20rem,.92fr);grid-template-rows:auto minmax(0,1fr);column-gap:clamp(3rem,6vw,7rem);row-gap:2.25rem;align-items:stretch}
