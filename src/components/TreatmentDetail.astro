<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const bootTreatment = () => {
    document.querySelectorAll<HTMLElement>('[data-treatment-root]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const q = gsap.utils.selector(root);
      const mm = gsap.matchMedia();

      const revealOnce = (element: Element, reveal: () => void) => {
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          reveal();
        }, {threshold:.2, rootMargin:'0px 0px -8%'});
        observer.observe(element);
      };

      const hero = q('[data-treatment-hero]')[0];
      const heroFolds = q('[data-hero-fold]') as HTMLElement[];
      if (hero && heroFolds.length === 3) {
        const phases = q('[data-hero-phase]');
        const edition = q('[data-hero-edition]')[0];
        const scan = q('[data-fold-scan]')[0];
        const progress = q('[data-hero-progress]')[0];
        const copy = q('[data-hero-copy]')[0];
        const mobile = innerWidth <= 720;
        const tablet = innerWidth > 720 && innerWidth <= 1100;
        const restingLeft = mobile ? ['0vw','33vw','66vw'] : tablet ? ['46vw','64vw','82vw'] : ['44vw','63vw','82vw'];
        const restingWidth = mobile ? ['34vw','34vw','34vw'] : tablet ? ['18vw','18vw','18vw'] : ['19vw','19vw','19vw'];
        const top = mobile ? '34vh' : '8vh';
        const height = mobile ? '60vh' : '84vh';
        const activeLeft = mobile
          ? [['0vw','52vw','76vw'],['0vw','24vw','76vw'],['0vw','24vw','48vw']]
          : tablet
            ? [['46vw','74vw','87vw'],['46vw','59vw','87vw'],['46vw','59vw','72vw']]
            : [['44vw','73vw','87vw'],['44vw','58vw','87vw'],['44vw','58vw','72vw']];
        const activeWidth = mobile ? ['52vw','24vw','24vw'] : tablet ? ['28vw','13vw','13vw'] : ['29vw','14vw','14vw'];

        const setActive = (active: number | null, animate = true) => {
          heroFolds.forEach((fold,index) => {
            const width = active === null ? restingWidth[index] : activeWidth[index === active ? 0 : 1];
            const left = active === null ? restingLeft[index] : activeLeft[active][index];
            fold.classList.toggle('is-active',active === index);
            gsap.to(fold,{left,width,top,height,duration:animate ? .72 : 0,ease:'power3.inOut',overwrite:true});
          });
          phases.forEach((phase,index)=>phase.classList.toggle('is-active',active === null ? index===0 : index===active));
          if (edition) edition.textContent=`0${(active ?? 0)+1} / 03`;
        };

        const collapsed = mobile
          ? [{left:'24vw',top:'35vh',width:'68vw',height:'54vh'},{left:'93vw',top:'38vh',width:'4vw',height:'48vh'},{left:'98vw',top:'41vh',width:'2vw',height:'42vh'}]
          : [{left:tablet?'48vw':'47vw',top:'12vh',width:tablet?'40vw':'42vw',height:'76vh'},{left:'89vw',top:'16vh',width:'5vw',height:'68vh'},{left:'95vw',top:'20vh',width:'4vw',height:'60vh'}];
        heroFolds.forEach((fold,index)=>gsap.set(fold,collapsed[index]));
        if (progress) gsap.set(progress,{width:0});
        if (copy) gsap.set(copy,{opacity:.55});
        const intro = gsap.timeline({defaults:{ease:'power3.inOut'}});
        heroFolds.forEach((fold,index)=>intro.to(fold,{left:restingLeft[index],top,width:restingWidth[index],height,duration:1.35},index*.08));
        intro.to(q('[data-hero-fold] img'),{scale:1.015,duration:1.2},0)
          .to(scan,{left:mobile?'100vw':'99vw',duration:1.4},0)
          .to(progress,{width:'100%',duration:1.35},0)
          .to(copy,{opacity:1,duration:.7,ease:'power3.out'},.4);

        heroFolds.forEach((fold,index)=>{
          fold.addEventListener('pointerenter',()=>setActive(index));
          fold.addEventListener('focus',()=>setActive(index));
          fold.addEventListener('click',()=>setActive(index));
          fold.addEventListener('pointerleave',()=>setActive(null));
          fold.addEventListener('blur',()=>setActive(null));
          fold.addEventListener('keydown',(event)=>{
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            setActive(index);
          });
        });
      }

      const story = q('[data-story-stage]')[0];
      const storyRange = q('[data-story-range]')[0] as HTMLInputElement;
      const fitPoints = q('[data-fit-point]');
      if (story && storyRange && fitPoints.length) {
        const storyNotes = JSON.parse(root.dataset.storyNotes || '[]');
        const storyValues = [24,50,82];
        const storyCount = q('[data-story-count]')[0];
        const storyNote = q('[data-story-note]')[0];
        let storyInteractionLock = 0;
        let currentStoryIndex = -1;
        const updateStory = (animate = true) => {
          const value = Number(storyRange.value);
          const index = Math.min(2,Math.floor(((value-12)/76)*3));
          currentStoryIndex = index;
          gsap.to(q('[data-story-reveal]'),{clipPath:`inset(0 ${100-value}% 0 0)`,duration:animate ? .55 : 0,ease:'power3.out',overwrite:true});
          gsap.to(q('[data-story-divider]'),{left:`${value}%`,duration:animate ? .55 : 0,ease:'power3.out',overwrite:true});
          fitPoints.forEach((point,pointIndex)=>{
            const active = pointIndex===index;
            point.classList.toggle('is-active',active);
            point.setAttribute('aria-pressed',String(active));
          });
          if (storyCount) storyCount.textContent=String(index+1).padStart(2,'0');
          if (storyNote) storyNote.textContent=storyNotes[index];
        };
        const setStory = (index:number, lock = false) => {
          if (lock) storyInteractionLock = Date.now()+1400;
          storyRange.value=String(storyValues[index]);
          updateStory();
        };
        fitPoints.forEach((point,index)=>{
          point.addEventListener('click',()=>setStory(index,true));
          point.addEventListener('focus',()=>setStory(index,true));
          point.addEventListener('keydown',(event)=>{
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            setStory(index,true);
          });
        });
        storyRange.addEventListener('input',()=>{
          storyInteractionLock=Date.now()+900;
          updateStory(false);
        });
        ScrollTrigger.create({
          trigger:story,
          start:'top top',
          end:'bottom 45%',
          onUpdate:(self)=>{
            if (Date.now()<storyInteractionLock || document.activeElement===storyRange) return;
            const nextIndex=Math.min(2,Math.floor(Math.min(.999,self.progress)*3));
            if (nextIndex!==currentStoryIndex) setStory(nextIndex);
          }
        });
        updateStory(false);
      }

      const expectation = q('[data-expectation]')[0];
      if (expectation) {
        const lines = q('[data-expect-line]');
        const expectCopy = q('[data-expect-copy]');
        const metrics = q('.expectation__metrics article');
        gsap.set([...lines,...expectCopy,...metrics],{opacity:.18,y:34});
        revealOnce(expectation,()=>gsap.timeline({defaults:{ease:'power3.out'}})
          .to(lines,{opacity:1,y:0,duration:.75,stagger:.12})
          .to(expectCopy,{opacity:1,y:0,duration:.7},'-=.42')
          .to(metrics,{opacity:1,y:0,duration:.65,stagger:.09},'-=.36'));
      }

      const result = q('[data-result-story]')[0];
      if (result) {
        const resultPanels = q('[data-result-panel]') as HTMLButtonElement[];
        const resultImage = q('[data-result-visual] img')[0];
        const resultBeam = q('[data-result-beam]')[0];
        const resultIndex = q('[data-result-index]')[0];
        const resultCaption = q('[data-result-caption]')[0];
        const resultLabels = JSON.parse(root.dataset.resultLabels || '[]');
        const activateResult = (index:number) => {
          resultPanels.forEach((panel,panelIndex)=>{
            const active=panelIndex===index;
            panel.classList.toggle('is-active',active);
            panel.setAttribute('aria-pressed',String(active));
          });
          if (resultIndex) resultIndex.textContent=`0${index+1} / 03`;
          if (resultCaption) resultCaption.textContent=resultLabels[index];
          gsap.to(resultImage,{xPercent:[0,-2,-4][index],scale:[1.035,1.07,1.045][index],duration:.85,ease:'power3.inOut',overwrite:true});
          gsap.to(resultBeam,{left:['12%','45%','72%'][index],width:['18%','11%','19%'][index],duration:.85,ease:'power3.inOut',overwrite:true});
        };
        resultPanels.forEach((panel,index)=>{
          panel.addEventListener('pointerenter',()=>activateResult(index));
          panel.addEventListener('focus',()=>activateResult(index));
          panel.addEventListener('click',()=>activateResult(index));
        });
        const resultIntro = [q('.result-evidence__head > *'),q('.result-evidence__stage'),q('.result-evidence__foot')].flat();
        gsap.set(resultIntro,{opacity:0,y:32});
        revealOnce(result,()=>gsap.timeline({defaults:{ease:'power3.out'}})
          .to(resultIntro,{opacity:1,y:0,duration:.8,stagger:.08})
          .fromTo(resultImage,{scale:1.1},{scale:1.035,duration:1.15},0));
        activateResult(0);
      }

      const proof = q('[data-proof]')[0];
      if (proof) {
        gsap.set(q('[data-proof-quote] p'),{scale:.86,y:46,opacity:.22});
        gsap.set(q('.proof-score,.proof-tags span'),{y:28,opacity:0});
        revealOnce(proof,()=>gsap.timeline({defaults:{ease:'power3.out'}})
          .to(q('[data-proof-quote] p'),{scale:1,y:0,opacity:1,duration:.9})
          .to(q('.proof-score'),{y:0,opacity:1,duration:.65},'-=.6')
          .to(q('.proof-tags span'),{y:0,opacity:1,duration:.55,stagger:.08},'-=.35'));
      }

      const related = q('[data-related-stage]')[0];
      const relatedLinks = q('[data-related-link]');
      if (related && relatedLinks.length) {
        gsap.set(relatedLinks,{opacity:.25,y:18});
        gsap.set(q('[data-route-line]'),{scaleY:0});
        revealOnce(related,()=>gsap.timeline({defaults:{ease:'power3.out'}})
          .to(q('[data-route-line]'),{scaleY:1,duration:.65})
          .to(relatedLinks,{opacity:1,y:0,duration:.6,stagger:.06},'-=.35'));
      }

      mm.add('(min-width: 721px)', () => {
        const pricing = q('[data-pricing-stage]')[0];
        const pricingTrack = q('[data-pricing-track]')[0] as HTMLElement;
        if (pricing && pricingTrack) {
          const pricingDistance = () => Math.max(0, pricingTrack.scrollWidth - innerWidth + innerWidth * .12);
          gsap.to(pricingTrack,{x:()=>-pricingDistance(),ease:'none',scrollTrigger:{trigger:pricing,start:'top top',end:'bottom bottom',scrub:1.1,invalidateOnRefresh:true}});
          gsap.to(q('.pricing-progress i'),{width:'100%',ease:'none',scrollTrigger:{trigger:pricing,start:'top top',end:'bottom bottom',scrub:true}});
        }

        const process = q('[data-process]')[0];
        const track = q('[data-process-track]')[0] as HTMLElement;
        if (process && track) {
          const distance = () => Math.max(0, track.scrollWidth - innerWidth + innerWidth * .1);
          gsap.to(track,{x:()=>-distance(),ease:'none',scrollTrigger:{trigger:process,start:'top top',end:'bottom bottom',scrub:1.15,invalidateOnRefresh:true}});
          gsap.to(q('.process-progress i'),{width:'100%',ease:'none',scrollTrigger:{trigger:process,start:'top top',end:'bottom bottom',scrub:true}});
        }
      });

      mm.add('(max-width: 720px)', () => {
        q('[data-process],[data-pricing-stage]').forEach((section)=>{
          revealOnce(section,()=>gsap.fromTo(section.querySelectorAll('h2,.treatment-kicker,article'),{y:24,opacity:0},{y:0,opacity:1,duration:.72,stagger:.05,ease:'power3.out'}));
        });
      });

      const routeCurrent = q('[data-route-current]')[0];
      q('[data-route-label]').forEach((link)=>{
        const label = link.getAttribute('data-route-label');
        const show = () => { if (routeCurrent && label) routeCurrent.textContent = label; };
        const reset = () => { if (routeCurrent) routeCurrent.textContent = root.dataset.routeName || 'Professional whitening'; };
        link.addEventListener('mouseenter',show);
        link.addEventListener('focus',show);
        link.addEventListener('mouseleave',reset);
        link.addEventListener('blur',reset);
      });
      q('[data-reveal]').forEach((section) => gsap.from(section.querySelectorAll('h2,.treatment-kicker'),{y:36,opacity:0,duration:1,stagger:.08,ease:'power3.out',scrollTrigger:{trigger:section,start:'top 80%',once:true}}));
    });
    ScrollTrigger.refresh();
  };
  document.addEventListener('astro:page-load', bootTreatment);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootTreatment, {once:true}); else bootTreatment();
</script>
