  .story-diagnostic__divider{position:absolute;z-index:3;left:28%;top:0;bottom:0;width:1px;background:var(--mint-300);will-change:left}
  .story-diagnostic__divider i{position:absolute;left:50%;top:50%;width:2.4rem;height:2.4rem;border-radius:50%;border:1px solid var(--mint-300);background:rgba(6,29,25,.75);backdrop-filter:blur(8px);transform:translate(-50%,-50%)}
