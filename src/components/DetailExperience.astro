  @media (prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important}.detail-hero__frame img{transform:none!important}}
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const bootDetails = () => {
    document.querySelectorAll<HTMLElement>('[data-detail-root]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;
      const q = gsap.utils.selector(root);
      const mm = gsap.matchMedia();

      mm.add('(min-width: 721px)', () => {
        const hero = q('[data-detail-hero]')[0];
        const visual = q('[data-hero-visual]')[0];
        const frame = q('[data-hero-visual] img')[0];
        const copy = q('.detail-hero__copy')[0];
        if (hero && visual && frame && copy) {
          const compact = innerWidth <= 1100;
          const stageWidth = compact ? '57vw' : '62vw';
          const tl = gsap.timeline({scrollTrigger:{trigger:hero,start:'top top',end:'bottom bottom',scrub:1.15}});
          if (root.dataset.detailKind === 'cosmetic') {
            tl.to(visual,{width:stageWidth,height:compact?'78vh':'86vh',right:compact?'.8rem':'1vw',top:compact?'11vh':'7vh',ease:'none'},0)
              .to(q('.cosmetic-triptych__panels'),{gridTemplateColumns:'.58fr 1.58fr .62fr',gap:'.3rem',ease:'none'},0)
              .to(q('.cosmetic-slice'),{borderRadius:'3.5rem 3.5rem .75rem .75rem',ease:'none'},0)
              .to(q('.cosmetic-slice img'),{scale:1.02,ease:'none'},0)
              .to(q('.slice-a'),{yPercent:-7,ease:'none'},0)
              .to(q('.slice-b'),{yPercent:3,ease:'none'},0)
              .to(q('.slice-c'),{yPercent:-4,ease:'none'},0)
              .to(copy,{yPercent:-3,opacity:1,ease:'none'},0)
              .to(q('.detail-hero__outline'),{scale:1.035,rotation:.35,ease:'none'},0)
              .to(q('.detail-hero__watermark'),{xPercent:-9,yPercent:-5,ease:'none'},0)
              .to(q('.cosmetic-triptych__caption, .detail-hero__index'),{opacity:.72,ease:'none'},0);
          } else {
            tl.to(frame,{scale:1.02,xPercent:2,ease:'none'},0)
              .to(copy,{yPercent:-4,opacity:1,ease:'none'},0)
              .to(q('.hero-aperture i'),{height:'1.5vh',ease:'none'},0)
              .to(q('.detail-hero__outline'),{scale:1.012,ease:'none'},0)
              .to(q('.hero-address'),{xPercent:-5,yPercent:-8,ease:'none'},0)
              .to(q('.detail-hero__index'),{opacity:.8,ease:'none'},0);
          }
        }
        const atlas = q('[data-atlas]')[0];
        if (atlas) {
          const lanes = q('[data-care-lane]');
          gsap.timeline({scrollTrigger:{trigger:atlas,start:'top top',end:'bottom bottom',scrub:1.15}})
            .fromTo(q('[data-care-total]'),{yPercent:18,opacity:.28},{yPercent:0,opacity:1,ease:'none'},0)
            .fromTo(lanes,{xPercent:(i:number)=>i % 2 ? 5 : -5,opacity:.18},{xPercent:0,opacity:1,stagger:.08,ease:'none'},0)
            .to(q('[data-care-lane] i b'),{scaleX:1,stagger:.08,ease:'none'},0)
            .to(q('[data-care-progress]'),{scaleX:1,ease:'none'},0);
        }
        const journey = q('[data-journey]')[0];
        const track = q('.journey__track')[0] as HTMLElement;
        if (journey && track) {
          const distance = () => Math.max(0, track.scrollWidth - window.innerWidth + window.innerWidth * .1);
          gsap.to(track,{x:()=>-distance(),ease:'none',scrollTrigger:{trigger:journey,start:'top top',end:'bottom bottom',scrub:1.2,invalidateOnRefresh:true}});
          gsap.to(q('.journey__progress i'),{width:'100%',ease:'none',scrollTrigger:{trigger:journey,start:'top top',end:'bottom bottom',scrub:true}});
        }
        const trust = q('[data-trust-story]')[0];
        if (trust) gsap.to(q('[data-trust-image] img'),{yPercent:7,scale:1,ease:'none',scrollTrigger:{trigger:trust,start:'top bottom',end:'bottom top',scrub:1}});
      });

      mm.add('(max-width: 720px)', () => {
        const hero = q('[data-detail-hero]')[0];
        const visual = q('[data-hero-visual]')[0];
        if (hero && visual) {
          const mobileTl = gsap.timeline({scrollTrigger:{trigger:hero,start:'top top',end:'bottom bottom',scrub:1.05}})
            .to(q('[data-hero-visual] img'),{scale:1.02,ease:'none'},0)
            .to(q('.detail-hero__outline'),{scale:1.02,ease:'none'},0);
          if (root.dataset.detailKind === 'cosmetic') {
            mobileTl.to(visual,{height:'52svh',left:'.5rem',right:'.5rem',bottom:'.5rem',ease:'none'},0)
              .to(q('.detail-hero__watermark'),{xPercent:-12,yPercent:-4,ease:'none'},0)
              .to(q('.cosmetic-triptych__panels'),{gridTemplateColumns:'.6fr 1.5fr .62fr',gap:'.2rem',ease:'none'},0)
              .to(q('.slice-a'),{yPercent:-4,ease:'none'},0)
              .to(q('.slice-b'),{yPercent:2,ease:'none'},0)
              .to(q('.slice-c'),{yPercent:-3,ease:'none'},0);
          } else {
            mobileTl.to(q('.hero-aperture i'),{height:'.75rem',ease:'none'},0)
              .to(q('.hero-address'),{yPercent:-8,ease:'none'},0);
          }
        }
        const atlas = q('[data-atlas]')[0];
        if (atlas) {
          gsap.from(q('[data-care-lane]'),{x:26,opacity:0,duration:.8,stagger:.08,ease:'power3.out',scrollTrigger:{trigger:atlas,start:'top 72%',once:true}});
          gsap.to(q('[data-care-lane] i b, [data-care-progress]'),{scaleX:1,duration:1,stagger:.07,ease:'power2.out',scrollTrigger:{trigger:atlas,start:'top 65%',once:true}});
        }
      });

      q('[data-reveal-section]').forEach((section) => {
        gsap.from(section.querySelectorAll('h2, .detail-kicker'),{y:38,opacity:0,duration:1,stagger:.08,ease:'power3.out',scrollTrigger:{trigger:section,start:'top 78%',once:true}});
      });
      const rail = q('[data-schedule-rail]')[0];
      if (rail) gsap.to(rail.querySelector('i'),{width:'100%',height:'100%',ease:'none',scrollTrigger:{trigger:rail,start:'top 80%',end:'bottom 35%',scrub:true}});
      const proof = q('[data-proof]')[0];
      if (proof) gsap.from(q('[data-proof-quote]'),{y:60,opacity:0,duration:1.2,ease:'power3.out',scrollTrigger:{trigger:proof,start:'top 65%',once:true}});
      const imageReveal = q('[data-image-reveal]')[0];
      if (imageReveal) {
        gsap.from(q('.about-cosmetic__image.main-image'),{clipPath:'inset(100% 0 0 0)',duration:1.25,ease:'power3.inOut',scrollTrigger:{trigger:imageReveal,start:'top 70%',once:true}});
        gsap.from(q('.about-cosmetic__image.detail-image'),{y:70,opacity:0,duration:1,ease:'power3.out',delay:.15,scrollTrigger:{trigger:imageReveal,start:'top 62%',once:true}});
      }

      root.querySelectorAll<HTMLDetailsElement>('[data-option]').forEach((item) => item.addEventListener('toggle', () => {
        if (!item.open) return;
        root.querySelectorAll<HTMLDetailsElement>('[data-option]').forEach((other) => { if (other !== item) other.open = false; });
      }));
    });
    ScrollTrigger.refresh();
  };
  document.addEventListener('astro:page-load', bootDetails);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootDetails, {once:true}); else bootDetails();
</script>
