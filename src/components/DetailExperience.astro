<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const bootDetails = () => {
    document.querySelectorAll<HTMLElement>('[data-detail-root]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;
      const q = gsap.utils.selector(root);
      const mm = gsap.matchMedia();

      mm.add('(min-width: 721px)', () => {
        const hero = q('[data-detail-hero]')[0];
        const visual = q('[data-hero-visual]')[0];
        const frame = q('[data-hero-visual] img')[0];
        const copy = q('.detail-hero__copy')[0];
        if (hero && visual && frame && copy) {
          const compact = innerWidth <= 1100;
          const stageWidth = compact ? '57vw' : '62vw';
          const tl = ['orthodontic-dentistry', 'pediatric-developmental', 'periodontal-dentistry', 'preventive-diagnostic'].includes(root.dataset.detailKind || '')
            ? gsap.timeline()
            : gsap.timeline({scrollTrigger:{trigger:hero,start:'top top',end:'bottom bottom',scrub:1.15}});
          if (root.dataset.detailKind === 'preventive-diagnostic') {
            tl.fromTo(visual,{clipPath:'inset(0 45% 0 45% round 1.25rem 12rem 1.25rem 12rem)'},{clipPath:'inset(0 0% 0 0% round 1.25rem 12rem 1.25rem 12rem)',duration:1.3,ease:'power3.inOut'},0)
              .fromTo(q('.preventive-window__stage img'),{scale:1.13},{scale:1.045,duration:1.5,ease:'power3.out'},0)
              .fromTo(q('.detail-hero__copy > *'),{y:28,opacity:0},{y:0,opacity:1,duration:.9,stagger:.08,ease:'power3.out'},.15)
              .fromTo(q('.preventive-window__note'),{y:18,opacity:0},{y:0,opacity:1,duration:.75,ease:'power3.out'},.7);
            gsap.to(q('.preventive-window__stage img'),{yPercent:4,scale:1.07,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
          } else if (root.dataset.detailKind === 'periodontal-dentistry') {
            tl.fromTo(q('.gum-story__stage img'),{scale:1.13},{scale:1.045,duration:1.55,ease:'power3.out'},0)
              .fromTo(q('.gum-story__veil'),{opacity:.3},{opacity:1,duration:1.1,ease:'power2.out'},0)
              .fromTo(q('.detail-hero__copy > *'),{y:30,opacity:0},{y:0,opacity:1,duration:.9,stagger:.09,ease:'power3.out'},.12)
              .fromTo(q('.gum-story__note'),{x:24,opacity:0},{x:0,opacity:1,duration:.8,ease:'power3.out'},.72);
            gsap.to(q('.gum-story__stage img'),{yPercent:4,scale:1.07,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
          } else if (root.dataset.detailKind === 'pediatric-developmental') {
            tl.fromTo(visual,{clipPath:'inset(0 47% 0 47% round 14rem 14rem .8rem .8rem)'},{clipPath:'inset(0 0% 0 0% round 14rem 14rem .8rem .8rem)',duration:1.35,ease:'power3.inOut'},0)
              .fromTo(q('.growing-story__image img'),{scale:1.13},{scale:1.045,duration:1.5,ease:'power3.out'},0)
              .fromTo(q('.detail-hero__copy'),{y:54,opacity:0},{y:0,opacity:1,duration:1.05,ease:'power3.out'},.16)
              .fromTo(q('.detail-hero__copy > *'),{y:18,opacity:0},{y:0,opacity:1,duration:.8,stagger:.07,ease:'power3.out'},.32)
              .fromTo(q('.growing-story__caption'),{x:24,opacity:0},{x:0,opacity:1,duration:.8,ease:'power3.out'},.75);
            gsap.to(q('.growing-story__image img'),{yPercent:4,scale:1.075,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
          } else if (root.dataset.detailKind === 'orthodontic-dentistry') {
            tl.fromTo(visual,{clipPath:'polygon(48% 0,100% 0,100% 100%,28% 100%)'},{clipPath:compact?'polygon(25% 0,100% 0,100% 100%,0 100%)':'polygon(22% 0,100% 0,100% 100%,0 100%)',duration:1.35,ease:'power3.out'},0)
              .fromTo(q('.aligner-reveal__panorama img'),{scale:1.14,xPercent:4},{scale:1.055,xPercent:0,duration:1.6,ease:'power3.out'},0)
              .fromTo(q('.detail-hero__copy > *'),{y:28,opacity:0},{y:0,opacity:1,duration:.9,stagger:.09,ease:'power3.out'},.15)
              .fromTo(q('.aligner-reveal__note'),{x:24,opacity:0},{x:0,opacity:1,duration:.8,ease:'power3.out'},.75);
            gsap.to(q('.aligner-reveal__panorama img'),{yPercent:5,scale:1.08,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
            gsap.to(copy,{yPercent:-5,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
          } else if (root.dataset.detailKind === 'implants-oral-surgery') {
            tl.to(visual,{width:stageWidth,height:compact?'78vh':'86vh',right:compact?'.8rem':'1vw',top:compact?'11vh':'7vh',ease:'none'},0)
              .to(q('.implant-stage__main'),{width:'92%',height:'86%',borderRadius:'.8rem 3.5rem .8rem 2rem',ease:'none'},0)
              .to(q('.implant-stage__main img'),{scale:1.01,xPercent:-2,ease:'none'},0)
              .to(q('.implant-stage__depth'),{width:'46%',height:'43%',xPercent:8,yPercent:-3,ease:'none'},0)
              .to(q('.implant-stage__depth img'),{scale:1.1,xPercent:4,ease:'none'},0)
              .to(copy,{yPercent:-3,opacity:1,ease:'none'},0)
              .to(q('.detail-hero__watermark'),{xPercent:-8,yPercent:-4,ease:'none'},0);
          } else if (root.dataset.detailKind === 'emergency-comfort') {
            tl.to(visual,{width:stageWidth,height:compact?'78vh':'86vh',right:compact?'.8rem':'1vw',top:compact?'11vh':'7vh',ease:'none'},0)
              .to(q('.comfort-relief__main'),{borderRadius:'1.2rem',ease:'none'},0)
              .to(q('.comfort-relief__main img'),{scale:1.01,xPercent:-2,ease:'none'},0)
