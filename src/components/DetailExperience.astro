<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const bootDetails = () => {
    document.querySelectorAll<HTMLElement>('[data-detail-root]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;
      const q = gsap.utils.selector(root);
      const mm = gsap.matchMedia();

      mm.add('(min-width: 721px)', () => {
        const hero = q('[data-detail-hero]')[0];
        const visual = q('[data-hero-visual]')[0];
        const frame = q('[data-hero-visual] img')[0];
        const copy = q('.detail-hero__copy')[0];
        if (hero && visual && frame && copy) {
          const compact = innerWidth <= 1100;
          const stageWidth = compact ? '57vw' : '62vw';
          const tl = ['orthodontic-dentistry', 'pediatric-developmental', 'periodontal-dentistry', 'preventive-diagnostic', 'recode-cognitive-health', 'restorative-reconstructive', 'wellness-offering'].includes(root.dataset.detailKind || '')
            ? gsap.timeline()
            : gsap.timeline({scrollTrigger:{trigger:hero,start:'top top',end:'bottom bottom',scrub:1.15}});
          if (root.dataset.detailKind === 'wellness-offering') {
            tl.fromTo(q('.wellness-portrait__stage'),{clipPath:'inset(0 0 0 65% round 50% 0 0 50%)'},{clipPath:'inset(0 0 0 0% round 50% 0 0 50%)',duration:1.35,ease:'power3.inOut'},0)
              .fromTo(q('.wellness-portrait__stage img'),{scale:1.14},{scale:1.045,duration:1.55,ease:'power3.out'},0)
              .fromTo(q('.detail-hero__copy > *'),{y:28,opacity:0},{y:0,opacity:1,duration:.9,stagger:.08,ease:'power3.out'},.16);
            gsap.to(q('.wellness-portrait__stage img'),{yPercent:4,scale:1.07,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
          } else if (root.dataset.detailKind === 'restorative-reconstructive') {
            tl.fromTo(q('.restorative-composition__main'),{clipPath:'inset(0 46% 0 46% round 1rem 11rem 1rem 1rem)'},{clipPath:'inset(0 0% 0 0% round 1rem 11rem 1rem 1rem)',duration:1.35,ease:'power3.inOut'},0)
              .fromTo(q('.restorative-composition__main img'),{scale:1.14},{scale:1.045,duration:1.55,ease:'power3.out'},0)
              .fromTo(q('.restorative-composition__detail'),{y:38,scale:.82,opacity:0},{y:0,scale:1,opacity:1,duration:1,ease:'power3.out'},.38)
              .fromTo(q('.detail-hero__copy > *'),{y:28,opacity:0},{y:0,opacity:1,duration:.9,stagger:.08,ease:'power3.out'},.14);
            gsap.to(q('.restorative-composition__main img'),{yPercent:4,scale:1.07,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
            gsap.to(q('.restorative-composition__detail img'),{yPercent:-3,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
          } else if (root.dataset.detailKind === 'recode-cognitive-health') {
            tl.fromTo(q('.recode-focus__panorama'),{clipPath:'inset(0 48% 0 48% round 10rem 1.2rem 1.2rem 1.2rem)'},{clipPath:'inset(0 0% 0 0% round 10rem 1.2rem 1.2rem 1.2rem)',duration:1.35,ease:'power3.inOut'},0)
              .fromTo(q('.recode-focus__panorama img'),{scale:1.14},{scale:1.045,duration:1.55,ease:'power3.out'},0)
              .fromTo(q('.recode-focus__portrait'),{scale:.72,x:-36,opacity:0},{scale:1,x:0,opacity:1,duration:1,ease:'power3.out'},.42)
              .fromTo(q('.detail-hero__copy > *'),{y:28,opacity:0},{y:0,opacity:1,duration:.9,stagger:.08,ease:'power3.out'},.14)
              .fromTo(q('.recode-focus__note'),{y:18,opacity:0},{y:0,opacity:1,duration:.75,ease:'power3.out'},.75);
            gsap.to(q('.recode-focus__panorama img'),{yPercent:4,scale:1.07,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
            gsap.to(q('.recode-focus__portrait img'),{yPercent:-3,ease:'none',scrollTrigger:{trigger:hero,start:'top top',end:'bottom top',scrub:.8}});
