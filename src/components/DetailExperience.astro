      </div>
      <div class="pricing__table" role="table" aria-label={`${location.name} general dentistry pricing`}>
        <div class="pricing__row pricing__labels" role="row"><span>Service</span><span>Fixed</span><span>Monthly</span><span>Yearly</span></div>
        {chicagoPricing.map((service) => (
          <div class="pricing__row" role="row"><strong>{service.name}</strong><span>{service.fixed}</span><span>{service.monthly}</span><span>{service.yearly}</span></div>
        ))}
      </div>
      <p class="pricing__note">Monthly examples show the stated amount divided across the listed term. Eligibility, final treatment scope and payment terms are confirmed by the office.</p>
    </section>
  )}

  {locationPage && (
    <section class="related-paths section-shell" id="related-care" data-reveal-section>
      <header class="related-paths__head">
        <p class="detail-kicker"><span></span>07 · KEEP EXPLORING</p>
        <h2>Related care.<br /><em>Connected places.</em></h2>
        <p>Move from this office to the service or location detail you need next—without losing the wider care story.</p>
      </header>
      <div class="related-paths__grid">
        <article>
          <div class="related-paths__label"><span>01</span><strong>Related services</strong></div>
          <nav aria-label="Related services">
            {relatedServiceLinks.map((service) => (
              <a href={service.href}><span>{service.name}</span><small>{service.detail}</small><b aria-hidden="true">↗</b></a>
            ))}
          </nav>
        </article>
        <article>
          <div class="related-paths__label"><span>02</span><strong>Related service areas</strong></div>
          <nav aria-label="Related service areas">
            {relatedAreaLinks.map((area) => (
              <a href={area.href}><span>{area.name}</span><small>{area.detail}</small><b aria-hidden="true">↗</b></a>
            ))}
          </nav>
        </article>
      </div>
    </section>
  )}

  {!locationPage && (
    <section class="pricing section-shell" id={`${category.slug}-pricing`} data-reveal-section>
      <div class="pricing__head">
        <p class="detail-kicker"><span></span>{category.pricingKicker}</p>
        <h2>{category.pricingLead}<br /><em>{category.pricingEmphasis}</em></h2>
        <p>{category.pricingIntro}</p>
      </div>
      <div class="pricing__table" role="table" aria-label={`${category.heroKicker} pricing`}>
        <div class="pricing__row pricing__labels" role="row"><span>Service</span><span>Fixed</span><span>Monthly</span><span>Yearly</span></div>
        {category.services.map((service) => (
          <div class="pricing__row" role="row"><strong>{service.name}</strong><span>{service.fixed}</span><span>{service.monthly}</span><span>{service.yearly}</span></div>
        ))}
      </div>
      <p class="pricing__note">{category.pricingNote}</p>
    </section>
  )}

  <section class="patient-proof" data-proof>
    <div class="patient-proof__top">
      <div><p class="detail-kicker light"><span></span>{locationPage ? location.reviewKicker : category.proofKicker}</p><h2 class="proof-heading">Real patients.<br /><em>Real perspective.</em></h2></div>
      <div class="proof-score"><strong>{locationPage ? location.reviewScore : '4.9'}</strong><span>Google rating<br />{locationPage ? location.name : 'Chicago Heights'}</span></div>
    </div>
    <div class="patient-proof__stage">
      <blockquote data-proof-quote>
        <p>{locationPage ? location.reviewQuote : category.proofQuote}</p>
        <footer>{locationPage ? location.reviewFooter : category.proofFooter}</footer>
      </blockquote>
      <div class="proof-topics">
        {(locationPage ? location.reviewTopics : category.proofTopics).map((topic) => <span>{topic}</span>)}
      </div>
    </div>
    <p class="proof-total">{locationPage ? location.reviewTotal : category.proofTotal}<small>{locationPage ? 'total Google reviews' : category.proofTotalLabel}</small></p>
  </section>

  <section class="detail-faq section-shell" data-reveal-section>
    <div class="detail-faq__head"><p class="detail-kicker"><span></span>{locationPage ? '09 · GOOD QUESTIONS' : category.faqKicker}</p><h2>Before you<br /><em>begin.</em></h2></div>
