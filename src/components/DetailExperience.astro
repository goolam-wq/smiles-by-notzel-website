  ['Can cosmetic work be financed monthly?', 'Monthly examples are included for each service. Final terms and eligibility are confirmed with the office.'],
];
const faqs = chicago ? chicagoFaq : category.faqs;
---

<div class:list={['detail-page', chicago ? 'is-chicago' : completeHealth ? 'is-complete-health' : emergencyComfort ? 'is-emergency-comfort' : implantsSurgery ? 'is-implants-surgery' : orthodontic ? 'is-orthodontic' : pediatric ? 'is-pediatric' : periodontal ? 'is-periodontal' : preventive ? 'is-preventive' : 'is-cosmetic']} data-detail-root data-detail-kind={kind}>
  <section class="detail-hero" data-detail-hero data-areas-hero={chicago ? '' : undefined} data-services-hero={!chicago ? '' : undefined}>
    <div class="detail-hero__sticky">
      <div class="detail-hero__grid" aria-hidden="true"></div>
      <div class="detail-hero__watermark" aria-hidden="true"><span>{chicago ? 'CHICAGO' : category.watermark[0]}</span><em>{chicago ? 'HEIGHTS' : category.watermark[1]}</em></div>
      <div class="detail-hero__copy">
        <p class="detail-kicker"><span></span>{chicago ? 'Chicago Heights · Office 01' : category.heroKicker}</p>
        {chicago ? (
          <h1>Care that keeps<br /><em>pace with life.</em></h1>
        ) : (
          <h1><span>{category.heroLead}</span><br /><em>{category.heroEmphasis}</em></h1>
        )}
        <p class="detail-hero__intro">{chicago ? 'Extended weekday hours, complete-health thinking and one connected team—right here on Ashland Avenue.' : category.heroIntro}</p>
        <a class="detail-button" href={chicago ? 'tel:+17087551333' : `#${category.slug}-options`}>
          <span>{chicago ? 'Call Chicago Heights' : category.heroButton}</span><b aria-hidden="true">↓</b>
        </a>
      </div>

      <div class:list={['detail-hero__visual', !chicago && !completeHealth && !emergencyComfort && !implantsSurgery && !orthodontic && !pediatric && !periodontal && !preventive && 'cosmetic-triptych', completeHealth && 'health-scan', emergencyComfort && 'comfort-relief', implantsSurgery && 'implant-stage', orthodontic && 'aligner-reveal', pediatric && 'growing-story', periodontal && 'gum-story', preventive && 'preventive-window']} data-hero-visual>
        {!completeHealth && !emergencyComfort && !implantsSurgery && !orthodontic && !pediatric && !periodontal && !preventive && <div class="detail-hero__outline" aria-hidden="true"><span>{chicago ? 'OFFICE 01' : category.heroOutline}</span></div>}
        {chicago ? (
          <>
            <div class="detail-hero__frame">
              <img src="/images/generated/chicago-heights-arrival-v1.webp" alt="A patient being welcomed at a calm dental reception desk" width="1536" height="1024" loading="eager" fetchpriority="high" />
            </div>
            <div class="hero-aperture" aria-hidden="true"><i></i><i></i></div>
          </>
        ) : preventive ? (
          <div class="preventive-window__stage">
            <img src={category.heroImage} alt={category.heroAlt} width="1536" height="1024" loading="eager" fetchpriority="high" />
            <div class="preventive-window__wash" aria-hidden="true"></div>
            <div class="preventive-window__note"><span>BASELINE FIRST</span><strong>See sooner · protect longer</strong></div>
          </div>
        ) : periodontal ? (
          <div class="gum-story__stage">
            <img src={category.heroImage} alt={category.heroAlt} width="1536" height="1024" loading="eager" fetchpriority="high" />
            <div class="gum-story__veil" aria-hidden="true"></div>
            <div class="gum-story__note" aria-hidden="true"><span>MEASURED WITH CARE</span><strong>Foundation first</strong></div>
          </div>
        ) : pediatric ? (
          <div class="growing-story__stage">
            <div class="growing-story__image"><img src={category.heroImage} alt={category.heroAlt} width="1536" height="1024" loading="eager" fetchpriority="high" /></div>
            <div class="growing-story__caption" aria-hidden="true"><span>FIRST VISIT</span><i></i><span>GROWING SMILES</span></div>
          </div>
        ) : orthodontic ? (
          <div class="aligner-reveal__stage">
            <div class="aligner-reveal__panorama"><img src={category.heroImage} alt={category.heroAlt} width="1536" height="1024" loading="eager" fetchpriority="high" /></div>
            <div class="aligner-reveal__note"><span>ONE SEQUENCE</span><strong>Clear movement · real routine</strong></div>
          </div>
        ) : implantsSurgery ? (
          <div class="implant-stage__panels">
            <div class="implant-stage__main"><img src={category.heroImage} alt={category.heroAlt} width="1536" height="1024" loading="eager" fetchpriority="high" /></div>
            <div class="implant-stage__depth" aria-hidden="true"><img src={category.heroImage} alt="" width="1536" height="1024" loading="eager" /></div>
            <span>FOUNDATION TO FINISH</span>
          </div>
        ) : emergencyComfort ? (
          <div class="comfort-relief__stage">
            <div class="comfort-relief__main"><img src={category.heroImage} alt={category.heroAlt} width="1536" height="1024" loading="eager" fetchpriority="high" /></div>
            <div class="comfort-relief__echo" aria-hidden="true"><img src={category.heroImage} alt="" width="1536" height="1024" loading="eager" /></div>
          </div>
        ) : completeHealth ? (
          <div class="health-scan__panels">
            <div class="health-scan__main"><img src={category.heroImage} alt={category.heroAlt} width="1536" height="1024" loading="eager" fetchpriority="high" /></div>
            <div class="health-scan__rail" aria-hidden="true">
              <div class="health-scan__detail airway"><img src={category.heroImage} alt="" width="1536" height="1024" loading="eager" /></div>
              <div class="health-scan__detail system"><img src={category.heroImage} alt="" width="1536" height="1024" loading="eager" /></div>
            </div>
          </div>
        ) : (
          <div class="cosmetic-triptych__panels">
            <div class="cosmetic-slice slice-a"><img src={category.heroImage} alt={category.heroAlt} width="1536" height="1024" loading="eager" fetchpriority="high" /></div>
            <div class="cosmetic-slice slice-b" aria-hidden="true"><img src={category.heroImage} alt="" width="1536" height="1024" loading="eager" /></div>
            <div class="cosmetic-slice slice-c" aria-hidden="true"><img src={category.heroImage} alt="" width="1536" height="1024" loading="eager" /></div>
          </div>
        )}
        {chicago ? (
          <div class="hero-address"><span>500 Ashland Ave, Suite #2</span><span>Chicago Heights, IL</span></div>
        ) : completeHealth || emergencyComfort || implantsSurgery || orthodontic || pediatric || periodontal || preventive ? null : (
          <><div class="cosmetic-triptych__caption">{category.heroCaptions.map((caption) => <span>{caption}</span>)}</div><div class="hero-shade" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></>
        )}
      </div>

      <div class="detail-hero__index" aria-hidden="true"><span>SCROLL TO DISCOVER</span><i></i><b>01</b></div>
    </div>
  </section>

  <section class="detail-ledger" aria-label="Key details">
    {chicago ? (
      <>
        <div><small>OPEN</small><strong>Mon–Thu until 7 PM</strong></div>
        <div><small>COMMUNITIES</small><strong>16 connected</strong></div>
        <div><small>PATIENT PROOF</small><strong>4.9 from 258 reviews</strong></div>
        <div><small>CALL</small><strong>(708) 755-1333</strong></div>
      </>
    ) : (
      <>{category.ledger.map((item) => <div><small>{item[0]}</small><strong>{item[1]}</strong></div>)}</>
    )}
  </section>

  {chicago ? (
    <>
      <section class="editorial-story section-shell" data-reveal-section>
        <div class="editorial-story__eyebrow"><span>01</span><p>ABOUT CHICAGO HEIGHTS</p></div>
        <div class="editorial-story__headline">
          <h2>A neighborhood office<br />built for <em>real life.</em></h2>
        </div>
        <div class="editorial-story__body">
          <p>The Chicago Heights office connects extended hours, a familiar care team and complete-health thinking in one calm place. Care should fit the week you actually live.</p>
          <a href="https://maps.app.goo.gl/htHhNrnhbbu2WNR17" target="_blank" rel="noreferrer">Open in Google Maps ↗</a>
        </div>
        <div class="schedule-rail" data-schedule-rail>
          <div class="schedule-rail__line"><i></i></div>
          <article><b>01</b><span>MON — THU</span><strong>7:30 AM<br />— 7:00 PM</strong></article>
          <article><b>02</b><span>FRIDAY</span><strong>7:30 AM<br />— 12:00 PM</strong></article>
          <article><b>03</b><span>SATURDAY</span><strong>8:00 AM<br />— 12:00 PM</strong></article>
        </div>
      </section>

      <section class="care-atlas" id="connected-care" data-atlas>
        <div class="care-atlas__sticky">
          <div class="care-atlas__copy">
            <p class="detail-kicker light"><span></span>02 · ONE CONNECTED OFFICE</p>
            <h2>More of your care,<br /><em>under one roof.</em></h2>
            <p>From a preventive visit to a more complex plan, the same team can connect the details instead of treating each appointment like an isolated event.</p>
            <a href="/services/">View all services ↗</a>
          </div>
          <div class="care-spectrum" aria-label="Six connected care categories">
            <div class="care-spectrum__header">
              <span>THE CARE SPECTRUM</span>
              <strong data-care-total>48</strong>
              <small>CONNECTED SERVICES</small>
            </div>
            <div class="care-spectrum__lanes">
              {serviceGroups.map((group, i) => (
                <a class="care-spectrum__lane" href={group.href} data-care-lane aria-label={`Explore ${group.name}`}>
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  <strong>{group.name}</strong>
                  <small>{group.count} services</small>
                  <i aria-hidden="true"><b></b></i>
                </a>
              ))}
            </div>
            <div class="care-spectrum__footer">
              <span>ONE OFFICE</span><i aria-hidden="true"><b data-care-progress></b></i><span>ONE CONNECTED TEAM</span>
            </div>
          </div>
        </div>
      </section>

      <section class="communities section-shell" data-reveal-section>
        <div class="communities__head">
          <p class="detail-kicker"><span></span>03 · NEARBY BY DESIGN</p>
          <h2>One office.<br /><em>Sixteen communities.</em></h2>
          <p>The Chicago Heights team supports familiar neighborhoods across the south suburbs—so connected care stays close to home.</p>
        </div>
        <div class="community-list">
          {communities.map((community, i) => <div><span>{String(i + 1).padStart(2, '0')}</span><strong>{community}</strong><i></i></div>)}
        </div>
      </section>
    </>
  ) : (
    <>
      <section class="about-cosmetic section-shell" data-reveal-section data-image-reveal>
        <header class="about-cosmetic__head">
          <p class="detail-kicker"><span></span>{category.aboutKicker}</p>
          <h2>{category.aboutLead}<br /><em>{category.aboutEmphasis}</em></h2>
        </header>
        <div class="about-cosmetic__media">
          <div class="about-cosmetic__image main-image"><img src={category.aboutMainImage} alt={category.aboutMainAlt} width="1536" height="1024" loading="lazy" /></div>
          <div class="about-cosmetic__image detail-image"><img src={category.aboutDetailImage} alt={category.aboutDetailAlt} width="1536" height="1024" loading="lazy" /></div>
          <span aria-hidden="true">{category.aboutLabel}</span>
        </div>
        <div class="about-cosmetic__principles">
          <p>{category.aboutCopy}</p>
          {category.principles.map((principle) => <div><b>{principle[0]}</b><strong>{principle[1]}</strong><span>{principle[2]}</span></div>)}
        </div>
      </section>

      <section class="option-index" id={`${category.slug}-options`} data-option-index>
        <header>
          <p class="detail-kicker light"><span></span>{category.optionKicker}</p>
          <h2>{category.optionLead}<br /><em>{category.optionEmphasis}</em></h2>
          <p>{category.optionIntro}</p>
        </header>
        <div class="option-index__layout">
          <div class="option-index__visual">
            <img src={category.optionImage} alt={category.optionAlt} width="1536" height="1024" loading="lazy" />
            <span>{category.optionLabel}</span>
          </div>
          <div class="option-index__list">
            {category.services.map((service, i) => (
              <details open={i === 0} data-option>
                <summary><span>{service.n}</span><strong>{service.name}</strong><b>+</b></summary>
                <div class="option-body">
                  <p>{service.note}</p>
                  <div class="option-body__links">
                    <a href={`#${category.slug}-pricing`}>See pricing ↓</a>
                    <a href={`/services/${service.slug}/`} aria-label={`Learn more about ${service.name}`}>Learn more →</a>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <section class="journey" data-journey>
    <div class="journey__sticky">
      <header>
        <p class="detail-kicker"><span></span>{chicago ? '04 · THE COMPLETE-HEALTH PROCESS' : category.processKicker}</p>
        <h2>{chicago ? <>Care that becomes <em>clear.</em></> : <>{category.processLead} <em>{category.processEmphasis}</em></>}</h2>
      </header>
      <div class="journey__track">
        {(chicago ? [
          ['01', 'Listen', 'We begin with your concern, your health story and what you need from this visit.'],
          ['02', 'See', 'Exams, imaging and complete-health screening bring the full picture into focus.'],
          ['03', 'Plan', 'Options, timing and pricing are organized into a path you can understand.'],
          ['04', 'Connect', 'Treatment and follow-up stay coordinated with one familiar Chicago Heights team.'],
        ] : category.steps).map((step) => (
          <article data-journey-card>
            <span>{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p><i aria-hidden="true"></i>
          </article>
        ))}
      </div>
      <div class="journey__progress" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class:list={['trust-story', chicago ? 'trust-chicago' : 'trust-cosmetic']} data-trust-story data-reveal-section>
    <div class="trust-story__image" data-trust-image>
      <img src={chicago ? '/images/generated/unique/chicago-trust-local-family.webp' : category.trustImage} alt={chicago ? 'A local family speaking with the Chicago Heights care team' : category.trustAlt} width="1536" height="1024" loading="lazy" />
      <span>{chicago ? '500 ASHLAND AVE · CHICAGO HEIGHTS' : category.trustLabel}</span>
    </div>
    <div class="trust-story__content">
      <p class="detail-kicker light"><span></span>{chicago ? '05 · WHY CHOOSE THIS OFFICE' : category.trustKicker}</p>
      <h2>{chicago ? 'More than a convenient address.' : category.trustHeading}</h2>
      <p>{chicago ? 'The difference is not a single technology or appointment. It is the way access, experience and the wider health story work together.' : category.trustCopy}</p>
      <div class="trust-story__reasons">
        {(chicago ? [
          ['01', 'Hours that make room', 'Early mornings, evenings and Saturday availability.'],
          ['02', '48 connected services', 'Prevention, comfort, restoration and advanced care in one network.'],
          ['03', 'Complete-health thinking', 'The team looks beyond one tooth and one appointment.'],
          ['04', 'Patient-backed care', 'A 4.9 Google rating from 258 Chicago Heights reviews.'],
        ] : category.trustReasons).map((reason) => <article><b>{reason[0]}</b><strong>{reason[1]}</strong><p>{reason[2]}</p></article>)}
      </div>
    </div>
  </section>

  {chicago && (
    <section class="pricing pricing--chicago section-shell" id="chicago-pricing" data-reveal-section>
      <div class="pricing__head">
        <p class="detail-kicker"><span></span>06 · PRICING, MADE LEGIBLE</p>
        <h2>Everyday care.<br /><em>Three ways to plan.</em></h2>
        <p>Compare a focused set of common Chicago Heights services in fixed, monthly and yearly customer-facing views.</p>
      </div>
      <div class="pricing__table" role="table" aria-label="Chicago Heights general dentistry pricing">
        <div class="pricing__row pricing__labels" role="row"><span>Service</span><span>Fixed</span><span>Monthly</span><span>Yearly</span></div>
        {chicagoPricing.map((service) => (
          <div class="pricing__row" role="row"><strong>{service.name}</strong><span>{service.fixed}</span><span>{service.monthly}</span><span>{service.yearly}</span></div>
        ))}
      </div>
      <p class="pricing__note">Monthly examples show the stated amount divided across the listed term. Eligibility, final treatment scope and payment terms are confirmed by the office.</p>
    </section>
  )}

  {chicago && (
    <section class="related-paths section-shell" id="related-care" data-reveal-section>
      <header class="related-paths__head">
        <p class="detail-kicker"><span></span>07 · KEEP EXPLORING</p>
        <h2>Related care.<br /><em>Connected places.</em></h2>
        <p>Move from this office to the service or location detail you need next—without losing the wider care story.</p>
      </header>
      <div class="related-paths__grid">
        <article>
          <div class="related-paths__label"><span>01</span><strong>Related services</strong></div>
          <nav aria-label="Related services">
            {serviceGroups.map((group) => (
              <a href={group.href}><span>{group.name}</span><small>{group.count} services</small><b aria-hidden="true">↗</b></a>
            ))}
          </nav>
        </article>
        <article>
          <div class="related-paths__label"><span>02</span><strong>Related service areas</strong></div>
          <nav aria-label="Related service areas">
            {relatedAreaLinks.map((area) => (
              <a href={area.href}><span>{area.name}</span><small>{area.detail}</small><b aria-hidden="true">↗</b></a>
            ))}
          </nav>
        </article>
      </div>
    </section>
  )}

  {!chicago && (
    <section class="pricing section-shell" id={`${category.slug}-pricing`} data-reveal-section>
      <div class="pricing__head">
        <p class="detail-kicker"><span></span>{category.pricingKicker}</p>
        <h2>{category.pricingLead}<br /><em>{category.pricingEmphasis}</em></h2>
        <p>{category.pricingIntro}</p>
      </div>
      <div class="pricing__table" role="table" aria-label={`${category.heroKicker} pricing`}>
        <div class="pricing__row pricing__labels" role="row"><span>Service</span><span>Fixed</span><span>Monthly</span><span>Yearly</span></div>
        {category.services.map((service) => (
          <div class="pricing__row" role="row"><strong>{service.name}</strong><span>{service.fixed}</span><span>{service.monthly}</span><span>{service.yearly}</span></div>
        ))}
      </div>
      <p class="pricing__note">{category.pricingNote}</p>
    </section>
  )}

  <section class="patient-proof" data-proof>
    <div class="patient-proof__top">
      <div><p class="detail-kicker light"><span></span>{chicago ? '08 · CHICAGO HEIGHTS PATIENT REVIEWS' : category.proofKicker}</p><h2 class="proof-heading">Real patients.<br /><em>Real perspective.</em></h2></div>
      <div class="proof-score"><strong>4.9</strong><span>Google rating<br />Chicago Heights</span></div>
    </div>
    <div class="patient-proof__stage">
      <blockquote data-proof-quote>
        <p>{chicago ? '“The staff work together like a well-oiled machine—friendly, efficient and attentive without making the visit feel rushed.”' : category.proofQuote}</p>
        <footer>{chicago ? 'KEANNA BENSON · PATIENT REVIEW' : category.proofFooter}</footer>
      </blockquote>
      <div class="proof-topics">
        {(chicago ? ['Friendly staff · 76 mentions', 'Caring staff · 35 mentions', 'Clear explanations · 9 mentions'] : category.proofTopics).map((topic) => <span>{topic}</span>)}
      </div>
    </div>
    <p class="proof-total">{chicago ? '258' : category.proofTotal}<small>{chicago ? 'total Google reviews' : category.proofTotalLabel}</small></p>
  </section>

  <section class="detail-faq section-shell" data-reveal-section>
    <div class="detail-faq__head"><p class="detail-kicker"><span></span>{chicago ? '09 · GOOD QUESTIONS' : category.faqKicker}</p><h2>Before you<br /><em>begin.</em></h2></div>
    <div class="detail-faq__list">
      {faqs.map((faq, i) => (
        <details open={i === 0}>
          <summary><span>{String(i + 1).padStart(2, '0')}</span><strong>{faq[0]}</strong><b>+</b></summary>
          <p>{faq[1]}</p>
        </details>
      ))}
    </div>
  </section>
</div>

<style>
  :global(html){scroll-behavior:auto} :global(body){margin:0;background:var(--paper);color:var(--ink);overflow-x:hidden}.detail-page{--serif:"Cormorant Garamond",Georgia,serif;--sans:"Inter",Arial,sans-serif;background:var(--paper);font-family:var(--sans);overflow:clip}.section-shell{padding:clamp(6rem,10vw,10rem) clamp(1.25rem,6vw,7rem)}
