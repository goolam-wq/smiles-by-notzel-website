      {faqs.map((faq, i) => (
        <details open={i === 0}>
          <summary><span>{String(i + 1).padStart(2, '0')}</span><strong>{faq[0]}</strong><b>+</b></summary>
          <p>{faq[1]}</p>
        </details>
      ))}
    </div>
  </section>
</div>

