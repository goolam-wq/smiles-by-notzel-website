---
interface Props { kind: 'chicago' | 'cosmetic' }
const { kind } = Astro.props;
const chicago = kind === 'chicago';

const communities = ['Chicago Heights', 'South Chicago Heights', 'Steger', 'Sauk Village', 'Lynwood', 'Glenwood', 'Ford Heights', 'Olympia Fields', 'Park Forest', 'Homewood', 'Flossmoor', 'Hazel Crest', 'Matteson', 'Crete', 'Country Club Hills', 'Richton Park'];
const serviceGroups = [
  { name: 'Preventive care', count: 9 },
  { name: 'Cosmetic dentistry', count: 7 },
  { name: 'Restorative care', count: 10 },
  { name: 'Complete Health', count: 8 },
  { name: 'Emergency dentistry', count: 5 },
  { name: 'Kid-friendly dentistry', count: 9 },
];
const cosmeticServices = [
  { n: '01', slug: 'professional-teeth-whitening', name: 'Professional teeth whitening', note: 'A brighter result planned around your natural shade.', fixed: '$550', monthly: '$46 / mo · 12 mo', yearly: '$550 / yr' },
  { n: '02', slug: 'porcelain-veneers-laminates', name: 'Porcelain veneers & laminates', note: 'Shape, proportion and color refined tooth by tooth.', fixed: '$1,500 / tooth', monthly: '$63 / mo · 24 mo', yearly: '$1,500 / yr' },
  { n: '03', slug: 'lumineers', name: 'Lumineers', note: 'A minimally prepared veneer option for selected smiles.', fixed: '$1,600 / tooth', monthly: '$67 / mo · 24 mo', yearly: '$1,600 / yr' },
  { n: '04', slug: 'snap-on-smile', name: 'Snap-on Smile', note: 'A removable cosmetic option designed for a complete arch.', fixed: '$2,500 / arch', monthly: '$105 / mo · 24 mo', yearly: '$2,500 / yr' },
  { n: '05', slug: 'dental-bonding', name: 'Dental bonding', note: 'Conservative reshaping for chips, spacing and uneven edges.', fixed: '$450 / tooth', monthly: '$38 / mo · 12 mo', yearly: '$450 / yr' },
  { n: '06', slug: 'tooth-contouring', name: 'Tooth contouring', note: 'Small, precise adjustments that bring the smile into balance.', fixed: '$150 / tooth', monthly: '$13 / mo · 12 mo', yearly: '$150 / yr' },
  { n: '07', slug: 'complete-smile-makeover', name: 'Complete smile makeover', note: 'A coordinated plan combining the right treatments for you.', fixed: 'From $12,000', monthly: '$334 / mo · 36 mo', yearly: '$12,000 / yr' },
];
const chicagoPricing = [
  { name: 'Professional dental cleaning', fixed: '$125 / visit', monthly: '$21 / mo · 12 mo', yearly: '$250 / yr' },
  { name: 'Routine or comprehensive exam', fixed: '$125 / visit', monthly: '$11 / mo · 12 mo', yearly: '$125 / yr' },
  { name: 'Digital dental X-rays', fixed: '$150 / series', monthly: '$13 / mo · 12 mo', yearly: '$150 / yr' },
  { name: 'Oral-cancer screening', fixed: '$150 / screening', monthly: '$13 / mo · 12 mo', yearly: '$150 / yr' },
  { name: 'Airway and sleep screening', fixed: '$195 / assessment', monthly: '$17 / mo · 12 mo', yearly: '$195 / yr' },
  { name: 'Same-day emergency dental care', fixed: 'From $250', monthly: '$21 / mo · 12 mo', yearly: '$250 / yr' },
];
const chicagoFaq = [
  ['Where is the Chicago Heights office?', 'We are at 500 Ashland Ave, Suite #2, Chicago Heights, IL 60411.'],
  ['What are your Chicago Heights hours?', 'Monday through Thursday 7:30 AM–7:00 PM, Friday 7:30 AM–12:00 PM, and Saturday 8:00 AM–12:00 PM.'],
  ['Do you offer emergency dental care?', 'Yes. Call (708) 755-1333 so the team can understand what happened and guide your next step.'],
  ['Can my whole family visit this office?', 'Yes. The Chicago Heights office provides preventive, restorative, cosmetic, kid-friendly and complete-health care.'],
  ['Do you serve communities outside Chicago Heights?', 'Yes. This office supports Chicago Heights and 15 nearby communities listed on this page.'],
];
const cosmeticFaq = [
  ['How do I know which cosmetic treatment fits my smile?', 'A consultation begins with your goals, timeline, oral health and budget. The team then explains which options make sense and why.'],
  ['Is cosmetic dentistry available at both offices?', 'Yes. Cosmetic services are available in Chicago Heights and Mokena. Appointment availability can vary by treatment.'],
  ['How much does a cosmetic consultation cost?', 'Treatment pricing is shown on this page. Call the team to confirm consultation details and the plan recommended for you.'],
  ['Will my result look natural?', 'The planning process considers tooth shape, shade, proportion and your facial features so the result feels like you—not a template.'],
  ['Can cosmetic work be financed monthly?', 'Monthly examples are included for each service. Final terms and eligibility are confirmed with the office.'],
];
const faqs = chicago ? chicagoFaq : cosmeticFaq;
---

<div class:list={['detail-page', chicago ? 'is-chicago' : 'is-cosmetic']} data-detail-root data-detail-kind={kind}>
  <section class="detail-hero" data-detail-hero data-areas-hero={chicago ? '' : undefined} data-services-hero={!chicago ? '' : undefined}>
    <div class="detail-hero__sticky">
      <div class="detail-hero__grid" aria-hidden="true"></div>
      <div class="detail-hero__watermark" aria-hidden="true"><span>{chicago ? 'CHICAGO' : 'COSMETIC'}</span><em>{chicago ? 'HEIGHTS' : 'STORY'}</em></div>
      <div class="detail-hero__copy">
        <p class="detail-kicker"><span></span>{chicago ? 'Chicago Heights · Office 01' : 'Cosmetic dentistry · 7 possibilities'}</p>
        {chicago ? (
          <h1>Care that keeps<br /><em>pace with life.</em></h1>
        ) : (
          <h1>Designed to look<br /><em>like you.</em></h1>
        )}
        <p class="detail-hero__intro">{chicago ? 'Extended weekday hours, complete-health thinking and one connected team—right here on Ashland Avenue.' : 'Thoughtful cosmetic care begins by understanding what you want to keep, what you want to change and what should still feel unmistakably yours.'}</p>
        <a class="detail-button" href={chicago ? 'tel:+17087551333' : '#cosmetic-options'}>
          <span>{chicago ? 'Call Chicago Heights' : 'Explore your options'}</span><b aria-hidden="true">↓</b>
        </a>
      </div>

      <div class:list={['detail-hero__visual', !chicago && 'cosmetic-triptych']} data-hero-visual>
        <div class="detail-hero__outline" aria-hidden="true"><span>{chicago ? 'OFFICE 01' : 'PLAN 01'}</span></div>
        {chicago ? (
          <>
            <div class="detail-hero__frame">
              <img src="/images/generated/chicago-heights-arrival-v1.webp" alt="A patient being welcomed at a calm dental reception desk" width="1536" height="1024" loading="eager" fetchpriority="high" />
            </div>
            <div class="hero-aperture" aria-hidden="true"><i></i><i></i></div>
          </>
        ) : (
          <div class="cosmetic-triptych__panels">
            <div class="cosmetic-slice slice-a"><img src="/images/generated/cosmetic-smile-planning-v1.webp" alt="A dentist and patient planning a natural-looking cosmetic smile" width="1536" height="1024" loading="eager" fetchpriority="high" /></div>
            <div class="cosmetic-slice slice-b" aria-hidden="true"><img src="/images/generated/cosmetic-smile-planning-v1.webp" alt="" width="1536" height="1024" loading="eager" /></div>
            <div class="cosmetic-slice slice-c" aria-hidden="true"><img src="/images/generated/cosmetic-smile-planning-v1.webp" alt="" width="1536" height="1024" loading="eager" /></div>
          </div>
        )}
        {chicago ? (
          <div class="hero-address"><span>500 Ashland Ave, Suite #2</span><span>Chicago Heights, IL</span></div>
        ) : (
          <><div class="cosmetic-triptych__caption"><span>SHAPE</span><span>SHADE</span><span>PROPORTION</span></div><div class="hero-shade" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></>
        )}
      </div>

      <div class="detail-hero__index" aria-hidden="true"><span>SCROLL TO DISCOVER</span><i></i><b>01</b></div>
    </div>
  </section>

  <section class="detail-ledger" aria-label="Key details">
    {chicago ? (
      <>
        <div><small>OPEN</small><strong>Mon–Thu until 7 PM</strong></div>
        <div><small>COMMUNITIES</small><strong>16 connected</strong></div>
        <div><small>PATIENT PROOF</small><strong>4.9 from 258 reviews</strong></div>
        <div><small>CALL</small><strong>(708) 755-1333</strong></div>
      </>
    ) : (
      <>
        <div><small>OPTIONS</small><strong>7 exact services</strong></div>
        <div><small>APPROACH</small><strong>Plan before procedure</strong></div>
        <div><small>LOCATIONS</small><strong>Chicago Heights + Mokena</strong></div>
        <div><small>STARTING WITH</small><strong>Your goals</strong></div>
      </>
    )}
  </section>

  {chicago ? (
    <>
      <section class="editorial-story section-shell" data-reveal-section>
        <div class="editorial-story__eyebrow"><span>01</span><p>ABOUT CHICAGO HEIGHTS</p></div>
        <div class="editorial-story__headline">
          <h2>A neighborhood office<br />built for <em>real life.</em></h2>
        </div>
        <div class="editorial-story__body">
          <p>The Chicago Heights office connects extended hours, a familiar care team and complete-health thinking in one calm place. Care should fit the week you actually live.</p>
          <a href="https://maps.app.goo.gl/htHhNrnhbbu2WNR17" target="_blank" rel="noreferrer">Open in Google Maps ↗</a>
        </div>
        <div class="schedule-rail" data-schedule-rail>
          <div class="schedule-rail__line"><i></i></div>
          <article><b>01</b><span>MON — THU</span><strong>7:30 AM<br />— 7:00 PM</strong></article>
          <article><b>02</b><span>FRIDAY</span><strong>7:30 AM<br />— 12:00 PM</strong></article>
          <article><b>03</b><span>SATURDAY</span><strong>8:00 AM<br />— 12:00 PM</strong></article>
        </div>
      </section>

      <section class="care-atlas" id="connected-care" data-atlas>
        <div class="care-atlas__sticky">
          <div class="care-atlas__copy">
            <p class="detail-kicker light"><span></span>02 · ONE CONNECTED OFFICE</p>
            <h2>More of your care,<br /><em>under one roof.</em></h2>
            <p>From a preventive visit to a more complex plan, the same team can connect the details instead of treating each appointment like an isolated event.</p>
            <a href="/services/">View all services ↗</a>
          </div>
          <div class="care-spectrum" aria-label="Six connected care categories">
            <div class="care-spectrum__header">
              <span>THE CARE SPECTRUM</span>
              <strong data-care-total>48</strong>
              <small>CONNECTED SERVICES</small>
            </div>
            <div class="care-spectrum__lanes">
              {serviceGroups.map((group, i) => (
                <div class="care-spectrum__lane" data-care-lane>
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  <strong>{group.name}</strong>
                  <small>{group.count} services</small>
                  <i aria-hidden="true"><b></b></i>
                </div>
              ))}
            </div>
            <div class="care-spectrum__footer">
              <span>ONE OFFICE</span><i aria-hidden="true"><b data-care-progress></b></i><span>ONE CONNECTED TEAM</span>
            </div>
          </div>
        </div>
      </section>

      <section class="communities section-shell" data-reveal-section>
        <div class="communities__head">
          <p class="detail-kicker"><span></span>03 · NEARBY BY DESIGN</p>
          <h2>One office.<br /><em>Sixteen communities.</em></h2>
          <p>The Chicago Heights team supports familiar neighborhoods across the south suburbs—so connected care stays close to home.</p>
        </div>
        <div class="community-list">
          {communities.map((community, i) => <div><span>{String(i + 1).padStart(2, '0')}</span><strong>{community}</strong><i></i></div>)}
        </div>
      </section>
    </>
  ) : (
    <>
      <section class="about-cosmetic section-shell" data-reveal-section data-image-reveal>
        <header class="about-cosmetic__head">
          <p class="detail-kicker"><span></span>01 · ABOUT COSMETIC CARE</p>
          <h2>The best cosmetic work<br />still looks <em>like you.</em></h2>
        </header>
        <div class="about-cosmetic__media">
          <div class="about-cosmetic__image main-image"><img src="/images/generated/dental-exam-candid.webp" alt="A dentist listening carefully during a relaxed consultation" width="1536" height="1024" loading="lazy" /></div>
          <div class="about-cosmetic__image detail-image"><img src="/images/generated/clear-aligner-consultation.webp" alt="A close, collaborative dental consultation" width="1536" height="1024" loading="lazy" /></div>
          <span aria-hidden="true">DESIGN IS A CONVERSATION</span>
        </div>
        <div class="about-cosmetic__principles">
          <p>Good cosmetic dentistry does not announce itself. It begins with health, then brings shade, shape and proportion into a balance that belongs to your face—not somebody else’s.</p>
          <div><b>01</b><strong>Preserve</strong><span>Keep the character that already feels like you.</span></div>
          <div><b>02</b><strong>Balance</strong><span>Plan every change in relation to the whole smile.</span></div>
          <div><b>03</b><strong>Refine</strong><span>Choose the smallest meaningful step before adding more.</span></div>
        </div>
      </section>

      <section class="option-index" id="cosmetic-options" data-option-index>
        <header>
          <p class="detail-kicker light"><span></span>02 · THE POSSIBILITIES</p>
          <h2>Seven ways to refine<br /><em>one expression.</em></h2>
          <p>Select an option to see how it fits into the larger plan.</p>
        </header>
        <div class="option-index__layout">
          <div class="option-index__visual">
            <img src="/images/generated/cosmetic-smile-planning-v1.webp" alt="Cosmetic smile planning with a dentist" width="1536" height="1024" loading="lazy" />
            <span>PLANNED WITH YOU · NOT FOR YOU</span>
          </div>
          <div class="option-index__list">
            {cosmeticServices.map((service, i) => (
              <details open={i === 0} data-option>
                <summary><span>{service.n}</span><strong>{service.name}</strong><b>+</b></summary>
                <div class="option-body">
                  <p>{service.note}</p>
                  <div class="option-body__links">
                    <a href="#cosmetic-pricing">See pricing ↓</a>
                    <a href={`/services/${service.slug}/`} aria-label={`Learn more about ${service.name}`}>Learn more →</a>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <section class="journey" data-journey>
    <div class="journey__sticky">
      <header>
        <p class="detail-kicker"><span></span>{chicago ? '04 · THE COMPLETE-HEALTH PROCESS' : '03 · THE COSMETIC PROCESS'}</p>
        <h2>{chicago ? <>Care that becomes <em>clear.</em></> : <>A plan that becomes <em>clear.</em></>}</h2>
      </header>
      <div class="journey__track">
        {(chicago ? [
          ['01', 'Listen', 'We begin with your concern, your health story and what you need from this visit.'],
          ['02', 'See', 'Exams, imaging and complete-health screening bring the full picture into focus.'],
          ['03', 'Plan', 'Options, timing and pricing are organized into a path you can understand.'],
          ['04', 'Connect', 'Treatment and follow-up stay coordinated with one familiar Chicago Heights team.'],
        ] : [
          ['01', 'Listen', 'We begin with what you notice, what you want and what you do not want to lose.'],
          ['02', 'Assess', 'Health, bite, shade, shape and proportion are reviewed before a treatment is chosen.'],
          ['03', 'Plan', 'Options, timeline and pricing are put into a sequence you can understand.'],
          ['04', 'Refine', 'Every detail is adjusted toward a result that feels natural in motion and at rest.'],
        ]).map((step) => (
          <article data-journey-card>
            <span>{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p><i aria-hidden="true"></i>
          </article>
        ))}
      </div>
      <div class="journey__progress" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class:list={['trust-story', chicago ? 'trust-chicago' : 'trust-cosmetic']} data-trust-story data-reveal-section>
    <div class="trust-story__image" data-trust-image>
      <img src={chicago ? '/images/generated/clinic-operatory-consistent.webp' : '/images/generated/clear-aligner-consultation.webp'} alt={chicago ? 'A calm treatment room at Smiles by Noetzel' : 'A dentist and patient reviewing a treatment plan together'} width="1536" height="1024" loading="lazy" />
      <span>{chicago ? '500 ASHLAND AVE · CHICAGO HEIGHTS' : 'ONE PLAN · TWO CONNECTED OFFICES'}</span>
    </div>
    <div class="trust-story__content">
      <p class="detail-kicker light"><span></span>{chicago ? '05 · WHY CHOOSE THIS OFFICE' : '04 · WHY CHOOSE SMILES BY NOETZEL'}</p>
      <h2>{chicago ? 'More than a convenient address.' : 'More than a cosmetic menu.'}</h2>
      <p>{chicago ? 'The difference is not a single technology or appointment. It is the way access, experience and the wider health story work together.' : 'Your smile is considered inside your complete-health story, with clear options and pricing before treatment begins.'}</p>
      <div class="trust-story__reasons">
        {(chicago ? [
          ['01', 'Hours that make room', 'Early mornings, evenings and Saturday availability.'],
          ['02', '48 connected services', 'Prevention, comfort, restoration and advanced care in one network.'],
          ['03', 'Complete-health thinking', 'The team looks beyond one tooth and one appointment.'],
          ['04', 'Patient-backed care', 'A 4.9 Google rating from 258 Chicago Heights reviews.'],
        ] : [
          ['01', 'Health before aesthetics', 'Cosmetic decisions begin with a stable, healthy foundation.'],
          ['02', 'Seven paths, one plan', 'Options are coordinated instead of sold as isolated procedures.'],
          ['03', 'Pricing you can compare', 'Fixed, monthly and yearly views are visible before you begin.'],
          ['04', 'Two connected offices', 'Cosmetic care is available in Chicago Heights and Mokena.'],
        ]).map((reason) => <article><b>{reason[0]}</b><strong>{reason[1]}</strong><p>{reason[2]}</p></article>)}
      </div>
    </div>
  </section>

  {chicago && (
    <section class="pricing pricing--chicago section-shell" id="chicago-pricing" data-reveal-section>
      <div class="pricing__head">
        <p class="detail-kicker"><span></span>06 · PRICING, MADE LEGIBLE</p>
        <h2>Everyday care.<br /><em>Three ways to plan.</em></h2>
        <p>Compare a focused set of common Chicago Heights services in fixed, monthly and yearly customer-facing views.</p>
      </div>
      <div class="pricing__table" role="table" aria-label="Chicago Heights general dentistry pricing">
        <div class="pricing__row pricing__labels" role="row"><span>Service</span><span>Fixed</span><span>Monthly</span><span>Yearly</span></div>
        {chicagoPricing.map((service) => (
          <div class="pricing__row" role="row"><strong>{service.name}</strong><span>{service.fixed}</span><span>{service.monthly}</span><span>{service.yearly}</span></div>
        ))}
      </div>
      <p class="pricing__note">Monthly examples show the stated amount divided across the listed term. Eligibility, final treatment scope and payment terms are confirmed by the office.</p>
    </section>
  )}

  {!chicago && (
    <section class="pricing section-shell" id="cosmetic-pricing" data-reveal-section>
      <div class="pricing__head">
        <p class="detail-kicker"><span></span>05 · PRICING, MADE LEGIBLE</p>
        <h2>A clear view of<br /><em>the investment.</em></h2>
        <p>Use fixed, monthly and yearly views to compare possibilities. Final recommendations follow your consultation.</p>
      </div>
      <div class="pricing__table" role="table" aria-label="Cosmetic dentistry pricing">
        <div class="pricing__row pricing__labels" role="row"><span>Service</span><span>Fixed</span><span>Monthly</span><span>Yearly</span></div>
        {cosmeticServices.map((service) => (
          <div class="pricing__row" role="row"><strong>{service.name}</strong><span>{service.fixed}</span><span>{service.monthly}</span><span>{service.yearly}</span></div>
        ))}
      </div>
      <p class="pricing__note">Monthly examples show the stated service amount divided across the listed term. Eligibility and final terms are confirmed by the office. Complete smile makeover pricing varies with the selected procedures.</p>
    </section>
  )}

  <section class="patient-proof" data-proof>
    <div class="patient-proof__top">
      <div><p class="detail-kicker light"><span></span>{chicago ? '07 · CHICAGO HEIGHTS PATIENT REVIEWS' : '06 · COSMETIC PATIENT REVIEW'}</p><h2 class="proof-heading">Real patients.<br /><em>Real perspective.</em></h2></div>
      <div class="proof-score"><strong>4.9</strong><span>Google rating<br />Chicago Heights</span></div>
    </div>
    <div class="patient-proof__stage">
      <blockquote data-proof-quote>
        <p>{chicago ? '“The staff work together like a well-oiled machine—friendly, efficient and attentive without making the visit feel rushed.”' : '“The staining was removed and the result was dramatically whiter. I was thrilled with how clean and bright my teeth looked.”'}</p>
        <footer>{chicago ? 'KEANNA BENSON · PATIENT REVIEW' : 'CYNTHIA K. · PATIENT REVIEW'}</footer>
      </blockquote>
      <div class="proof-topics">
        <span>{chicago ? 'Friendly staff · 76 mentions' : 'Natural-looking planning'}</span>
        <span>{chicago ? 'Caring staff · 35 mentions' : 'Shade · shape · proportion'}</span>
        <span>{chicago ? 'Clear explanations · 9 mentions' : 'Both office locations'}</span>
      </div>
    </div>
    <p class="proof-total">{chicago ? '258' : '7'}<small>{chicago ? 'total Google reviews' : 'cosmetic possibilities'}</small></p>
  </section>

  <section class="detail-faq section-shell" data-reveal-section>
    <div class="detail-faq__head"><p class="detail-kicker"><span></span>{chicago ? '08 · GOOD QUESTIONS' : '07 · GOOD QUESTIONS'}</p><h2>Before you<br /><em>begin.</em></h2></div>
    <div class="detail-faq__list">
      {faqs.map((faq, i) => (
        <details open={i === 0}>
          <summary><span>{String(i + 1).padStart(2, '0')}</span><strong>{faq[0]}</strong><b>+</b></summary>
          <p>{faq[1]}</p>
        </details>
      ))}
    </div>
  </section>
</div>

<style>
  :global(html){scroll-behavior:auto} :global(body){margin:0;background:var(--paper);color:var(--ink);overflow-x:hidden}.detail-page{--serif:"Cormorant Garamond",Georgia,serif;--sans:"Inter",Arial,sans-serif;background:var(--paper);font-family:var(--sans);overflow:clip}.section-shell{padding:clamp(6rem,10vw,10rem) clamp(1.25rem,6vw,7rem)}
  .detail-kicker{display:flex;align-items:center;gap:.7rem;margin:0;font-size:.7rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.detail-kicker span{width:1.8rem;height:1px;background:currentColor}.detail-kicker.light{color:var(--mint-300)}
  .detail-hero{height:220svh;background:var(--pine-950);color:var(--porcelain);position:relative;isolation:isolate}.detail-hero__sticky{height:100svh;position:sticky;top:0;overflow:hidden;display:grid;grid-template-columns:minmax(18rem,40%) 1fr;align-items:center;padding:7.5rem clamp(1.25rem,6vw,7rem) 3rem}.detail-hero__grid{position:absolute;inset:0;background-image:linear-gradient(to right,rgba(196,234,220,.09) 1px,transparent 1px);background-size:25% 100%;pointer-events:none}.detail-hero__watermark{position:absolute;z-index:0;left:-1.5vw;bottom:-1.5vw;display:grid;font-family:var(--serif);font-size:clamp(8rem,17vw,19rem);font-weight:500;line-height:.58;letter-spacing:-.075em;color:rgba(196,234,220,.045);pointer-events:none;white-space:nowrap}.detail-hero__watermark em{margin-left:16vw;font-weight:500}.detail-hero__copy{z-index:4;position:relative;max-width:min(38vw,35rem);filter:drop-shadow(0 1.2rem 2.6rem rgba(6,29,25,.3));will-change:transform}.detail-hero h1{font-family:var(--serif);font-size:clamp(4.4rem,8.1vw,9.2rem);font-weight:500;line-height:.76;letter-spacing:-.06em;margin:2rem 0}.detail-hero h1 em{font-weight:500;color:var(--mint-300)}.detail-hero__intro{max-width:29rem;font-size:clamp(.95rem,1.15vw,1.15rem);line-height:1.7;color:rgba(245,240,231,.82);margin:0 0 2rem}.detail-button{display:inline-flex;align-items:center;justify-content:space-between;gap:2rem;border:1px solid rgba(196,234,220,.38);border-radius:999px;padding:.45rem .45rem .45rem 1.25rem;min-width:14rem;color:var(--porcelain);font-size:.72rem;font-weight:800;letter-spacing:.09em;text-decoration:none;text-transform:uppercase;background:rgba(6,29,25,.24);backdrop-filter:blur(10px)}.detail-button b{display:grid;place-items:center;width:2.8rem;height:2.8rem;border-radius:50%;background:var(--mint-300);color:var(--pine-950)}.detail-hero__visual{position:absolute;right:clamp(1.25rem,4vw,5rem);top:15vh;width:min(54vw,60rem);height:70vh;z-index:2;will-change:width,height,top,right}.detail-hero__o