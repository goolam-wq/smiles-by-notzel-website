---
const southAreas = ['Chicago Heights', 'South Chicago Heights', 'Steger', 'Sauk Village', 'Lynwood', 'Glenwood', 'Olympia Fields', 'Park Forest', 'Homewood', 'Flossmoor', 'Matteson'];
const westAreas = ['Mokena', 'Frankfort', 'New Lenox', 'Tinley Park', 'Orland Park', 'Homer Glen', 'Lockport', 'Manhattan', 'Frankfort Square', 'Orland Hills'];
const doctors = [
  { image: '/images/generated/doctor-joseph-provisional.webp', name: 'Dr. Joseph William Noetzel', degree: 'D.D.S.', detail: 'Complete-health dentistry, oral medicine and complex dental rehabilitation.', note: '20+ years of clinical experience' },
  { image: '/images/generated/doctor-ilenne-provisional.webp', name: 'Dr. Ilenne Noetzel', degree: 'D.D.S.', detail: 'Long-term patient relationships, oral-systemic health and ReCODE 2.0.', note: 'ReCODE 2.0 certified' },
  { image: '/images/generated/doctor-michael-provisional.webp', name: 'Dr. Michael Drinski', degree: 'D.D.S.', detail: 'Complete Health Dentistry with a focus that includes simple extractions and root-canal care.', note: 'University of Louisville graduate' },
];
const prices = [
  { label: 'Preventive', title: 'Professional cleaning', fixed: '$125', monthly: '$21/mo', yearly: '$250/yr', note: 'Yearly basis includes two visits.' },
  { label: 'Clear aligners', title: 'Invisalign treatment', fixed: '$5,495', monthly: '$153/mo', yearly: '$5,495/yr', note: 'Complete case; teen and adult options.' },
  { label: 'Gum health', title: 'Perio Protect therapy', fixed: '$1,200', monthly: '$50/mo', yearly: '$1,200/yr', note: 'Upper and lower tray system.' },
];
const faqs = [
  { q: 'Can I visit either office?', a: 'Yes. The mapped service list is available through both Chicago Heights and Mokena, with some advanced programs scheduled by appointment. Call the preferred office to confirm timing.' },
  { q: 'Do you offer same-day emergency care?', a: 'Same-day emergency dental care is listed at both offices. Call first so the team can assess urgency and reserve the right appointment window.' },
  { q: 'Can I see fixed, monthly and yearly pricing?', a: 'Yes. Customer-facing pricing is organized in fixed, monthly and yearly formats. Final treatment planning can change the total for case-dependent services.' },
  { q: 'What does complete-health dentistry mean here?', a: 'The practice connects oral health with airway, sleep, inflammation and wider health signals through screenings, education and coordinated care.' },
  { q: 'Do you welcome children and anxious patients?', a: 'The service map includes first visits, pediatric cleaning and exams, HealthyStart, nitrous oxide and virtual-reality comfort options.' },
];
---

<section class="coverage" id="service-areas" data-section="coverage">
  <div class="coverage-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="container-shell coverage-head" data-reveal>
    <p class="eyebrow">Close to home</p>
    <h2>Two offices.<br /><em>One connected circle of care.</em></h2>
  </div>
  <figure class="clinic-world container-shell" data-reveal>
    <img src="/images/generated/clinic-operatory-consistent.webp" alt="Warm modern dental operatory with forest-green cabinetry and advanced equipment" loading="lazy" />
    <figcaption><span>One calm visual language</span><b>Chicago Heights · Mokena</b></figcaption>
  </figure>
  <div class="container-shell coverage-grid">
    <article class="area-column" data-reveal>
      <div class="area-title"><span>01</span><h3>Chicago Heights</h3></div>
      <p>500 Ashland Ave, Suite #2</p>
      <div class="area-list">{southAreas.map((area) => <span>{area}</span>)}</div>
      <a href="/service-areas/">Explore south-suburban coverage <i>↗</i></a>
    </article>
    <article class="area-column area-column--dark" data-reveal>
      <div class="area-title"><span>02</span><h3>Mokena</h3></div>
      <p>19160 88th Avenue</p>
      <div class="area-list">{westAreas.map((area) => <span>{area}</span>)}</div>
      <a href="/service-areas/">Explore Mokena-area coverage <i>↗</i></a>
    </article>
  </div>
</section>

<section class="proof" id="reviews" data-section="proof">
  <div class="container-shell proof-heading" data-reveal>
    <p class="eyebrow">Patient proof</p>
    <h2>Trust, measured<br /><em>in real experiences.</em></h2>
    <div class="rating-stack">
      <strong>4.9</strong><span>Chicago Heights<br />258 Google reviews</span>
      <strong>5.0</strong><span>Mokena<br />5 Google reviews</span>
    </div>
  </div>
  <div class="review-row container-shell">
    <article data-reveal><span>★★★★★</span><p>Long-term family care, thoughtful technology and efficient visits.</p><b>Keanna Benson</b></article>
    <article data-reveal><span>★★★★★</span><p>Prompt support for severe pain, with comfort prioritized throughout the visit.</p><b>Jason Bracken</b></article>
    <article data-reveal><span>★★★★★</span><p>Friendly, patient and pain-conscious care with accommodating scheduling.</p><b>Terre Robertson</b></article>
  </div>
  <div class="proof-ribbon" aria-hidden="true">
    <span>76 friendly-staff mentions</span><span>35 caring-staff mentions</span><span>18 hygienist mentions</span><span>9 clear-explanation mentions</span>
  </div>
</section>

<section class="team" id="team" data-section="team">
  <div class="container-shell team-heading" data-reveal>
    <p class="eyebrow">Meet the doctors</p>
    <h2>Clinical depth.<br /><em>Human connection.</em></h2>
    <a href="/team/">Meet the complete team <i>↗</i></a>
  </div>
  <div class="container-shell doctor-grid">
    {doctors.map((doctor, index) => (
      <article class="doctor-card" data-reveal>
        <div class="doctor-portrait"><img src={doctor.image} alt={`${doctor.name}, provisional portrait pending client approval`} loading="lazy" /><i>{String(index + 1).padStart(2, '0')}</i></div>
        <div><span>{doctor.degree}</span><h3>{doctor.name}</h3><p>{doctor.detail}</p><b>{doctor.note}</b></div>
      </article>
    ))}
  </div>
</section>

<section class="pricing" id="pricing" data-section="pricing">
  <div class="container-shell pricing-heading" data-reveal>
    <p class="eyebrow">Clear ways to plan</p>
    <h2>Know the path.<br /><em>Choose the pace.</em></h2>
    <p>Every mapped service has customer-facing fixed, monthly and yearly pricing. These examples show how the three formats work.</p>
  </div>
  <div class="container-shell price-grid">
    {prices.map((price) => (
      <article class="price-card" data-reveal>
        <span>{price.label}</span><h3>{price.title}</h3>
        <dl><div><dt>Fixed</dt><dd>{price.fixed}</dd></div><div><dt>Monthly</dt><dd>{price.monthly}</dd></div><div><dt>Yearly</dt><dd>{price.yearly}</dd></div></dl>
        <p>{price.note}</p>
      </article>
    ))}
  </div>
  <a class="pricing-link" href="/pricing/">View all service pricing <i>↗</i></a>
</section>

<section class="locations" id="locations" data-section="locations">
  <div class="container-shell locations-heading" data-reveal><p class="eyebrow">Visit us</p><h2>Pick the office<br /><em>closest to your day.</em></h2></div>
  <div class="location-panels">
    <article data-reveal>
      <span>Chicago Heights · 01</span><h3>500 Ashland Ave,<br />Suite #2</h3>
      <a href="tel:+17087551333">(708) 755-1333</a>
      <dl><div><dt>Mon–Thu</dt><dd>7:30am–7:00pm</dd></div><div><dt>Friday</dt><dd>7:30am–12:00pm</dd></div><div><dt>Saturday</dt><dd>8:00am–12:00pm</dd></div></dl>
      <a class="map-link" href="https://maps.app.goo.gl/htHhNrnhbbu2WNR17">Open in Google Maps <i>↗</i></a>
    </article>
    <article data-reveal>
      <span>Mokena · 02</span><h3>19160 88th Avenue</h3>
      <a href="tel:+17084797733">(708) 479-7733</a>
      <dl><div><dt>Monday</dt><dd>8:00am–7:00pm</dd></div><div><dt>Thursday</dt><dd>9:30am–6:00pm</dd></div><div><dt>Every other Sat</dt><dd>8:00am–12:00pm</dd></div></dl>
      <a class="map-link" href="https://www.google.com/maps/search/?api=1&query=Ashland+Dental+and+Wellness+Center+19160+88th+Avenue+Mokena+IL+60448">Open in Google Maps <i>↗</i></a>
    </article>
  </div>
</section>

<section class="faq" id="faq" data-section="faq">
  <div class="container-shell faq-grid">
    <div class="faq-heading" data-reveal><p class="eyebrow">Questions, answered</p><h2>Start with<br /><em>clarity.</em></h2><a href="/faq/">View all FAQs <i>↗</i></a></div>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details data-reveal>
          <summary><span>{String(index + 1).padStart(2, '0')}</span>{faq.q}<i>+</i></summary><p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<footer class="site-footer" id="contact" data-section="footer">
  <div class="footer-orbit" aria-hidden="true"></div>
  <div class="container-shell footer-main" data-reveal>
    <p class="eyebrow">Ready when you are</p>
    <h2>Let’s make your next<br /><em>visit feel different.</em></h2>
    <div class="footer-actions"><a href="tel:+17087551333">Call (708) 755-1333</a><a href="mailto:nadia.ashland@gmail.com">Email the team <i>↗</i></a></div>
  </div>
  <div class="container-shell footer-bottom">
    <div><strong>Smiles by Noetzel</strong><span>Ashland Dental &amp; Wellness Center</span></div>
    <nav aria-label="Footer"><a href="/services/">Services</a><a href="/service-areas/">Service Areas</a><a href="/pricing/">Pricing</a><a href="/team/">Team</a><a href="/faq/">FAQ</a></nav>
    <span>Chicago Heights · Mokena · Illinois</span>
  </div>
</footer>

<style>
  :global(.section-title) { font-family: Georgia, 'Times New Roman', serif; }
  .coverage, .proof, .team, .pricing, .locations, .faq, .site-footer { position: relative; overflow: hidden; }
  .coverage { padding: 10rem 0; background: var(--porcelain); }
  .coverage-orbit { position:absolute; top:-20rem; right:-12rem; width:52rem; aspect-ratio:1; border:1px solid rgba(27,92,77,.14); border-radius:50%; }
  .coverage-orbit i { position:absolute; inset:15%; border:1px solid rgba(27,92,77,.12); border-radius:50%; }
  .coverage-orbit i:nth-child(2){inset:30%}.coverage-orbit i:nth-child(3){inset:45%}
  .coverage-head { position:relative; z-index:1; display:grid; grid-template-columns:.55fr 2.35fr; gap:2rem; margin-bottom:7rem; }
  .coverage-head .eyebrow { color:var(--pine-700); }
  .coverage h2,.proof h2,.team h2,.pricing h2,.locations h2,.faq h2,.site-footer h2 { margin:0; font-family:Georgia,'Times New Roman',serif; font-size:clamp(4.7rem,7.6vw,8.8rem); font-weight:400; line-height:.84; letter-spacing:-.065em; }
  h2 em { color:var(--pine-700); font-weight:400; }
  .coverage-grid { position:relative; z-index:1; display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .clinic-world{position:relative;z-index:1;margin-bottom:1rem;overflow:hidden;border-radius:1.3rem;background:var(--pine-900)}.clinic-world img{display:block;width:100%;height:min(68vh,45rem);object-fit:cover}.clinic-world figcaption{position:absolute;right:0;bottom:0;left:0;display:flex;padding:1rem 1.2rem;justify-content:space-between;background:linear-gradient(180deg,transparent,rgba(6,29,25,.82));color:var(--porcelain);font-size:.62rem;text-transform:uppercase;letter-spacing:.12em}.clinic-world figcaption span{color:var(--mint-300)}
  .area-column { min-height:40rem; padding:2rem; border:1px solid rgba(16,35,31,.18); border-radius:1.3rem; background:var(--paper); }
  .area-column--dark { background:var(--pine-950); color:var(--porcelain); }
  .area-title{display:flex; align-items:flex-start; gap:1rem}.area-title span{font-size:.62rem;font-weight:800}.area-title h3{margin:0;font-family:Georgia,serif;font-size:clamp(3.2rem,5vw,5.6rem);font-weight:400;line-height:.9;letter-spacing:-.055em}
  .area-column>p{margin:1rem 0 4rem;color:currentColor;opacity:.62}.area-list{display:flex;flex-wrap:wrap;gap:.55rem}.area-list span{padding:.6rem .8rem;border:1px solid currentColor;border-radius:999px;font-size:.68rem;opacity:.75}
  .area-column>a{display:flex;margin-top:4rem;padding-top:1rem;justify-content:space-between;border-top:1px solid currentColor;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.area-column a i{font-style:normal}

  .proof{padding:11rem 0 7rem;background:var(--mint-200);color:var(--pine-950)}
  .proof-heading{display:grid;grid-template-columns:.5fr 1.55fr .7fr;gap:2rem;align-items:start}.proof h2 em{color:var(--porcelain)}
  .rating-stack{display:grid;grid-template-columns:auto 1fr;gap:1.1rem 1rem;align-items:center}.rating-stack strong{font-family:Georgia,serif;font-size:3.8rem;font-weight:400}.rating-stack span{font-size:.72rem;line-height:1.45;text-transform:uppercase;letter-spacing:.09em}
  .review-row{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:7rem}.review-row article{min-height:20rem;padding:1.5rem;display:flex;flex-direction:column;justify-content:space-between;border:1px solid rgba(16,35,31,.25);border-radius:1rem;background:rgba(245,240,231,.18)}
  .review-row article>span{letter-spacing:.22em}.review-row p{font-family:Georgia,serif;font-size:clamp(1.8rem,2.4vw,2.7rem);line-height:1.05;letter-spacing:-.035em}.review-row b{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em}
  .proof-ribbon{display:flex;width:max-content;margin-top:5rem;gap:5rem;font-family:Georgia,serif;font-size:clamp(2rem,4vw,4.4rem);white-space:nowrap;opacity:.35;animation:ribbon 26s linear infinite}@keyframes ribbon{to{transform:translateX(-50%)}}

  .team{padding:11rem 0;background:var(--pine-950);color:var(--porcelain)}.team-heading{display:grid;grid-template-columns:.55fr 2fr .65fr;gap:2rem;align-items:end}.team-heading .eyebrow{align-self:start;color:var(--mint-300)}.team h2 em{color:var(--mint-300)}.team-heading>a{padding-top:1rem;border-top:1px solid rgba(245,240,231,.3);font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.team-heading a i{float:right;font-style:normal}
  .doctor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:7rem}.doctor-card{border:1px solid rgba(245,240,231,.18);border-radius:1.15rem;overflow:hidden}.doctor-portrait{position:relative;min-height:23rem;overflow:hidden;background:linear-gradient(145deg,var(--pine-800),var(--pine-900))}.doctor-portrait img{display:block;width:100%;height:27rem;object-fit:cover;object-position:center 28%;filter:saturate(.88) contrast(1.02)}.doctor-portrait::after{position:absolute;inset:auto 0 0;height:35%;background:linear-gradient(180deg,transparent,rgba(6,29,25,.56));content:''}.doctor-portrait i{position:absolute;top:1rem;right:1rem;z-index:1;padding:.4rem .55rem;border-radius:999px;background:rgba(6,29,25,.55);font-family:Georgia,serif;font-size:.7rem;font-style:normal;backdrop-filter:blur(8px)}.doctor-card>div:last-child{padding:1.4rem}.doctor-card h3{margin:.8rem 0 1rem;font-family:Georgia,serif;font-size:2.2rem;font-weight:400;line-height:1}.doctor-card p{min-height:5rem;color:rgba(245,240,231,.65);line-height:1.55}.doctor-card b,.doctor-card>div:last-child>span{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;color:var(--mint-300)}

  .pricing{padding:11rem 0;background:var(--porcelain)}.pricing-heading{display:grid;grid-template-columns:.5fr 1.55fr .7fr;gap:2rem;align-items:start}.pricing-heading>.eyebrow{color:var(--pine-700)}.pricing-heading>p:last-child{line-height:1.6;color:rgba(16,35,31,.65)}
  .price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:7rem}.price-card{min-height:31rem;padding:1.5rem;border:1px solid rgba(16,35,31,.2);border-radius:1.1rem;background:var(--paper)}.price-card>span{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.13em;color:var(--pine-700)}.price-card h3{margin:2rem 0 3rem;font-family:Georgia,serif;font-size:clamp(2.5rem,3.4vw,4rem);font-weight:400;line-height:.92}.price-card dl{margin:0}.price-card dl div{display:flex;padding:1rem 0;justify-content:space-between;border-top:1px solid rgba(16,35,31,.18)}.price-card dt{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em}.price-card dd{margin:0;font-family:Georgia,serif;font-size:1.5rem}.price-card p{margin-top:2rem;color:rgba(16,35,31,.6);font-size:.78rem;line-height:1.5}.pricing-link{display:flex;width:min(100% - 2rem,92rem);margin:2rem auto 0;padding:1.2rem 1.4rem;justify-content:space-between;border-radius:999px;background:var(--pine-950);color:var(--porcelain);font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.11em}.pricing-link i{font-style:normal}

  .locations{padding:11rem 0 0;background:var(--pine-900);color:var(--porcelain)}.locations-heading{display:grid;grid-template-columns:.55fr 2.35fr;gap:2rem;margin-bottom:7rem}.locations-heading .eyebrow{color:var(--mint-300)}.locations h2 em{color:var(--mint-300)}.location-panels{display:grid;grid-template-columns:1fr 1fr}.location-panels>article{min-height:43rem;padding:clamp(2rem,5vw,5rem);border-top:1px solid rgba(245,240,231,.2);border-right:1px solid rgba(245,240,231,.2)}.location-panels>article>span{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.13em;color:var(--mint-300)}.location-panels h3{margin:2.2rem 0 1rem;font-family:Georgia,serif;font-size:clamp(3rem,4.8vw,5.5rem);font-weight:400;line-height:.92}.location-panels>article>a:not(.map-link){font-family:Georgia,serif;font-size:1.5rem;color:var(--mint-300)}.location-panels dl{margin:5rem 0 0}.location-panels dl div{display:flex;padding:.85rem 0;justify-content:space-between;border-top:1px solid rgba(245,240,231,.16)}.location-panels dt{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em}.location-panels dd{margin:0;color:rgba(245,240,231,.65)}.map-link{display:flex;margin-top:3rem;padding-top:1rem;justify-content:space-between;border-top:1px solid rgba(245,240,231,.3);font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.map-link i{font-style:normal}

  .faq{padding:11rem 0;background:var(--paper)}.faq-grid{display:grid;grid-template-columns:.85fr 1.4fr;gap:7vw}.faq-heading{position:sticky;top:9rem;align-self:start}.faq-heading>.eyebrow{color:var(--pine-700)}.faq h2{margin:2rem 0 3rem}.faq-heading>a{display:flex;padding-top:1rem;justify-content:space-between;border-top:1px solid rgba(16,35,31,.22);font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.faq-heading a i{font-style:normal}.faq-list details{border-top:1px solid rgba(16,35,31,.22)}.faq-list summary{display:grid;grid-template-columns:2.5rem 1fr auto;gap:1rem;padding:2rem 0;align-items:center;cursor:pointer;font-family:Georgia,serif;font-size:clamp(1.6rem,2.3vw,2.6rem);list-style:none}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary span{font-family:Arial,sans-serif;font-size:.58rem}.faq-list summary i{font-family:Arial,sans-serif;font-size:1.5rem;font-style:normal;transition:transform .3s ease}.faq-list details[open] summary i{transform:rotate(45deg)}.faq-list details p{max-width:43rem;margin:0 0 2rem 3.5rem;color:rgba(16,35,31,.68);line-height:1.65}

  .site-footer{padding:10rem 0 2rem;background:var(--pine-950);color:var(--porcelain)}.footer-orbit{position:absolute;right:-12rem;bottom:-22rem;width:55rem;aspect-ratio:1;border:1px solid rgba(158,215,196,.18);border-radius:50%}.footer-main{position:relative;z-index:1}.footer-main>.eyebrow{color:var(--mint-300)}.site-footer h2{margin:3rem 0 4rem;font-size:clamp(5rem,9vw,10rem)}.site-footer h2 em{color:var(--mint-300)}.footer-actions{display:flex;gap:1rem}.footer-actions a{display:flex;min-width:16rem;padding:1.1rem 1.3rem;justify-content:space-between;border:1px solid rgba(245,240,231,.3);border-radius:999px;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.footer-actions a:first-child{background:var(--mint-300);color:var(--pine-950)}.footer-actions i{font-style:normal}.footer-bottom{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr 1fr;gap:2rem;margin-top:10rem;padding-top:2rem;border-top:1px solid rgba(245,240,231,.18);font-size:.65rem;text-transform:uppercase;letter-spacing:.1em}.footer-bottom>div{display:grid;gap:.45rem}.footer-bottom nav{display:flex;flex-wrap:wrap;gap:1rem}.footer-bottom>span{text-align:right}

  @media (max-width:68rem){.coverage,.proof,.team,.pricing,.locations,.faq{padding-top:8rem}.coverage-head,.proof-heading,.team-heading,.pricing-heading,.locations-heading{grid-template-columns:1fr;gap:1.5rem}.coverage h2,.proof h2,.team h2,.pricing h2,.locations h2,.faq h2{font-size:clamp(4.4rem,10vw,7rem)}.coverage-grid{grid-template-columns:1fr}.area-column{min-height:34rem}.proof-heading{grid-template-columns:1fr 1.5fr}.proof-heading>.eyebrow{grid-column:1/-1}.review-row,.doctor-grid,.price-grid{grid-template-columns:1fr 1fr}.review-row article:last-child,.doctor-card:last-child,.price-card:last-child{grid-column:1/-1}.team-heading{grid-template-columns:1fr 1.8fr}.team-heading>.eyebrow{grid-column:1/-1}.location-panels{grid-template-columns:1fr}.location-panels>article{min-height:auto}.faq-grid{grid-template-columns:1fr}.faq-heading{position:relative;top:auto}.footer-bottom{grid-template-columns:1fr 1fr}.footer-bottom>span{grid-column:1/-1;text-align:left}}
  @media (max-width:46rem){.coverage,.proof,.team,.pricing,.locations,.faq{padding-top:6.5rem}.coverage-head{margin-bottom:4rem}.coverage h2,.proof h2,.team h2,.pricing h2,.locations h2,.faq h2{font-size:clamp(3.7rem,16vw,5.2rem)}.area-column{min-height:auto;padding:1.25rem}.area-title h3{font-size:3.4rem}.review-row,.doctor-grid,.price-grid{grid-template-columns:1fr;margin-top:4rem}.review-row article:last-child,.doctor-card:last-child,.price-card:last-child{grid-column:auto}.review-row article{min-height:18rem}.team-heading{grid-template-columns:1fr}.team-heading>.eyebrow{grid-column:auto}.doctor-portrait{min-height:20rem}.pricing-heading{grid-template-columns:1fr}.location-panels h3{font-size:3.4rem}.location-panels>article{padding:3rem 1rem}.faq-list summary{grid-template-columns:2rem 1fr auto;padding:1.5rem 0}.faq-list details p{margin-left:3rem}.site-footer{padding-top:7rem}.site-footer h2{font-size:clamp(4rem,18vw,6rem)}.footer-actions{flex-direction:column}.footer-actions a{min-width:0}.footer-bottom{grid-template-columns:1fr;margin-top:7rem}.footer-bottom nav{display:grid;grid-template-columns:1fr 1fr}}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((item) => {
      gsap.from(item, { y: 72, opacity: 0, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: item, start: 'top 88%', once: true } });
    });
    gsap.to('.coverage-orbit', { rotate: 45, ease: 'none', scrollTrigger: { trigger: '.coverage', start: 'top bottom', end: 'bottom top', scrub: 1 } });
    gsap.to('.footer-orbit', { scale: 1.18, rotate: -25, ease: 'none', scrollTrigger: { trigger: '.site-footer', start: 'top bottom', end: 'bottom bottom', scrub: 1 } });
  }
</script>
