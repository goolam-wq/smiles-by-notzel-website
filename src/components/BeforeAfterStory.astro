---
interface Props {
  id: string;
  tone?: 'dark' | 'light';
  reverse?: boolean;
  number?: string;
  eyebrow: string;
  title: string;
  emphasis: string;
  intro: string;
  image: string;
  imageAlt: string;
  beforeLabel: string;
  beforeDetail: string;
  afterLabel: string;
  afterDetail: string;
  caseNote: string;
}

const {
  id,
  tone = 'dark',
  reverse = false,
  number = '01',
  eyebrow,
  title,
  emphasis,
  intro,
  image,
  imageAlt,
  beforeLabel,
  beforeDetail,
  afterLabel,
  afterDetail,
  caseNote,
} = Astro.props;
---

<section
  class:list={['before-after', `before-after--${tone}`, { 'before-after--reverse': reverse }]}
  id={id}
  data-before-after
  style="--split:46%"
>
  <div class="before-after__rules" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <header class="before-after__header">
    <p class="before-after__eyebrow"><span>{number}</span>{eyebrow}</p>
    <h2>{title} <em>{emphasis}</em></h2>
    <p class="before-after__intro">{intro}</p>
  </header>

  <div class="before-after__stage">
    <figure class="before-after__visual" role="img" aria-label={imageAlt}>
      <div class="before-after__image before-after__image--before" style={`background-image:url("${image}")`}></div>
      <div class="before-after__image before-after__image--after" style={`background-image:url("${image}")`}></div>
      <div class="before-after__veil" aria-hidden="true"></div>
      <div class="before-after__divider" aria-hidden="true"><i></i><span>DRAG</span></div>
      <span class="before-after__state before-after__state--before">BEFORE</span>
      <span class="before-after__state before-after__state--after">AFTER</span>
      <input
        class="before-after__range"
        type="range"
        min="12"
        max="88"
        value="46"
        aria-label={`Compare the before and after result: ${imageAlt}`}
        data-before-after-range
      />
    </figure>

    <div class="before-after__details">
      <article>
        <span>BEFORE</span>
        <h3>{beforeLabel}</h3>
        <p>{beforeDetail}</p>
      </article>
      <article>
        <span>AFTER</span>
        <h3>{afterLabel}</h3>
        <p>{afterDetail}</p>
      </article>
      <div class="before-after__case">
        <small>CASE FOCUS</small>
        <strong>{caseNote}</strong>
      </div>
    </div>
  </div>

  <footer class="before-after__footer">
    <span>Drag, tap or use your arrow keys</span>
    <i aria-hidden="true"></i>
    <strong>Realistic results vary by patient</strong>
  </footer>
</section>

<style>
  .before-after{--ba-bg:var(--pine-950);--ba-ink:var(--porcelain);--ba-muted:rgba(245,240,231,.62);--ba-line:rgba(196,234,220,.2);--ba-accent:var(--mint-300);position:relative;isolation:isolate;min-height:100svh;padding:clamp(7rem,11vw,10rem) clamp(1.25rem,5vw,6rem) 3rem;overflow:hidden;background:var(--ba-bg);color:var(--ba-ink)}
  .before-after--light{--ba-bg:var(--paper);--ba-ink:var(--ink);--ba-muted:rgba(16,35,31,.62);--ba-line:rgba(16,35,31,.18);--ba-accent:var(--pine-700)}
  .before-after__rules{position:absolute;z-index:-1;inset:0;display:grid;grid-template-columns:repeat(4,1fr);opacity:.55;pointer-events:none}.before-after__rules i{border-left:1px solid var(--ba-line)}.before-after__rules i:last-child{border-right:1px solid var(--ba-line)}
  .before-after__header{display:grid;grid-template-columns:.6fr 1.45fr .75fr;gap:clamp(2rem,5vw,6rem);align-items:end;margin:0 auto clamp(3rem,6vw,6rem);max-width:112rem}.before-after__eyebrow{align-self:start;display:flex;gap:.9rem;margin:.55rem 0 0;color:var(--ba-accent);font-size:.6rem;font-weight:900;line-height:1.45;letter-spacing:.14em;text-transform:uppercase}.before-after__eyebrow span{color:var(--ba-ink)}.before-after h2{margin:0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(4.4rem,7.4vw,8.8rem);font-weight:500;line-height:.82;letter-spacing:-.065em}.before-after h2 em{display:block;color:var(--ba-accent);font-weight:500}.before-after__intro{max-width:27rem;margin:0;color:var(--ba-muted);font-size:clamp(.86rem,1.05vw,1rem);line-height:1.72}
  .before-after__stage{display:grid;grid-template-columns:minmax(0,1.42fr) minmax(18rem,.58fr);gap:clamp(1rem,3vw,3rem);align-items:stretch;margin:0 auto;max-width:112rem}.before-after--reverse .before-after__visual{order:2}.before-after--reverse .before-after__details{order:1}
  .before-after__visual{position:relative;min-height:clamp(33rem,65svh,49rem);margin:0;overflow:hidden;border:1px solid var(--ba-line);border-radius:clamp(.75rem,1.2vw,1.4rem);background:#20312b;box-shadow:0 2.6rem 7rem rgba(5,25,21,.16);touch-action:pan-y;cursor:ew-resize}.before-after__image{position:absolute;inset:0;background-repeat:no-repeat;background-size:200% 100%;filter:saturate(.88) contrast(1.02)}.before-after__image--before{background-position:left center}.before-after__image--after{background-position:right center;clip-path:inset(0 0 0 var(--split))}.before-after__veil{position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,29,25,.08),transparent 35%,rgba(6,29,25,.42));pointer-events:none}.before-after__divider{position:absolute;z-index:3;top:0;bottom:0;left:var(--split);width:1px;background:rgba(245,240,231,.92);pointer-events:none}.before-after__divider i{position:absolute;top:50%;left:50%;width:3.4rem;height:3.4rem;border:1px solid rgba(245,240,231,.9);border-radius:50%;background:rgba(6,29,25,.72);box-shadow:0 0 0 .45rem rgba(6,29,25,.18);transform:translate(-50%,-50%);backdrop-filter:blur(12px)}.before-after__divider i::before,.before-after__divider i::after{position:absolute;top:50%;width:.45rem;height:.45rem;border-top:1px solid var(--porcelain);border-left:1px solid var(--porcelain);content:''}.before-after__divider i::before{left:.75rem;transform:translateY(-50%) rotate(-45deg)}.before-after__divider i::after{right:.75rem;transform:translateY(-50%) rotate(135deg)}.before-after__divider span{position:absolute;top:calc(50% + 2.5rem);left:50%;color:var(--porcelain);font-size:.46rem;font-weight:900;letter-spacing:.14em;transform:translateX(-50%)}
  .before-after__state{position:absolute;z-index:2;top:1rem;padding:.75rem .9rem;background:rgba(6,29,25,.68);color:var(--porcelain);font-size:.53rem;font-weight:900;letter-spacing:.15em;backdrop-filter:blur(12px)}.before-after__state--before{left:1rem}.before-after__state--after{right:1rem}.before-after__range{position:absolute;z-index:5;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize}
  .before-after__details{display:grid;grid-template-rows:1fr 1fr auto;border-top:1px solid var(--ba-line);border-bottom:1px solid var(--ba-line)}.before-after__details article{display:grid;align-content:end;padding:clamp(1.4rem,3vw,2.75rem) 0;border-bottom:1px solid var(--ba-line)}.before-after__details article>span,.before-after__case small{color:var(--ba-accent);font-size:.52rem;font-weight:900;letter-spacing:.15em}.before-after__details h3{margin:.65rem 0 .75rem;font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,3.1vw,3.8rem);font-weight:500;line-height:.92;letter-spacing:-.045em}.before-after__details p{max-width:25rem;margin:0;color:var(--ba-muted);font-size:.78rem;line-height:1.6}.before-after__case{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;padding:1.35rem 0}.before-after__case strong{font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;font-weight:500;line-height:1.2}
  .before-after__footer{display:grid;grid-template-columns:auto 1fr auto;gap:1.2rem;align-items:center;margin:1.5rem auto 0;max-width:112rem;color:var(--ba-muted);font-size:.49rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.before-after__footer i{height:1px;background:var(--ba-line)}.before-after__footer strong{color:var(--ba-ink);font-weight:800}
  @media(max-width:68rem){.before-after{min-height:0;padding:8rem 2.3rem 2.5rem}.before-after__header{grid-template-columns:.55fr 1.45fr;gap:2rem;margin-bottom:4rem}.before-after__intro{grid-column:2}.before-after h2{font-size:clamp(4.1rem,8vw,6.6rem)}.before-after__stage{grid-template-columns:minmax(0,1.28fr) minmax(16rem,.72fr);gap:1.5rem}.before-after__visual{min-height:58svh}.before-after__details h3{font-size:clamp(2rem,3.6vw,3rem)}.before-after__details article{padding:1.75rem 0}}
  @media(max-width:45rem){.before-after{padding:6rem 1rem 2rem}.before-after__rules{grid-template-columns:repeat(2,1fr)}.before-after__rules i:nth-child(n+3){display:none}.before-after__header{display:block;margin-bottom:2.5rem}.before-after__eyebrow{margin-bottom:1.5rem}.before-after h2{font-size:clamp(3.7rem,17vw,5.3rem)}.before-after__intro{margin-top:1.5rem;font-size:.78rem}.before-after__stage{display:block}.before-after--reverse .before-after__visual{order:initial}.before-after--reverse .before-after__details{order:initial}.before-after__visual{min-height:55svh;border-radius:.75rem}.before-after__divider i{width:3rem;height:3rem}.before-after__details{grid-template-columns:1fr 1fr;grid-template-rows:auto auto;margin-top:1rem}.before-after__details article{min-height:13rem;padding:1.5rem .85rem}.before-after__details article:first-child{border-right:1px solid var(--ba-line)}.before-after__details h3{font-size:1.75rem}.before-after__details p{font-size:.7rem}.before-after__case{grid-column:1/-1;padding:1.25rem .85rem}.before-after__footer{grid-template-columns:1fr auto;margin-top:1rem;line-height:1.45}.before-after__footer i{display:none}.before-after__footer strong{text-align:right}}
  @media(prefers-reduced-motion:reduce){.before-after__image,.before-after__divider{transition:none!important}}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-before-after]').forEach((section) => {
    const range = section.querySelector<HTMLInputElement>('[data-before-after-range]');
    if (!range || section.dataset.ready === 'true') return;
    section.dataset.ready = 'true';
    let directControlUntil = 0;

    const setSplit = (value: number, immediate = false) => {
      const safe = Math.max(12, Math.min(88, value));
      range.value = String(Math.round(safe));
      if (immediate) {
        gsap.killTweensOf(section);
        section.style.setProperty('--split', `${safe}%`);
      } else {
        gsap.to(section, { '--split': `${safe}%`, duration: .34, ease: 'power2.out', overwrite: true });
      }
    };

    range.addEventListener('input', () => {
      directControlUntil = performance.now() + 1800;
      setSplit(Number(range.value), true);
    });

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ScrollTrigger.create({
        trigger: section,
        start: 'top 82%',
        end: 'bottom 24%',
        onUpdate: (self) => {
          if (performance.now() < directControlUntil) return;
          setSplit(24 + self.progress * 52);
        },
      });
      gsap.from(section.querySelectorAll('.before-after__header > *, .before-after__details > *'), {
        y: 34,
        opacity: 0,
        duration: .9,
        stagger: .08,
        ease: 'power3.out',
        scrollTrigger: { trigger: section, start: 'top 74%', once: true },
      });
    }
  });
</script>
