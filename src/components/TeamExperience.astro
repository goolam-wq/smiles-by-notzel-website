<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    gsap.from('[data-team-hero] .team-kicker, [data-team-hero] h1, [data-team-hero] .team-hero__intro, [data-team-hero] .team-pill', { y: 35, opacity: 0, duration: .9, stagger: .1, ease: 'power3.out', delay: .2 });
    gsap.from('[data-team-hero] .team-hero__image', { scale: 1.08, duration: 1.8, ease: 'power3.out' });
    document.querySelectorAll<HTMLElement>('[data-team-reveal]').forEach((section) => {
      gsap.from(section.children, { y: 34, opacity: 0, duration: .75, stagger: .08, ease: 'power2.out', scrollTrigger: { trigger: section, start: 'top 83%', once: true } });
    });
  }

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-doctor-tab]')];
  const images = [...document.querySelectorAll<HTMLElement>('[data-doctor-image]')];
  const copies = [...document.querySelectorAll<HTMLElement>('[data-doctor-copy]')];
  const count = document.querySelector<HTMLElement>('[data-doctor-count]');
  const activateDoctor = (index: number) => {
    tabs.forEach((tab, item) => tab.setAttribute('aria-selected', item === index ? 'true' : 'false'));
    images.forEach((image, item) => image.classList.toggle('active', item === index));
    copies.forEach((copy, item) => copy.classList.toggle('active', item === index));
    if (count) count.textContent = `${String(index + 1).padStart(2, '0')} / 03`;
  };
  tabs.forEach((tab, index) => tab.addEventListener('click', () => activateDoctor(index)));
</script>
