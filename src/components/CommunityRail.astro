---
const chicago=['Chicago Heights','South Chicago Heights','Steger','Sauk Village','Lynwood','Glenwood','Ford Heights','Olympia Fields','Park Forest','Homewood','Flossmoor','Hazel Crest','Matteson','Crete','Country Club Hills','Richton Park'];
const mokena=['Mokena','Frankfort','New Lenox','Tinley Park','Orland Park','Homer Glen','Lockport','Manhattan','Frankfort Square','Orland Hills'];
---

<section class="community-rail" id="community-map" data-community-rail>
  <div class="community-rail__sticky">
    <div class="community-rail__head"><p class="eyebrow">The communities between</p><h2>Near is more than<br /><em>a distance.</em></h2><p>It is familiar people, practical hours and a care plan that can move with your week.</p></div>
    <div class="community-rail__line" aria-hidden="true"><i data-community-progress></i><span data-community-marker>01</span></div>
    <article class="community-column community-column--chicago" data-community-column="chicago"><header><span>01</span><div><h3>Chicago Heights</h3><p>16 mapped communities</p></div></header><div>{chicago.map((area,index)=><span><i>{String(index+1).padStart(2,'0')}</i>{area}</span>)}</div></article>
    <article class="community-column community-column--mokena" data-community-column="mokena"><header><span>02</span><div><h3>Mokena</h3><p>10 mapped communities</p></div></header><div>{mokena.map((area,index)=><span><i>{String(index+1).padStart(2,'0')}</i>{area}</span>)}</div></article>
    <footer><span>500 Ashland Ave</span><b>One connected team</b><span>19160 88th Avenue</span></footer>
  </div>
</section>

<style>
  .community-rail{height:320svh;background:var(--pine-950);color:var(--porcelain)}.community-rail__sticky{position:sticky;top:0;height:100svh;overflow:hidden;background:linear-gradient(90deg,transparent 49.94%,rgba(158,215,196,.14) 50%,transparent 50.06%)}.community-rail__head{position:absolute;z-index:4;top:9vh;left:5vw;max-width:42rem}.community-rail .eyebrow{color:var(--mint-300)}.community-rail__head h2{margin:1rem 0;font-family:Georgia,serif;font-size:clamp(4.3rem,7vw,7.8rem);font-weight:400;line-height:.82;letter-spacing:-.07em}.community-rail__head h2 em{color:var(--mint-300);font-weight:400}.community-rail__head>p:last-child{max-width:28rem;color:rgba(245,240,231,.58);line-height:1.65}.community-rail__line{position:absolute;z-index:5;top:8vh;bottom:7vh;left:50%;width:1px;background:rgba(245,240,231,.16)}.community-rail__line i{position:absolute;top:0;left:0;width:100%;height:100%;background:var(--mint-300);transform:scaleY(0);transform-origin:top}.community-rail__line span{position:absolute;top:0;left:50%;display:grid;width:2.7rem;aspect-ratio:1;place-items:center;border-radius:50%;background:var(--mint-300);color:var(--pine-950);font-size:.56rem;font-weight:900;transform:translate(-50%,-50%)}.community-column{position:absolute;z-index:3;top:50%;width:38vw;will-change:transform,opacity}.community-column--chicago{left:5vw}.community-column--mokena{right:5vw}.community-column header{display:flex;margin-bottom:.85rem;align-items:end;gap:1rem;border-bottom:1px solid rgba(245,240,231,.22);padding-bottom:.7rem}.community-column header>span{color:var(--mint-300);font-size:.58rem}.community-column h3{margin:0;font-family:Georgia,serif;font-size:clamp(2.7rem,4vw,4.8rem);font-weight:400}.community-column header p{margin:.25rem 0 0;color:rgba(245,240,231,.48);font-size:.58rem;text-transform:uppercase}.community-column>div{display:grid;grid-template-columns:1fr 1fr;gap:0 1rem}.community-column>div>span{display:grid;padding:.34rem 0;grid-template-columns:2.2rem 1fr;align-items:center;border-bottom:1px solid rgba(245,240,231,.12);font-family:Georgia,serif;font-size:clamp(.9rem,1.12vw,1.1rem);line-height:1.15}.community-column>div i{color:var(--mint-300);font-family:sans-serif;font-size:.5rem;font-style:normal}.community-column--mokena{transform:translateY(42vh);opacity:.16}.community-rail footer{position:absolute;z-index:5;right:5vw;bottom:1.2rem;left:5vw;display:flex;justify-content:space-between;color:rgba(245,240,231,.5);font-size:.52rem;letter-spacing:.1em;text-transform:uppercase}.community-rail footer b{color:var(--mint-300)}
  @media(max-width:68rem){.community-rail{height:300svh}.community-rail__head{top:8rem}.community-column{top:50%;width:41vw}.community-column>div{grid-template-columns:1fr 1fr}.community-column>div>span{padding:.4rem 0;grid-template-columns:1.7rem 1fr;font-size:.88rem}.community-column h3{font-size:3.3rem}}
  @media(max-width:46rem){.community-rail{height:310svh}.community-rail__sticky{background:none}.community-rail__head{top:7.5rem;right:1rem;left:1rem}.community-rail__head h2{font-size:clamp(3.7rem,15vw,4.8rem)}.community-rail__head>p:last-child{font-size:.72rem}.community-rail__line{top:48%;bottom:4rem;left:1.25rem}.community-column{top:52%;right:1rem;left:3rem;width:auto}.community-column--mokena{right:1rem;left:3rem}.community-column h3{font-size:2.8rem}.community-column>div{grid-template-columns:1fr 1fr}.community-column>div>span{grid-template-columns:1.6rem 1fr;font-size:.82rem}.community-rail footer{right:1rem;bottom:1.2rem;left:3rem}.community-rail footer span{display:none}}
  @media(prefers-reduced-motion:reduce){.community-rail{height:auto}.community-rail__sticky{position:relative;height:auto;min-height:100svh;padding:8rem 1rem}.community-rail__head,.community-column,.community-rail footer{position:relative;inset:auto;width:auto;margin-bottom:4rem;opacity:1;transform:none}.community-rail__line{display:none}}
</style>

<script>
  import gsap from 'gsap';import {ScrollTrigger} from 'gsap/ScrollTrigger';gsap.registerPlugin(ScrollTrigger);
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){const marker=document.querySelector<HTMLElement>('[data-community-marker]');const tl=gsap.timeline({scrollTrigger:{trigger:'[data-community-rail]',start:'top top',end:'bottom bottom',scrub:.85,invalidateOnRefresh:true,onUpdate:self=>{if(marker)marker.textContent=self.progress<.54?'01':'02';}}});tl.to('[data-community-progress]',{scaleY:1,duration:1,ease:'none'},0).to('[data-community-marker]',{top:'100%',duration:1,ease:'none'},0).to('[data-community-column="chicago"]',{x:'-46vw',opacity:0,duration:.22,ease:'sine.inOut'},.4).to('[data-community-column="mokena"]',{y:0,opacity:1,duration:.22,ease:'sine.inOut'},.46);}
</script>
