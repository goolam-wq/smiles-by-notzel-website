---
const {
  eyebrow = 'Ready when you are',
  title = 'Thoughtful care starts with a real conversation.',
  phone = '(708) 755-1333',
  phoneHref = 'tel:+17087551333',
} = Astro.props;
---

<footer class="hub-footer" id="contact">
  <div class="container-shell hub-footer__inner">
    <header>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <div class="hub-footer__quick">
        <a href={phoneHref}>Call {phone}</a>
        <a href="mailto:nadia.ashland@gmail.com">Email the team ↗</a>
      </div>
    </header>

    <form class="hub-form" action="https://formsubmit.co/ajax/nadia.ashland@gmail.com" method="POST" data-hub-form>
      <input type="hidden" name="_subject" value="New website appointment request" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <label class="hub-form__trap" aria-hidden="true">Leave this empty<input name="_honey" tabindex="-1" autocomplete="off" /></label>
      <label><span>Your name</span><input name="name" type="text" autocomplete="name" required placeholder="First and last name" /></label>
      <label><span>Phone</span><input name="phone" type="tel" autocomplete="tel" required placeholder="(000) 000-0000" /></label>
      <label><span>Email</span><input name="email" type="email" autocomplete="email" required placeholder="you@email.com" /></label>
      <label><span>Preferred office</span><select name="office" required><option value="" selected disabled>Select a location</option><option>Chicago Heights</option><option>Mokena</option><option>No preference</option></select></label>
      <button type="submit"><span>Send request</span><i>↗</i></button>
      <div class="hub-form__status"><p>Scheduling request only—please don’t include confidential medical information.</p><output aria-live="polite"></output></div>
    </form>

    <div class="hub-footer__nav">
      <div><strong>Smiles by Noetzel</strong><span>Ashland Dental &amp; Wellness Center</span></div>
      <nav aria-label="Footer"><a href="/services/">Services</a><a href="/service-areas/">Service Areas</a><a href="/pricing/">Pricing</a><a href="/about/">About</a><a href="/#faq">FAQ</a></nav>
    </div>

    <div class="hub-footer__details">
      <section><span>01 · Chicago Heights</span><a class="phone" href="tel:+17087551333">(708) 755-1333</a><a href="https://maps.app.goo.gl/htHhNrnhbbu2WNR17">500 Ashland Ave, Suite #2<br />Chicago Heights, IL 60411 ↗</a><p>Mon–Thu 7:30 AM–7 PM · Fri 7:30 AM–12 PM<br />Sat 8 AM–12 PM</p></section>
      <section><span>02 · Mokena</span><a class="phone" href="tel:+17084797733">(708) 479-7733</a><a href="https://www.google.com/maps/search/?api=1&query=19160+88th+Avenue+Mokena+IL+60448">19160 88th Avenue, Mokena, IL 60448 ↗</a><p>Mon 8 AM–7 PM · Thu 9:30 AM–6 PM<br />Every other Sat 8 AM–12 PM*</p></section>
      <section><span>Connect</span><a href="mailto:nadia.ashland@gmail.com">nadia.ashland@gmail.com ↗</a><nav aria-label="Social media"><a href="https://www.facebook.com/ashlanddentalcenter/">Facebook ↗</a><a href="https://www.instagram.com/ashlanddentalcenter/">Instagram ↗</a></nav><p>*Saturday hours may vary; please call ahead.</p></section>
    </div>
  </div>
</footer>

<style>
  .hub-footer{position:relative;overflow:hidden;padding:clamp(7rem,10vw,10rem) 0 2rem;background:var(--pine-950);color:var(--porcelain)}.hub-footer__inner{position:relative;z-index:1}.hub-footer header{display:grid;grid-template-columns:1.35fr .65fr;gap:2rem;align-items:end}.hub-footer .eyebrow{grid-column:1/-1;color:var(--mint-300)}.hub-footer h2{max-width:58rem;margin:1.5rem 0 0;font-family:Georgia,serif;font-size:clamp(3.6rem,7vw,7.8rem);font-weight:400;line-height:.86;letter-spacing:-.065em}.hub-footer__quick{display:grid;gap:.8rem;justify-self:end;text-align:right;font-size:.66rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.hub-footer__quick a{padding-bottom:.35rem;border-bottom:1px solid rgba(245,240,231,.35)}
  .hub-form{display:grid;margin:clamp(3rem,6vw,5rem) 0 4rem;padding:1.25rem 0;grid-template-columns:1.1fr .9fr 1.1fr 1fr auto;gap:1rem;align-items:end;border-top:1px solid rgba(245,240,231,.22);border-bottom:1px solid rgba(245,240,231,.22)}.hub-form__trap{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(1px,1px,1px,1px)!important}.hub-form label{display:grid;gap:.55rem}.hub-form label span{font-size:.56rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.hub-form input,.hub-form select{width:100%;height:2.65rem;border:0;border-bottom:1px solid rgba(245,240,231,.45);outline:0;background:transparent;color:var(--porcelain);font:inherit;font-size:.78rem}.hub-form input::placeholder{color:rgba(245,240,231,.6)}.hub-form option{background:var(--pine-950)}.hub-form button{display:flex;min-width:9.5rem;height:3rem;padding:.45rem .45rem .45rem 1rem;align-items:center;justify-content:space-between;border:0;border-radius:999px;background:var(--porcelain);color:var(--pine-950);font-size:.55rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.hub-form button i{display:grid;width:2rem;aspect-ratio:1;place-items:center;border-radius:50%;background:var(--mint-300);font-style:normal}.hub-form__status{display:flex;grid-column:1/-1;justify-content:space-between;gap:1rem;color:rgba(245,240,231,.58);font-size:.5rem}.hub-form__status p{margin:0}.hub-form__status output{color:var(--mint-300)}
  .hub-footer__nav{display:grid;padding:1rem 0;grid-template-columns:1fr auto;gap:2rem;border-top:1px solid rgba(245,240,231,.18);border-bottom:1px solid rgba(245,240,231,.18);font-size:.54rem;letter-spacing:.09em;text-transform:uppercase}.hub-footer__nav>div{display:grid;gap:.25rem}.hub-footer__nav span{opacity:.5}.hub-footer__nav nav{display:flex;gap:1.2rem;align-items:center}.hub-footer__details{display:grid;padding-top:1.5rem;grid-template-columns:1fr 1fr .8fr;gap:3rem}.hub-footer__details section{display:grid;gap:.35rem;align-content:start}.hub-footer__details section>span{color:var(--mint-300);font-size:.5rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.hub-footer__details a{color:rgba(245,240,231,.75);font-size:.58rem;line-height:1.45}.hub-footer__details .phone{color:var(--porcelain);font-family:Georgia,serif;font-size:1.25rem}.hub-footer__details p{margin:.2rem 0 0;color:rgba(245,240,231,.5);font-size:.5rem;line-height:1.55}.hub-footer__details nav{display:flex;gap:1rem;text-transform:uppercase}
  @media(max-width:68rem){.hub-footer header{grid-template-columns:1fr}.hub-footer__quick{justify-self:start;text-align:left}.hub-form{grid-template-columns:1fr 1fr}.hub-form button{width:100%}.hub-footer__details{gap:1.5rem}.hub-footer__nav nav{flex-wrap:wrap;justify-content:flex-end}}
  @media(max-width:46rem){.hub-footer{padding-top:6.5rem}.hub-footer h2{font-size:clamp(3rem,14vw,4.3rem)}.hub-form{grid-template-columns:1fr 1fr;margin-bottom:3rem}.hub-form__status{display:grid}.hub-footer__nav{grid-template-columns:1fr}.hub-footer__nav nav{justify-content:flex-start}.hub-footer__details{grid-template-columns:1fr 1fr;gap:1.5rem .8rem}.hub-footer__details section:last-child{grid-column:1/-1}}
</style>

<script>
  const form=document.querySelector<HTMLFormElement>('[data-hub-form]');
  if(form){const button=form.querySelector<HTMLButtonElement>('button');const label=button?.querySelector('span');const status=form.querySelector('output');form.addEventListener('submit',async(event)=>{event.preventDefault();if(!form.reportValidity())return;if(button)button.disabled=true;if(label)label.textContent='Sending…';if(status)status.textContent='Sending your request…';try{const response=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Submission failed');form.reset();if(status)status.textContent='Thank you—your request was sent.'}catch{if(status)status.textContent='We couldn’t send that. Please call the team.'}finally{if(button)button.disabled=false;if(label)label.textContent='Send request'}})}
</script>
