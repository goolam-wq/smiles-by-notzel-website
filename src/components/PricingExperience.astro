  @media(prefers-reduced-motion:reduce){.pricing-hero__media img{height:100%}.pricing-factors__copy,.pricing-faq header,.pricing-directory__toolbar,.pricing-directory__categories{position:relative;top:auto}}
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLElement>('[data-pricing-hero]');
  if (!reduceMotion && hero) {
    gsap.from('[data-pricing-hero-copy] > *', { y: 34, opacity: 0, duration: .9, stagger: .1, ease: 'power3.out' });
    gsap.from('[data-pricing-hero-media]', { y: 42, clipPath: 'inset(0 0 100% 0 round 1.2rem)', duration: 1.15, delay: .12, ease: 'power3.out' });
    gsap.from('.pricing-hero__rail', { y: 42, opacity: 0, duration: 1, delay: .24, ease: 'power3.out' });
    gsap.to('[data-pricing-hero-media] img', { yPercent: -4, scale: 1.035, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: .7, invalidateOnRefresh: true } });
    gsap.from('[data-pricing-hero-ledger] article', { x: 22, opacity: .35, stagger: .08, ease: 'none', scrollTrigger: { trigger: '[data-pricing-hero-ledger]', start: 'top 88%', end: 'bottom 58%', scrub: .55, invalidateOnRefresh: true } });
  }

  const modeCopy = {
    fixed: { label: 'Fixed amount', amount: '$5,495', detail: 'Complete clear-aligner case' },
    monthly: { label: 'Monthly view', amount: '$153', detail: 'Per month · 36 months' },
    yearly: { label: 'Yearly view', amount: '$5,495', detail: 'Complete-case treatment basis' },
  } as const;
  document.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach((button) => button.addEventListener('click', () => {
    const key = button.dataset.modeButton as keyof typeof modeCopy;
    document.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach((item) => { const active = item === button; item.classList.toggle('is-active', active); item.setAttribute('aria-selected', String(active)); });
    const amount = document.querySelector<HTMLElement>('[data-mode-amount]');
    const label = document.querySelector<HTMLElement>('[data-mode-label]');
    const detail = document.querySelector<HTMLElement>('[data-mode-detail]');
    if (amount && label && detail) gsap.timeline().to([amount, label, detail], { y: 14, opacity: 0, duration: .18 }).add(() => { amount.textContent = modeCopy[key].amount; label.textContent = modeCopy[key].label; detail.textContent = modeCopy[key].detail; }).to([amount, label, detail], { y: 0, opacity: 1, duration: .3, stagger: .04 });
  }));

  let activeCategory = 'all';
  let activeMode: 'fixed' | 'monthly' | 'yearly' = 'fixed';
  const search = document.querySelector<HTMLInputElement>('[data-pricing-search]');
  const groups = [...document.querySelectorAll<HTMLElement>('[data-pricing-category]')];
  const rows = [...document.querySelectorAll<HTMLElement>('[data-pricing-row]')];
  const empty = document.querySelector<HTMLElement>('[data-pricing-empty]');
  const applyFilters = () => {
    const query = (search?.value || '').trim().toLowerCase();
    let visibleCount = 0;
    groups.forEach((group) => {
      const categoryMatch = activeCategory === 'all' || group.dataset.pricingCategory === activeCategory;
      let groupCount = 0;
      group.querySelectorAll<HTMLElement>('[data-pricing-row]').forEach((row) => {
        const match = categoryMatch && (!query || (row.dataset.search || '').includes(query));
        row.hidden = !match;
        if (match) { groupCount += 1; visibleCount += 1; }
      });
      group.hidden = groupCount === 0;
    });
    if (empty) empty.hidden = visibleCount > 0;
    if (!reduceMotion) requestAnimationFrame(() => ScrollTrigger.refresh());
  };
  document.querySelectorAll<HTMLButtonElement>('[data-category-filter]').forEach((button) => button.addEventListener('click', () => {
    activeCategory = button.dataset.categoryFilter || 'all';
    document.querySelectorAll('[data-category-filter]').forEach((item) => item.classList.toggle('is-active', item === button));
    applyFilters();
  }));
  search?.addEventListener('input', applyFilters);
  document.querySelectorAll<HTMLButtonElement>('[data-directory-mode]').forEach((button) => button.addEventListener('click', () => {
    activeMode = (button.dataset.directoryMode || 'fixed') as typeof activeMode;
    document.querySelectorAll('[data-directory-mode]').forEach((item) => item.classList.toggle('is-active', item === button));
    rows.forEach((row) => { const price = row.querySelector<HTMLElement>('strong'); if (price) price.textContent = price.dataset[`price${activeMode.charAt(0).toUpperCase()}${activeMode.slice(1)}` as keyof DOMStringMap] || ''; });
  }));

  if (!reduceMotion) {
    document.querySelectorAll<HTMLElement>('[data-reveal-section]').forEach((section) => gsap.from(section.children, { y: 54, opacity: 0, duration: .85, stagger: .07, ease: 'power3.out', scrollTrigger: { trigger: section, start: 'top 78%', once: true } }));
    gsap.from('[data-factor]', { x: 55, opacity: 0, duration: .8, stagger: .12, ease: 'power3.out', scrollTrigger: { trigger: '[data-pricing-factors]', start: 'top 70%', once: true } });
  }
</script>
