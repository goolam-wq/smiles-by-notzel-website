<script>
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const heroVideoToggle = document.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
  const heroVideoIcon = document.querySelector<HTMLElement>('[data-hero-video-icon]');
  const heroVideoCard = document.querySelector<HTMLElement>('[data-video-card]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let heroCardVisible = false;
  let heroExitTimer: number | undefined;

  const updateHeroVideoControl = () => {
    if (!heroVideo || !heroVideoToggle || !heroVideoIcon) return;
    const isAudibleAndPlaying = !heroVideo.paused && !heroVideo.muted;
    heroVideoIcon.textContent = isAudibleAndPlaying ? '❚❚' : '▶';
    heroVideoToggle.setAttribute(
      'aria-label',
      isAudibleAndPlaying ? 'Pause the hero film' : 'Play the hero film with voiceover'
    );
  };

  const isHeroCardVisible = () => {
    if (!heroVideoCard) return false;
    const rect = heroVideoCard.getBoundingClientRect();
    return rect.bottom > window.innerHeight * 0.08 && rect.top < window.innerHeight * 0.92;
  };

  const resetHeroVideo = (resumeMutedPreview = false) => {
    if (!heroVideo) return;
    heroVideo.pause();
    heroVideo.loop = true;
    heroVideo.defaultMuted = true;
    heroVideo.muted = true;
    heroVideo.setAttribute('muted', '');
    heroVideo.currentTime = 0;
    heroVideo.dispatchEvent(new Event('volumechange'));

    if (resumeMutedPreview && !reducedMotion.matches && !document.hidden) {
      void heroVideo.play().catch(() => {});
    }
  };

  const silenceOtherSiteVideos = () => {
    document.querySelectorAll<HTMLVideoElement>('[data-site-video]').forEach((video) => {
      if (video === heroVideo) return;
      video.pause();
      video.loop = true;
      video.defaultMuted = true;
      video.muted = true;
      video.setAttribute('muted', '');
      video.currentTime = 0;
      video.dispatchEvent(new Event('volumechange'));
    });
  };

  if (heroVideo && heroVideoToggle) {
    if (reducedMotion.matches) heroVideo.pause();

    heroVideoToggle.addEventListener('click', async () => {
      if (heroVideo.paused || heroVideo.muted) {
        heroCardVisible = isHeroCardVisible();
        window.clearTimeout(heroExitTimer);
        silenceOtherSiteVideos();
        heroVideo.pause();
        heroVideo.loop = false;
        heroVideo.removeAttribute('muted');
        heroVideo.defaultMuted = false;
        heroVideo.muted = false;
        heroVideo.currentTime = 0;
        try {
          await heroVideo.play();
        } catch {
          heroVideo.controls = true;
        }
      } else {
        heroVideo.pause();
      }
      updateHeroVideoControl();
    });

    heroVideo.addEventListener('play', updateHeroVideoControl);
    heroVideo.addEventListener('pause', updateHeroVideoControl);
    heroVideo.addEventListener('volumechange', updateHeroVideoControl);
    heroVideo.addEventListener('ended', () => resetHeroVideo(heroCardVisible));

    if (heroVideoCard) {
      const heroVideoObserver = new IntersectionObserver(
        ([entry]) => {
          heroCardVisible = Boolean(entry?.isIntersecting && entry.intersectionRatio > 0.08) || isHeroCardVisible();
          window.clearTimeout(heroExitTimer);
          if (!heroCardVisible) {
            heroExitTimer = window.setTimeout(() => {
              heroCardVisible = isHeroCardVisible();
              if (!heroCardVisible) resetHeroVideo(false);
            }, 220);
          } else if (heroVideo.muted && heroVideo.paused) {
            resetHeroVideo(true);
          }
        },
        { threshold: [0, 0.08, 0.35] }
      );
      heroVideoObserver.observe(heroVideoCard);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        resetHeroVideo(false);
      } else if (heroCardVisible && heroVideo.muted) {
        resetHeroVideo(true);
      }
    });
    updateHeroVideoControl();
  }
</script>
