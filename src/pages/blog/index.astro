  <body>
    <Navbar mediaImage="/images/generated/unique/blog/blog-hub-nav-editorial.webp" mediaAlt="A care coordinator preparing dental education materials at the welcome desk" />
    <main>
      <BlogHubExperience />
      <HubFooter eyebrow="A question worth bringing in?" title="Good information should make the next conversation clearer." />
    </main>
  </body>
