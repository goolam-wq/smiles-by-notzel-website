---
import Navbar from '../../components/Navbar.astro';
import TreatmentDetail from '../../components/TreatmentDetail.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Explore the appointment-based ReCODE 2.0 dental program at Smiles by Noetzel, including coordinated dental baseline, pricing and both offices." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>ReCODE 2.0 Dental Program | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/nav-recode-2-0-dental-program.webp" mediaAlt="Dr. Ilenne Noetzel explaining an organized dental baseline and clearly limited dental role" />
    <main>
      <TreatmentDetail kind="recode-2-0-dental-program" />
      <BeforeAfterStory id="before-after-recode-2-0-dental-program" tone="light" reverse number="06" eyebrow="Illustrative coordination pathway · ReCODE 2.0 dental program" title="From scattered dental questions." emphasis="To an organized baseline."
        intro="This illustrative pathway shows how dental questions and findings may be organized within a clearly limited dental role. It is not an actual patient case, cognitive improvement, medical diagnosis or promised health outcome."
        image="/images/generated/before-after-recode-2-0-dental-program-v1.webp" imageAlt="Illustrative comparison of scattered dental questions and an organized dental baseline with coordinated next steps"
        beforeLabel="Before dental coordination" beforeDetail="Dental questions, relevant records, outside care context and the scope of the dental role have not yet been organized."
        afterLabel="Illustrative organized baseline" afterDetail="The simulated view represents organized dental findings and coordination—not cognitive improvement, medical treatment or a guaranteed outcome."
        caseNote="Illustrative dental-coordination pathway · not an actual cognitive or medical outcome · scope varies" />
      <HubFooter eyebrow="Ready to organize the dental baseline?" title="Begin with listening, office-confirmed findings and a clearly limited dental role." />
    </main>
  </body>
</html>
