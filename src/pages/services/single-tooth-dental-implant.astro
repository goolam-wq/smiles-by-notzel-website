---
import Navbar from '../../components/Navbar.astro';
import TreatmentDetail from '../../components/TreatmentDetail.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Explore single-tooth dental implant planning at Smiles by Noetzel, including candidacy, surgical and restorative stages, pricing and both Illinois offices." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>Single-Tooth Dental Implant | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/nav-single-tooth-dental-implant.webp" mediaAlt="A dentist and patient reviewing a single-tooth implant plan" />
    <main>
      <TreatmentDetail kind="single-tooth-dental-implant" />
      <BeforeAfterStory id="before-after-single-tooth-dental-implant" tone="dark" reverse number="06" eyebrow="Illustrative planning visualization · missing-tooth pathway" title="From an open space." emphasis="To a connected plan."
        intro="This simulated planning visualization explains how one missing-tooth space may move from site assessment to a coordinated implant and restoration pathway. It is not an actual patient outcome, and candidacy or a specific result is not guaranteed."
        image="/images/generated/before-after-single-tooth-dental-implant-v1.webp" imageAlt="Illustrative simulated comparison of a missing-tooth space and a planned single-tooth implant restoration"
        beforeLabel="Before site assessment" beforeDetail="The space, surrounding teeth, gums, bite and available foundation still need to be evaluated."
        afterLabel="Illustrative restored-tooth plan" afterDetail="The simulated view represents a coordinated implant, abutment and crown concept after candidacy and sequence are confirmed—not an actual patient result."
        caseNote="Illustrative simulated example · not an actual patient case · treatment and results vary" />
      <HubFooter eyebrow="Want to understand the replacement pathway?" title="Begin with the site, the final tooth and the sequence between." />
    </main>
  </body>
</html>
