---
import Navbar from '../../components/Navbar.astro';
import DetailExperience from '../../components/DetailExperience.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Explore same-day emergency and comfort dentistry at Smiles by Noetzel, including nitrous oxide and virtual-reality anxiety support." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>Emergency &amp; Comfort Dentistry | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/nav-emergency-comfort.webp" mediaAlt="A care coordinator answering an urgent patient call" />
    <main>
      <DetailExperience kind="emergency-comfort" />
      <BeforeAfterStory id="before-after-emergency-comfort" tone="dark" number="04" eyebrow="Same-day story · comfort first" title="Relief." emphasis="Still in control."
        intro="Emergency care changes more than pain. The right assessment, pacing and comfort support can turn an alarming moment into a next step that feels understandable."
        image="/images/generated/before-after-emergency-comfort-v2.webp" imageAlt="The same emergency patient before assessment with tooth pain and after assessment feeling calm and relieved"
        beforeLabel="Before assessment" beforeDetail="A sudden toothache, uncertainty and anxiety made the visit feel larger than the problem itself."
        afterLabel="After a clear next step" afterDetail="Prompt assessment and comfort support reduced the noise around the decision and made follow-up feel manageable."
        caseNote="Same-day assessment + comfort care" />
      <HubFooter eyebrow="Need care that can begin today?" title="Tell us what changed. We’ll help make the next step clear." />
    </main>
  </body>
</html>
