---
import Navbar from '../../components/Navbar.astro';
import TreatmentDetail from '../../components/TreatmentDetail.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Explore implant-supported bridge planning at Smiles by Noetzel, including candidacy, surgical and restorative stages, pricing and both Illinois offices." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>Implant-Supported Bridge | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/nav-implant-supported-bridge.webp" mediaAlt="A dentist and patient reviewing an implant-supported bridge plan" />
    <main>
      <TreatmentDetail kind="implant-supported-bridge" />
      <BeforeAfterStory id="before-after-implant-supported-bridge" tone="dark" reverse number="06" eyebrow="Illustrative planning visualization · adjacent missing-tooth concept" title="From an open span." emphasis="To a connected plan."
        intro="This simulated planning visualization explains how an adjacent missing-tooth span may move from site assessment to an implant-supported bridge concept. It is not an actual patient outcome, and candidacy, implant count or a specific result is not guaranteed."
        image="/images/generated/before-after-implant-supported-bridge-v1.webp" imageAlt="Illustrative simulated comparison of an adjacent missing-tooth span and an implant-supported bridge concept"
        beforeLabel="Before site assessment" beforeDetail="The missing span, surrounding structures, bite and available foundation still need to be evaluated."
        afterLabel="Illustrative bridge concept" afterDetail="The simulated view represents a connected restoration concept after foundation and sequence are confirmed—not an actual patient result."
        caseNote="Illustrative simulated example · not an actual patient case · treatment and results vary" />
      <HubFooter eyebrow="Want to understand the connected replacement path?" title="Begin with the span, the foundation and the bridge between." />
    </main>
  </body>
</html>
