---
import Navbar from '../../components/Navbar.astro';
import TreatmentDetail from '../../components/TreatmentDetail.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Explore professional dental cleaning at Smiles by Noetzel, including routine-visit assessment, cleaning, preventive guidance, pricing and both offices." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>Professional Dental Cleaning | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/nav-professional-dental-cleaning.webp" mediaAlt="A clinician discussing a professional routine dental cleaning with a patient" />
    <main>
      <TreatmentDetail kind="professional-dental-cleaning" />
      <BeforeAfterStory id="before-after-professional-dental-cleaning" tone="light" reverse number="06" eyebrow="Illustrative preventive pathway · routine cleaning" title="From everyday surface buildup." emphasis="To a cleaner preventive routine."
        intro="This illustrative pathway shows how a routine-cleaning visit may move from assessment through appropriate plaque and surface-buildup removal to practical home-care guidance. It is not an actual patient outcome and does not guarantee healthy gums, no cavities, pain-free care or a particular result."
        image="/images/generated/before-after-professional-dental-cleaning-v1.webp" imageAlt="Illustrative comparison of everyday plaque and surface buildup before a routine professional cleaning and a cleaner preventive pathway"
        beforeLabel="Before visit classification" beforeDetail="Gum findings, visible buildup and whether routine cleaning or periodontal evaluation is appropriate still need review."
        afterLabel="Illustrative routine-cleaning pathway" afterDetail="The simulated view represents an appropriate professional cleaning and preventive recap—not an actual or guaranteed result."
        caseNote="Illustrative simulated example · not an actual patient case · clinical findings and results vary" />
      <HubFooter eyebrow="Ready for the right preventive visit?" title="Begin with assessment, an appropriate cleaning and a practical recap." />
    </main>
  </body>
</html>
