---
import Navbar from '../../components/Navbar.astro';
import TreatmentDetail from '../../components/TreatmentDetail.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Explore virtual-reality anxiety reduction at Smiles by Noetzel, including headset suitability, responsive comfort support and pricing in Chicago Heights and Mokena." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>Virtual-Reality Anxiety Reduction | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/nav-virtual-reality-dental-anxiety-therapy.webp" mediaAlt="A patient discussing virtual-reality dental comfort support with the care team" />
    <main>
      <TreatmentDetail kind="virtual-reality-anxiety-reduction" />
      <BeforeAfterStory id="before-after-virtual-reality-anxiety-reduction" tone="light" reverse number="06" eyebrow="Illustrative care-journey visualization · alternate focus" title="From clinical sights and sounds." emphasis="To a connected focal point."
        intro="This simulated care-journey visualization explains how a comfort concern may move from trigger review to responsive virtual-reality support. It is not an actual patient outcome and does not represent guaranteed anxiety elimination."
        image="/images/generated/before-after-virtual-reality-dental-anxiety-therapy-v1.webp" imageAlt="Illustrative simulated comparison showing a dental anxiety trigger and connected virtual-reality comfort support"
        beforeLabel="Before the comfort review" beforeDetail="Clinical sights, sounds and past experience may shape how the planned visit feels."
        afterLabel="Illustrative alternate-focus view" afterDetail="The simulated view represents a different visual and audio focal point with communication still open—not a mental-health or clinical outcome."
        caseNote="Illustrative simulated example · not an actual patient case · responses vary" />
      <HubFooter eyebrow="Want to discuss a different focal point for dental care?" title="Begin with the trigger, the fit and the plan." />
    </main>
  </body>
</html>
