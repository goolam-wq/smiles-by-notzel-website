---
import Navbar from '../../components/Navbar.astro';
import TreatmentDetail from '../../components/TreatmentDetail.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Explore All-on-4 implant solution planning at Smiles by Noetzel, including candidacy, full-arch stages, pricing and both Illinois offices." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>All-on-4 Implant Solution | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/nav-all-on-4-implant-solution.webp" mediaAlt="A dentist and patient reviewing an All-on-4 full-arch plan" />
    <main>
      <TreatmentDetail kind="all-on-4-implant-solution" />
      <BeforeAfterStory id="before-after-all-on-4-implant-solution" tone="dark" reverse number="06" eyebrow="Illustrative planning visualization · full-arch concept" title="From a complex arch concern." emphasis="To a connected plan."
        intro="This simulated planning visualization explains how a full-arch concern may move from comprehensive assessment to an All-on-4 restoration concept. It is not an actual patient outcome, and candidacy, timing, inclusions or a specific result is not guaranteed."
        image="/images/generated/before-after-all-on-4-implant-solution-v1.webp" imageAlt="Illustrative simulated comparison of a full-arch concern and an All-on-4 restoration concept"
        beforeLabel="Before full-arch assessment" beforeDetail="Oral health, anatomy, remaining teeth, bite and restorative goals still need to be evaluated."
        afterLabel="Illustrative full-arch concept" afterDetail="The simulated view represents a connected restoration concept after foundation and sequence are confirmed—not an actual patient result."
        caseNote="Illustrative simulated example · not an actual patient case · treatment and results vary" />
      <HubFooter eyebrow="Want to understand a full-arch pathway?" title="Begin with the arch, the foundation and the sequence between." />
    </main>
  </body>
</html>
