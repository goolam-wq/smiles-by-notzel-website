---
import Navbar from '../components/Navbar.astro';
import ContactExperience from '../components/ContactExperience.astro';
import HubFooter from '../components/HubFooter.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Contact Smiles by Noetzel in Chicago Heights or Mokena to request a dental visit, ask a general question or reach the care team." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>Contact Smiles by Noetzel | Request a Visit</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/contact/contact-nav-welcome.webp" mediaAlt="A care coordinator greeting a patient at Smiles by Noetzel" />
    <main>
      <ContactExperience />
      <HubFooter eyebrow="Ready when you are" title="A clear next step begins with a real conversation." />
    </main>
  </body>
</html>
