---
import Navbar from '../../components/Navbar.astro';
import DetailExperience from '../../components/DetailExperience.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Find connected dental care near South Chicago Heights with extended hours and complete-health dentistry at Smiles by Noetzel." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>South Chicago Heights Dentist | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/south-chicago-heights/south-chicago-heights-nav-consultation.webp" mediaAlt="A South Chicago Heights patient reviewing a care plan with her dentist" />
    <main>
      <DetailExperience kind="south-chicago-heights" />
      <BeforeAfterStory id="before-after-south-chicago-heights" tone="dark" reverse number="05" eyebrow="South Chicago Heights · natural repair" title="One precise repair." emphasis="A familiar smile restored."
        intro="A small front-edge chip can become the first thing someone notices. This South Chicago Heights case restored proportion without replacing the character of the smile."
        image="/images/generated/unique/south-chicago-heights/south-chicago-heights-before-after.webp" imageAlt="Before and after South Chicago Heights dental bonding case showing a natural front-edge repair"
        beforeLabel="A disrupted front edge" beforeDetail="A small chip interrupted the tooth contour and caught the light unevenly."
        afterLabel="Restored to belong" afterDetail="Conservative bonding returns the edge, proportion and polish while preserving natural translucency."
        caseNote="Conservative front-tooth bonding" />
      <HubFooter eyebrow="South Chicago Heights is closer than it feels." title="Start with a real conversation. We’ll connect the care around your life." />
    </main>
  </body>
</html>
