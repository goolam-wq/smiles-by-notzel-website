---
import Navbar from '../../components/Navbar.astro';
import DetailExperience from '../../components/DetailExperience.astro';
import HubFooter from '../../components/HubFooter.astro';
import BeforeAfterStory from '../../components/BeforeAfterStory.astro';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#061d19" />
    <meta name="description" content="Find connected dental care near Steger with extended hours and complete-health dentistry at Smiles by Noetzel." />
    <link rel="icon" type="image/svg+xml" href="/brand/smiles-by-noetzel-mark.svg" />
    <title>Steger Dentist | Smiles by Noetzel</title>
  </head>
  <body>
    <Navbar mediaImage="/images/generated/unique/steger/steger-nav-consultation.webp" mediaAlt="A Steger patient reviewing a care plan with his dentist" />
    <main>
      <DetailExperience kind="steger" />
      <BeforeAfterStory id="before-after-steger" tone="dark" reverse number="05" eyebrow="Steger · natural repair" title="One careful edge." emphasis="A confident return."
        intro="A chipped front edge can pull attention away from the whole smile. This Steger case focused on proportion, polish and a result that still looked lived-in and real."
        image="/images/generated/unique/steger/steger-before-after.webp" imageAlt="Steger dental bonding outcome showing a conservative natural front-edge repair"
        beforeLabel="An uneven front edge" beforeDetail="A small fracture interrupted the tooth contour and made one edge more visible."
        afterLabel="Restored with restraint" afterDetail="Conservative bonding returns shape and polish while preserving natural shade variation."
        caseNote="Natural front-tooth bonding" />
      <HubFooter eyebrow="Steger is closer than it feels." title="Start with a conversation. We’ll connect the care around your life." />
    </main>
  </body>
</html>
